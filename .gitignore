# Q3Remaster: code plus the finished remastered asset library (godot/library, godot/webui, through
# Git LFS; see .gitattributes and PLAN.md "Licensing"). id's original files and the tools' working
# files stay out. Everything below is either id content, working files, build output, or something a
# tool refetches/rebuilds.

# --- id's original files and the asset tools' working files ---
/extracted/
/work/
/case_study_keel/fbx/
/case_study_keel/q3_original/
/case_study_keel/remaster/
/case_study_keel/notes/images/

# --- build output ---
/build/
.godot/
**/addons/q3core/bin/
/tools/q3core/bin/
/tools/q3core/build/
/tools/q3core/.sconsign.dblite
*.obj
*.dll.old*
~*.TMP

# --- refetched by tools/build_q3core.py (tools/q3core/thirdparty.json) ---
/tools/q3core/thirdparty/

# --- npm / Next.js / Wrangler ---
node_modules/
.next/
/webui/out/
.wrangler/
*.tsbuildinfo

# --- Python ---
__pycache__/
*.pyc

# --- secrets ---
.env*
.dev.vars*
*.pem
*.key

# --- test captures and scratch ---
/work/_fx_test/
/work/_pause_test/
*.zip
*.part
