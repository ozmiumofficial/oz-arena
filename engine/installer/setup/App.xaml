<Application x:Class="OzSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The menus' palette (engine/ui/rcss): ember black, warm whites, Oz red -->
  <Application.Resources>
    <FontFamily x:Key="Barlow">pack://application:,,,/Assets/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="BarlowBlack">pack://application:,,,/Assets/Fonts/#Barlow Black</FontFamily>
    <FontFamily x:Key="BarlowXBold">pack://application:,,,/Assets/Fonts/#Barlow ExtraBold</FontFamily>

    <Color x:Key="CInk">#0b0908</Color>
    <Color x:Key="CRed">#db2410</Color>
    <Color x:Key="CRedHot">#ff4a1c</Color>
    <Color x:Key="CRedDeep">#b3170a</Color>
    <Color x:Key="CAmber">#ffad33</Color>
    <SolidColorBrush x:Key="Ink" Color="#0b0908"/>
    <SolidColorBrush x:Key="Panel" Color="#d9120e0c"/>
    <SolidColorBrush x:Key="Field" Color="#cc070605"/>
    <SolidColorBrush x:Key="Line" Color="#2a221e"/>
    <SolidColorBrush x:Key="LineHot" Color="#5a4f49"/>
    <SolidColorBrush x:Key="Text" Color="#fff3e6"/>
    <SolidColorBrush x:Key="Text2" Color="#e6ddd2"/>
    <SolidColorBrush x:Key="Muted" Color="#8d847c"/>
    <SolidColorBrush x:Key="Dim" Color="#5d554f"/>
    <SolidColorBrush x:Key="Red" Color="#db2410"/>
    <SolidColorBrush x:Key="RedHot" Color="#ff4a1c"/>
    <SolidColorBrush x:Key="Amber" Color="#ffad33"/>
    <SolidColorBrush x:Key="Green" Color="#5ccf4a"/>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- the big red call to action, as the main menu's selected row -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="{StaticResource BarlowXBold}"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" SnapsToDevicePixels="True">
              <Border x:Name="glow" CornerRadius="2" Opacity="0.45" Margin="-2">
                <Border.Background>
                  <SolidColorBrush Color="{StaticResource CRed}"/>
                </Border.Background>
                <Border.Effect>
                  <BlurEffect Radius="18"/>
                </Border.Effect>
              </Border>
              <Border x:Name="face" CornerRadius="2" BorderThickness="1" BorderBrush="#ff5a33">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#e8331a" Offset="0"/>
                    <GradientStop Color="{StaticResource CRedDeep}" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <!-- the menus' slanted sheen -->
              <Border CornerRadius="2" ClipToBounds="True">
                <Rectangle x:Name="sheen" Width="60" HorizontalAlignment="Left" Opacity="0.0">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#00ffffff" Offset="0"/>
                      <GradientStop Color="#40ffffff" Offset="0.5"/>
                      <GradientStop Color="#00ffffff" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                  <Rectangle.RenderTransform>
                    <TransformGroup>
                      <SkewTransform AngleX="-20"/>
                      <TranslateTransform x:Name="sheenX" X="-80"/>
                    </TransformGroup>
                  </Rectangle.RenderTransform>
                </Rectangle>
              </Border>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="0.85"/>
                <Setter TargetName="face" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="{StaticResource CRedHot}" Offset="0"/>
                      <GradientStop Color="{StaticResource CRed}" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                      <DoubleAnimation Storyboard.TargetName="sheenX" Storyboard.TargetProperty="X" From="-80" To="520" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="root" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter TargetName="root" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.985" ScaleY="0.96"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                <Setter TargetName="glow" Property="Opacity" Value="0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- outlined, for everything that isn't the next step -->
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontFamily" Value="{StaticResource BarlowXBold}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#99070605" BorderBrush="{StaticResource LineHot}" BorderThickness="1" CornerRadius="2"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Red}"/>
                <Setter TargetName="b" Property="Background" Value="#33db2410"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#55db2410"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the title bar's minimize and close -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#33ffffff"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="Tag" Value="close">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Tag" Value="close"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
                <Setter Property="Foreground" Value="White"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a square red tick, as Settings' toggles -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontFamily" Value="{StaticResource Barlow}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" BorderThickness="1" BorderBrush="{StaticResource LineHot}"
                      Background="{StaticResource Field}" CornerRadius="2" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M 3.5,9 L 7.5,13 L 14.5,5" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="box" Property="Background" Value="{StaticResource Red}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource RedHot}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource RedHot}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a small tracked caps label above a block -->
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="{StaticResource BarlowXBold}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
  </Application.Resources>
</Application>
