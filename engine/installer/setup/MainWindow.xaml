<Window x:Class="OzSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oz="clr-namespace:OzSetup"
        Title="Oz Arena Setup" Width="1040" Height="640"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ink}" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/oz.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid ClipToBounds="True">
    <!-- the arena behind, sunk into the dark as the menus' backdrop -->
    <Image Source="pack://application:,,,/Assets/backdrop.jpg" Stretch="UniformToFill" HorizontalAlignment="Right" Opacity="0.9"
           RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform>
        <ScaleTransform x:Name="bgZoom" ScaleX="1.08" ScaleY="1.08"/>
      </Image.RenderTransform>
    </Image>
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#f50b0908" Offset="0"/>
          <GradientStop Color="#cc0b0908" Offset="0.34"/>
          <GradientStop Color="#660b0908" Offset="0.6"/>
          <GradientStop Color="#a00b0908" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#cc0b0908" Offset="0"/>
          <GradientStop Color="#000b0908" Offset="0.22"/>
          <GradientStop Color="#000b0908" Offset="0.6"/>
          <GradientStop Color="#f20b0908" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Ellipse Width="900" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-380,0,0,-300" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#40db2410" Offset="0"/>
          <GradientStop Color="#00db2410" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <oz:Embers/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="52"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="430"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- title bar -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Style="{StaticResource Chrome}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
          <Rectangle Width="10" Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button Style="{StaticResource Chrome}" Tag="close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
      </StackPanel>

      <!-- the logo, as the main menu's -->
      <StackPanel Grid.Row="0" Grid.RowSpan="2" Margin="56,34,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="300">
        <Image x:Name="logo" Source="pack://application:,,,/Assets/logo.png" Width="290" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality">
          <Image.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
          </Image.Effect>
        </Image>
        <Grid Margin="0,14,0,0" Width="290" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Rectangle Height="2" Fill="{StaticResource Red}" Margin="6,0,16,0"/>
          <oz:Tracked Grid.Column="1" Text="ARENA" Tracking="0.9" FontFamily="{StaticResource BarlowBlack}" FontSize="17" Foreground="{StaticResource Red}"/>
          <Rectangle Grid.Column="2" Height="2" Fill="{StaticResource Red}" Margin="16,0,6,0"/>
        </Grid>
      </StackPanel>

      <!-- the steps, as the main menu's rows -->
      <StackPanel Grid.Row="1" Margin="44,0,0,26" VerticalAlignment="Bottom" x:Name="steps">
        <Grid x:Name="step1" Margin="0,0,0,6"/>
        <Grid x:Name="step2" Margin="0,0,0,6"/>
        <Grid x:Name="step3"/>
      </StackPanel>

      <!-- the panel -->
      <Border x:Name="panel" Grid.Row="1" Grid.Column="1" Width="510" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,52,0"
              Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="34,30,34,32">
        <Border.Effect>
          <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
          <!-- the red trim along the panel's top, as the cards' -->
          <Rectangle Height="3" VerticalAlignment="Top" Margin="-34,-30,-34,0" HorizontalAlignment="Left" Width="120">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource CRedHot}" Offset="0"/>
                <GradientStop Color="#00db2410" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <!-- 1: the game, the folder, the release -->
          <StackPanel x:Name="pgHome">
            <oz:Tracked Text="YOUR GAME" FontFamily="{StaticResource BarlowXBold}" FontSize="11" Foreground="{StaticResource Muted}" Tracking="0.3"/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,5,12,0">
                <Ellipse x:Name="gameDotGlow" Fill="{StaticResource Green}" Opacity="0.5">
                  <Ellipse.Effect>
                    <BlurEffect Radius="8"/>
                  </Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="gameDot" Width="9" Height="9" Fill="{StaticResource Green}"/>
              </Grid>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="gameStatus" Text="Looking for Quake III Arena..." FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="gamePath" Text=" " FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="2" x:Name="btnLocate" Style="{StaticResource Secondary}" Height="34" Margin="14,0,0,0" VerticalAlignment="Top" Click="Locate_Click">
                <oz:Tracked Text="LOCATE" FontFamily="{StaticResource BarlowXBold}" FontSize="12" Tracking="0.18"/>
              </Button>
            </Grid>

            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,22,0,20"/>

            <oz:Tracked Text="INSTALL TO" FontFamily="{StaticResource BarlowXBold}" FontSize="11" Foreground="{StaticResource Muted}" Tracking="0.3"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Height="40" Padding="12,0">
                <TextBlock x:Name="dirText" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
              </Border>
              <Button Grid.Column="1" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="Change_Click">
                <oz:Tracked Text="CHANGE" FontFamily="{StaticResource BarlowXBold}" FontSize="12" Tracking="0.18"/>
              </Button>
            </Grid>
            <TextBlock x:Name="dirNote" Margin="0,8,0,0" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <CheckBox x:Name="chkDesktop" IsChecked="True" Content="Desktop shortcut"/>
              <CheckBox x:Name="chkLinks" IsChecked="True" Margin="28,0,0,0" Content="Open invite links in Oz Arena"/>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,22,0,18"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <oz:Tracked x:Name="relName" Text="CHECKING THE LATEST RELEASE" FontFamily="{StaticResource BarlowXBold}" FontSize="13" Foreground="{StaticResource Amber}" Tracking="0.14"/>
                <TextBlock x:Name="relInfo" Text=" " Margin="0,5,0,0" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="btnInstall" Style="{StaticResource Primary}" IsEnabled="False" Click="Install_Click" IsDefault="True">
                <StackPanel Orientation="Horizontal">
                  <oz:Tracked x:Name="installLabel" Text="INSTALL" FontFamily="{StaticResource BarlowBlack}" FontSize="20" Tracking="0.3" Foreground="White"/>
                  <Path Data="M0,0 L7,6 L0,12" Stroke="White" StrokeThickness="2.4" Margin="16,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" x:Name="btnPlayHome" Style="{StaticResource Secondary}" Height="56" Margin="10,0,0,0" Padding="26,0" Visibility="Collapsed" Click="Play_Click">
                <oz:Tracked Text="PLAY" FontFamily="{StaticResource BarlowBlack}" FontSize="16" Tracking="0.3"/>
              </Button>
            </Grid>
          </StackPanel>

          <!-- 2: working -->
          <StackPanel x:Name="pgWork" Visibility="Collapsed">
            <oz:Tracked x:Name="workCaption" Text="INSTALLING" FontFamily="{StaticResource BarlowXBold}" FontSize="11" Foreground="{StaticResource Muted}" Tracking="0.3"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock x:Name="pctText" Text="0" FontFamily="{StaticResource BarlowBlack}" FontSize="96" Foreground="{StaticResource Text}" Margin="-4,0,0,0">
                <TextBlock.Effect>
                  <DropShadowEffect Color="#db2410" BlurRadius="30" ShadowDepth="0" Opacity="0.55"/>
                </TextBlock.Effect>
              </TextBlock>
              <TextBlock Text="%" FontFamily="{StaticResource BarlowBlack}" FontSize="40" Foreground="{StaticResource Red}" Margin="6,0,0,22" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock x:Name="stepText" Text="Getting ready" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,-4,0,0"/>

            <Grid x:Name="track" Height="10" Margin="0,18,0,0" ClipToBounds="False">
              <Border Background="#1a1412" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="1"/>
              <Grid x:Name="fill" HorizontalAlignment="Left" Width="0">
                <Border CornerRadius="1" Margin="0,-3" Opacity="0.7">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="{StaticResource CRedDeep}" Offset="0"/>
                      <GradientStop Color="{StaticResource CRedHot}" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.Effect>
                    <BlurEffect Radius="12"/>
                  </Border.Effect>
                </Border>
                <Border CornerRadius="1" ClipToBounds="True">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="{StaticResource CRedDeep}" Offset="0"/>
                      <GradientStop Color="{StaticResource CRed}" Offset="0.6"/>
                      <GradientStop Color="{StaticResource CAmber}" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Rectangle x:Name="shimmer" Width="80" HorizontalAlignment="Left">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00ffffff" Offset="0"/>
                        <GradientStop Color="#55ffffff" Offset="0.5"/>
                        <GradientStop Color="#00ffffff" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                      <TranslateTransform x:Name="shimmerX" X="-80"/>
                    </Rectangle.RenderTransform>
                  </Rectangle>
                </Border>
                <!-- the spark at the bar's head -->
                <Ellipse Width="16" Height="16" HorizontalAlignment="Right" Margin="0,-3,-8,-3" Fill="#ffd27a" Opacity="0.8">
                  <Ellipse.Effect>
                    <BlurEffect Radius="9"/>
                  </Ellipse.Effect>
                </Ellipse>
              </Grid>
            </Grid>

            <Grid Margin="0,12,0,0">
              <TextBlock x:Name="bytesText" Text=" " FontSize="13" Foreground="{StaticResource Text2}"/>
              <TextBlock x:Name="speedText" Text=" " FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock x:Name="workNote" Margin="0,26,0,0" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="You can stop at any time. Setup keeps what it downloaded and carries on from there next time."/>
            <Button x:Name="btnCancel" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,22,0,0" Click="Cancel_Click">
              <oz:Tracked Text="STOP" FontFamily="{StaticResource BarlowXBold}" FontSize="12" Tracking="0.22"/>
            </Button>
          </StackPanel>

          <!-- 3: done, a stop, or the uninstall question: a caption, a headline, a sentence, two buttons -->
          <StackPanel x:Name="pgMessage" Visibility="Collapsed">
            <oz:Tracked x:Name="msgCaption" Text="INSTALLED" FontFamily="{StaticResource BarlowXBold}" FontSize="11" Foreground="{StaticResource Green}" Tracking="0.3"/>
            <!-- a long headline shrinks to the panel's width rather than being cut off -->
            <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,10,0,0">
              <oz:Tracked x:Name="msgTitle" Text="READY TO FIGHT" FontFamily="{StaticResource BarlowBlack}" FontSize="44" Foreground="{StaticResource Text}" Tracking="0.06">
                <oz:Tracked.Effect>
                  <DropShadowEffect Color="#db2410" BlurRadius="28" ShadowDepth="0" Opacity="0.5"/>
                </oz:Tracked.Effect>
              </oz:Tracked>
            </Viewbox>
            <TextBlock x:Name="msgBody" Margin="0,14,0,0" FontSize="14.5" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="22"/>
            <TextBlock x:Name="msgDetail" Margin="0,10,0,0" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Grid Margin="0,28,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="btnMsgMain" Style="{StaticResource Primary}" Click="MsgMain_Click">
                <StackPanel Orientation="Horizontal">
                  <oz:Tracked x:Name="msgMainLabel" Text="PLAY" FontFamily="{StaticResource BarlowBlack}" FontSize="20" Tracking="0.3" Foreground="White"/>
                  <Path Data="M0,0 L7,6 L0,12" Stroke="White" StrokeThickness="2.4" Margin="16,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" x:Name="btnMsgOther" Style="{StaticResource Secondary}" Height="56" Margin="10,0,0,0" Padding="24,0" Click="MsgOther_Click">
                <oz:Tracked x:Name="msgOtherLabel" Text="CLOSE" FontFamily="{StaticResource BarlowXBold}" FontSize="13" Tracking="0.22"/>
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- footer, as the main menu's news line and key hints -->
      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="56,0,0,0" VerticalAlignment="Center">
        <Border Background="{StaticResource Red}" CornerRadius="1" Padding="7,3,6,3" VerticalAlignment="Center">
          <oz:Tracked Text="SETUP" FontFamily="{StaticResource BarlowBlack}" FontSize="9.5" Tracking="0.3" Foreground="White"/>
        </Border>
        <TextBlock x:Name="footerText" Margin="12,0,0,0" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                   Text="Plays with your own Quake III Arena, and never changes its files."/>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,52,0" VerticalAlignment="Center">
        <Border BorderBrush="{StaticResource LineHot}" BorderThickness="1" CornerRadius="2" Padding="7,2" VerticalAlignment="Center">
          <TextBlock Text="Enter" FontSize="11" Foreground="{StaticResource Text2}"/>
        </Border>
        <oz:Tracked x:Name="enterHint" Text="INSTALL" Margin="8,0,22,0" FontFamily="{StaticResource BarlowXBold}" FontSize="10" Tracking="0.25" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <Border BorderBrush="{StaticResource LineHot}" BorderThickness="1" CornerRadius="2" Padding="7,2" VerticalAlignment="Center">
          <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource Text2}"/>
        </Border>
        <oz:Tracked Text="QUIT" Margin="8,0,0,0" FontFamily="{StaticResource BarlowXBold}" FontSize="10" Tracking="0.25" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
