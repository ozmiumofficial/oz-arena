 namespace Rml {
 
+extern bool element_update_skips_hidden_documents;	// Oz: Element.cpp
+
 static constexpr float DOUBLE_CLICK_TIME = 0.5f;    // [s]
 static constexpr float DOUBLE_CLICK_MAX_DIST = 3.f; // [dp]
 static constexpr float UNIT_SCROLL_LENGTH = 80.f;   // [dp]
@@ -202,12 +204,18 @@ bool Context::Update()
 	root->dirty_definition = false;
 	root->dirty_child_definitions = false;
 
+	// Oz: hidden documents wait (Element::Update)
+	element_update_skips_hidden_documents = true;
 	root->Update(density_independent_pixel_ratio, Vector2f(dimensions));
+	element_update_skips_hidden_documents = false;
 
 	for (int i = 0; i < root->GetNumChildren(); ++i)
 	{
 		if (auto doc = root->GetChild(i)->GetOwnerDocument())
 		{
+			// Oz: nor is a hidden document laid out; Show() updates and lays it out
+			if (doc->GetComputedValues().visibility() == Style::Visibility::Hidden)
+				continue;
 			doc->UpdateLayout();
 			doc->UpdatePosition();
 		}
