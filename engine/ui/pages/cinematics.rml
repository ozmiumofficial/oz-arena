<rml>
<head>
	<title>Cinematics</title>
	<link type="text/rcss" href="../rcss/menu.rcss"/>
	<link type="text/rcss" href="../rcss/media.rcss"/>
	<style>
		.grid { display: flex; flex-wrap: wrap; padding: 1.5rem 2rem 0.5rem 2rem; }
		.cell { width: 25%; box-sizing: border-box; padding: 0 0.5rem 1rem 0.5rem; }
		button.movie { height: 13.4rem; transition: border-color 0.2s cubic-out; }
		button.movie:focus, button.movie:hover { border-color: #ff4a1ccc; box-shadow: #db241073 0 0 1.4rem 0; }
		.movie .art.plate-art { background-color: #0b0807; decorator: radial-gradient( circle farthest-side at 50% 45%, #5a0a0599 0%, #00000000 100% ); }
		.movie .card-title {
			position: absolute;
			left: 0; right: 0; top: 38%;
			text-align: center;
			font-family: OzDisplay;
			font-size: 1.5rem;
			letter-spacing: 0.25em;
			color: #db2410b3;
			transition: opacity 0.2s linear-in-out;
		}
		.movie:focus .card-title, .movie:hover .card-title { opacity: 0; }
		.movie.locked .art { filter: grayscale(1) brightness(0.25); }
		.movie.locked .card-title { opacity: 0.25; }

		/* the play mark, on the focused movie */
		.movie .play {
			position: absolute;
			left: 50%; top: 50%;
			width: 3.5rem; height: 3.5rem;
			margin-left: -1.75rem; margin-top: -2.4rem;
			box-sizing: border-box;
			border: 2dp #fff3e6cc;
			border-radius: 1.75rem;
			background-color: #00000080;
			opacity: 0;
			transition: opacity 0.2s linear-in-out;
		}
		.movie:focus .play, .movie:hover .play { opacity: 1; }
		.movie .play .tri {
			position: absolute;
			left: 1.3rem; top: 1rem;
			width: 0; height: 0;
			border-left: 1rem #fff3e6;
			border-top: 0.6rem #00000000;
			border-bottom: 0.6rem #00000000;
		}

		/* locked: a padlock and what opens it */
		.movie .lock { position: absolute; left: 0; right: 0; top: 30%; text-align: center; }
		.lock .shackle { width: 0.9rem; height: 0.75rem; margin: 0 auto; border: 2dp #8d847c; border-bottom-width: 0; border-radius: 0.45rem 0.45rem 0 0; }
		.lock .body { width: 1.5rem; height: 1.15rem; margin: 0 auto; border: 2dp #8d847c; border-radius: 2dp; }
		.lock .why { margin-top: 0.5rem; font-family: OzDisplay; font-size: 0.65rem; letter-spacing: 0.15em; color: #8d847c; }

		.movie .cap {
			position: absolute;
			left: 0; right: 0; bottom: 0;
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			padding: 1.5rem 0.75rem 0.5rem 0.75rem;
			decorator: linear-gradient( 180deg, #00000000 0%, #000000e6 100% );
		}
		.movie .cap .t { font-family: OzDisplay; font-size: 1.05rem; letter-spacing: 0.05em; color: #fff3e6; }
		.movie .cap .d { font-family: OzDisplay; font-size: 0.65rem; letter-spacing: 0.15em; color: #8d847c; }
	</style>
</head>
<!--
Cinematics (CinematicsPage.tsx, after q3_ui's ui_cinematics.c): the id logo and the intro are always
there, each tier movie opens when the campaign tier before it is won, the ending after the final
duel. Play runs the original RoQ movie from the player's pak0 (the upscaled ones come with the Theora
player, P3) and comes back here when it ends. The thumbnails are the tiers' arenas, or a dark plate.
-->
<body data-model="menu">
	<div class="panel">
		<div class="corners"><div class="tl"/><div class="tr"/><div class="bl"/><div class="br"/></div>
		<div class="topline"/>
		<div class="phead">
			<div><banner text="Cinematics"/><p class="subtitle">The original game's movies, from your own copy of the game. Tier movies unlock as you win the campaign.</p></div>
			<div class="backbtn" onclick="back"><kbd>Esc</kbd><span>Back</span></div>
		</div>
		<div class="divider"/>
		<div class="pbody">
			<div class="inner" style="padding: 0;">
				<div class="grid">
					<div class="cell" data-for="c : cinematics.list">
						<button class="plate movie" autofocus="" data-attr-id="'cin_' + c.id" data-class-locked="!c.unlocked" data-attr-onclick="c.do">
							<div class="art" data-if="c.shot != ''" data-style-decorator="c.shot != '' ? 'image(' + c.shot + ' cover)' : 'none'"/>
							<div class="art plate-art" data-if="c.shot == ''"/>
							<div class="card-title" data-if="c.shot == ''">{{ c.title }}</div>
							<div class="play" data-if="c.unlocked"><div class="tri"/></div>
							<div class="lock" data-if="!c.unlocked"><div class="shackle"/><div class="body"/><div class="why">{{ c.lock }}</div></div>
							<div class="cap"><span class="t">{{ c.title }}</span><span class="d">{{ c.length }}</span></div>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
