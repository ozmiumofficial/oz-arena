<rml>
<head>
	<title>Crosshair</title>
	<link type="text/rcss" href="../rcss/menu.rcss"/>
	<style>
		/* over a match the panel sits left, clear of the screen's middle, where the match's own crosshair is the preview */
		.panel.left { left: 3rem; right: auto; width: 45.75rem; top: 6rem; bottom: 5.25rem; }
		.list { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 1rem 2.5rem 1.25rem 2.5rem; overflow-y: auto; }
		.list.beside { right: 21rem; padding-right: 1.5rem; }
		.weapons { display: flex; flex-wrap: wrap; margin-bottom: 0.25rem; }
		.wtab {
			position: relative;
			display: flex; align-items: center; justify-content: center;
			width: 2.4rem; height: 2.4rem; margin: 0 0.375rem 0.375rem 0;
			box-sizing: border-box; border: 1dp #ffffff1a; background-color: #00000066;
			transition: border-color background-color 0.15s linear-in-out;
		}
		.wtab.all { width: auto; padding: 0 0.6rem; font-size: 0.7rem; letter-spacing: 0.12em; color: #8d847c; }
		.wtab img { width: 1.75rem; height: 1.75rem; opacity: 0.7; }
		.wtab:focus, .wtab:hover { border-color: #ff4a1cb3; background-color: #db24101a; }
		.wtab.active { border-color: #ff4a1c; background-color: #db241033; color: #fff3e6; }
		.wtab.active img { opacity: 1; }
		/* a weapon with its own crosshair */
		.wtab .own { position: absolute; right: 0.15rem; top: 0.15rem; width: 0.35rem; height: 0.35rem; border-radius: 0.175rem; background-color: #ffad33; display: none; }
		.wtab.own .own { display: block; }
		.note { min-height: 1.4rem; margin-bottom: 0.5rem; font-size: 0.9rem; color: #8d847c; }
		.grid { display: flex; flex-wrap: wrap; }
		.tile {
			position: relative;
			display: flex; align-items: center; justify-content: center;
			width: 4.6rem; height: 4.6rem; margin: 0 0.4rem 0.4rem 0;
			box-sizing: border-box; border: 1dp #ffffff12; background-color: #0000004d;
			transition: border-color background-color 0.15s linear-in-out;
		}
		.tile:focus, .tile:hover { border-color: #ff4a1cb3; background-color: #db24101a; }
		.tile.active { border-color: #ff4a1c; background-color: #db241014; box-shadow: #ff4a1c40 0 0 1rem 0; }
		.tile .mark { position: absolute; right: 0.25rem; bottom: 0.25rem; width: 0.375rem; height: 0.375rem; border-radius: 0.1875rem; background-color: #ff4a1c; display: none; }
		.tile.active .mark { display: block; }
		.tile .none { font-size: 0.65rem; letter-spacing: 0.12em; color: #8d847c; }
		.tile crosshair { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
		.field { display: flex; align-items: center; min-height: 3rem; padding: 0.25rem 0.75rem; }
		.field.dim { opacity: 0.45; }
		.field .l { flex: 1; font-size: 1.02rem; font-weight: 500; color: #e6ddd2; }
		.field .value { width: 4.5rem; text-align: right; font-size: 0.85rem; letter-spacing: 0.05em; color: #e6ddd2; }
		.field input.slider { width: 13rem; }
		.field .btn { margin-left: 0.75rem; }
		.swatch {
			display: inline-block; width: 1.6rem; height: 1.6rem; margin-right: 0.5rem;
			border: 1dp #5a4f49; border-radius: 2dp;
		}
		.swatch:focus, .swatch:hover { border-color: #ff4a1c; box-shadow: #ff4a1c80 0 0 0.6rem 0; }
		.field input.text { width: 8rem; height: 2.1rem; padding: 0.35rem 0.6rem; }
		/* the swatches sit left of the toggles and sliders, so the nearest control up or down passes them by */
		#xh_dot { nav-down: #xh_color; }
		#xh_opacity { nav-up: #xh_color; }
		#xh_color { nav-up: #xh_dot; nav-down: #xh_opacity; }
		#xh_hit_flash { nav-down: #xh_hit_color; }
		#xh_hit_time { nav-up: #xh_hit_color; }
		#xh_hit_color { nav-right: #xh_test_hit; }	/* past its hex field, which the keys don't reach */
		#xh_test_hit { nav-left: #xh_hit_color; }
		.pfoot .note { margin: 0 0 0 auto; min-height: 0; font-size: 0.85rem; color: #5d554f; }
		/* from the menus: the preview over a level shot, at its size in a match */
		.aside { position: absolute; right: 2.5rem; top: 1rem; width: 17.5rem; }
		.shot { position: relative; height: 17.5rem; overflow: hidden; clip: always; border: 1dp #ffffff1a; }
		/* the level shot close up (the web menu's 2.2 times), on the space beside the arena, a little darker */
		.shot .bg { position: absolute; left: -27%; top: -16%; width: 220%; height: 220%; decorator: image( /levelshots/q3dm17 cover ); }
		.veil { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #00000040; }
		.shot crosshair { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
		.shot .cap { position: absolute; left: 0.75rem; top: 0.5rem; font-size: 0.6rem; letter-spacing: 0.25em; color: #ffffff80; }
		.shot .cap span.w { margin-left: 0.6rem; font-family: Barlow; font-size: 0.8rem; letter-spacing: 0.05em; color: #ffad33; }
		.aside .note { margin-top: 0.75rem; font-size: 0.85rem; }
		/* over a match: a frame around the screen's middle */
		.live { position: absolute; left: 50%; top: 50%; width: 11rem; height: 11rem; margin-left: -5.5rem; margin-top: -5.5rem; pointer-events: none; }
		.live div { position: absolute; width: 1.5rem; height: 1.5rem; border-color: #ffffff73; }
		.live .tl { left: 0; top: 0; border-left-width: 2dp; border-top-width: 2dp; }
		.live .tr { right: 0; top: 0; border-right-width: 2dp; border-top-width: 2dp; }
		.live .bl { left: 0; bottom: 0; border-left-width: 2dp; border-bottom-width: 2dp; }
		.live .br { right: 0; bottom: 0; border-right-width: 2dp; border-bottom-width: 2dp; }
		.live .cap { position: absolute; left: -5rem; right: -5rem; bottom: -2rem; text-align: center; font-size: 0.65rem; letter-spacing: 0.3em; color: #ffffff99; }
		.live .cap span.w { margin-left: 0.6rem; font-family: Barlow; font-size: 0.85rem; letter-spacing: 0.05em; color: #ffad33; }
	</style>
</head>
<!--
The crosshair editor (the web menu's CrosshairEditor.tsx; oz_ui_crosshair.cpp), from the pause menu and
from Settings' Crosshair tab. Over a match the panel sits left and the match's own crosshair, inside the
frame in the screen's middle, is the preview; from the menus it previews over a level shot, drawn by the
HUD (<crosshair>) at its size in a match. The controls write the crosshair settings as they change (the
same as Settings' Crosshair tab); a weapon tab edits that weapon's own crosshair.
-->
<body data-model="menu">
	<div class="panel" data-class-left="crosshair.live">
		<div class="corners"><div class="tl"/><div class="tr"/><div class="bl"/><div class="br"/></div>
		<div class="topline"/>
		<div class="phead">
			<div><banner text="Crosshair"/></div>
			<div class="backbtn" onclick="back"><kbd>Esc</kbd><span>Back</span></div>
		</div>
		<div class="divider"/>
		<div class="pbody">
			<div class="list" data-class-beside="!crosshair.live">
				<div class="weapons">
					<button id="xh_all" class="wtab all q3" data-class-active="crosshair.weapon == 'all'" onclick="xhweapon all"><span>All</span></button>
					<button class="wtab" data-for="w : crosshair.weapons" data-attr-id="'xh_w_' + w.id" data-class-active="crosshair.weapon == w.id" data-class-own="w.own"
						data-attr-onclick="'xhweapon ' + w.id"><img data-attr-src="w.icon"/><span class="own"/></button>
				</div>
				<p class="note" data-if="crosshair.weapon == 'all'">The crosshair for every weapon without its own.</p>
				<p class="note" data-if="crosshair.weapon != 'all'">{{ crosshair.weapon_name }}: pick a shape to give it its own{{ crosshair.per_weapon ? '.' : ' (turns per-weapon crosshairs on).' }}</p>

				<div class="section first"><span class="t">Shape</span><span class="rule"/></div>
				<div class="grid">
					<button class="tile" id="xh_shape_default" data-if="crosshair.weapon != 'all'" data-class-active="crosshair.pick == 'default'" onclick="xhshape default">
						<span class="q3 none">All</span><span class="mark"/>
					</button>
					<button class="tile" data-for="s : crosshair.shapes" data-attr-id="'xh_shape_' + s.id" data-class-active="crosshair.pick == s.id"
						data-attr-onclick="'xhshape ' + s.id">
						<span class="q3 none" data-if="s.id == 'none'">None</span>
						<crosshair data-if="s.id != 'none'" data-attr-shape="s.id" fit="34"/>
						<span class="mark"/>
					</button>
				</div>
				<div class="field"><span class="l">Size</span><input id="xh_size" class="slider" type="range" min="8" max="96" step="1" data-value="crosshair.size" setting="crosshair/size"/><span class="q3 value">{{ crosshair.size }} px</span></div>
				<div class="field" data-class-dim="!crosshair.vector &amp;&amp; !crosshair.dot"><span class="l">Thickness</span><input id="xh_thickness" class="slider" type="range" min="1" max="8" step="1" data-value="crosshair.thickness" setting="crosshair/thickness"/><span class="q3 value">{{ crosshair.thickness }} px</span></div>
				<div class="field" data-class-dim="!crosshair.lines"><span class="l">Gap</span><input id="xh_gap" class="slider" type="range" min="0" max="32" step="1" data-value="crosshair.gap" setting="crosshair/gap"/><span class="q3 value">{{ crosshair.gap }} px</span></div>
				<div class="field"><span class="l">Center dot</span>
					<div id="xh_dot" class="toggle" data-class-on="crosshair.dot" onclick="toggle crosshair.dot crosshair/dot"><span class="track"><span class="knob"/></span><span class="state">{{ crosshair.dot ? 'On' : 'Off' }}</span></div></div>

				<div class="section"><span class="t">Color</span><span class="rule"/></div>
				<div class="field" data-class-dim="crosshair.health_color"><span class="l">Color</span>
					<button id="xh_color" class="swatch" data-style-background-color="crosshair.color" onclick="pickcolor crosshair/color"/>
					<input id="xh_color_text" class="text mouseonly" type="text" maxlength="7" data-value="crosshair.color" setting="crosshair/color"/></div>
				<div class="field"><span class="l">Opacity</span><input id="xh_opacity" class="slider" type="range" min="10" max="100" step="5" data-value="crosshair.opacity" setting="crosshair/opacity"/><span class="q3 value">{{ crosshair.opacity }}%</span></div>
				<div class="field"><span class="l">Color by health</span>
					<div id="xh_health" class="toggle" data-class-on="crosshair.health_color" onclick="toggle crosshair.health_color crosshair/health_color"><span class="track"><span class="knob"/></span><span class="state">{{ crosshair.health_color ? 'On' : 'Off' }}</span></div></div>

				<div class="section"><span class="t">Outline</span><span class="rule"/></div>
				<div class="field"><span class="l">Outline</span>
					<div id="xh_outline" class="toggle" data-class-on="crosshair.outline" onclick="toggle crosshair.outline crosshair/outline"><span class="track"><span class="knob"/></span><span class="state">{{ crosshair.outline ? 'On' : 'Off' }}</span></div></div>
				<div class="field" data-class-dim="!crosshair.outline"><span class="l">Outline width</span><input id="xh_outline_width" class="slider" type="range" min="1" max="4" step="1" data-value="crosshair.outline_width" setting="crosshair/outline_width"/><span class="q3 value">{{ crosshair.outline_width }} px</span></div>
				<div class="field" data-class-dim="!crosshair.outline"><span class="l">Outline opacity</span><input id="xh_outline_opacity" class="slider" type="range" min="10" max="100" step="5" data-value="crosshair.outline_opacity" setting="crosshair/outline_opacity"/><span class="q3 value">{{ crosshair.outline_opacity }}%</span></div>

				<div class="section"><span class="t">Hit flash</span><span class="rule"/></div>
				<div class="field"><span class="l">Hit flash</span>
					<div id="xh_hit_flash" class="toggle" data-class-on="crosshair.hit_flash" onclick="toggle crosshair.hit_flash crosshair/hit_flash"><span class="track"><span class="knob"/></span><span class="state">{{ crosshair.hit_flash ? 'On' : 'Off' }}</span></div></div>
				<div class="field" data-class-dim="!crosshair.hit_flash"><span class="l">Hit color</span>
					<button id="xh_hit_color" class="swatch" data-style-background-color="crosshair.hit_color" onclick="pickcolor crosshair/hit_color"/>
					<input id="xh_hit_color_text" class="text mouseonly" type="text" maxlength="7" data-value="crosshair.hit_color" setting="crosshair/hit_color"/>
					<button id="xh_test_hit" class="btn small" onclick="xhhit">Test hit</button></div>
				<div class="field" data-class-dim="!crosshair.hit_flash"><span class="l">Flash length</span><input id="xh_hit_time" class="slider" type="range" min="50" max="1000" step="10" data-value="crosshair.hit_time" setting="crosshair/hit_time"/><span class="q3 value">{{ crosshair.hit_time }} ms</span></div>

				<div class="section"><span class="t">Per weapon</span><span class="rule"/></div>
				<div class="field"><span class="l">Per-weapon crosshairs</span>
					<div id="xh_per_weapon" class="toggle" data-class-on="crosshair.per_weapon" onclick="toggle crosshair.per_weapon crosshair/per_weapon"><span class="track"><span class="knob"/></span><span class="state">{{ crosshair.per_weapon ? 'On' : 'Off' }}</span></div></div>
			</div>
			<div class="aside" data-if="!crosshair.live">
				<div class="shot"><div class="bg"/><div class="veil"/><crosshair data-attr-weapon="crosshair.weapon"/>
					<span class="cap q3">Preview<span class="w" data-if="crosshair.weapon_name != ''">{{ crosshair.weapon_name }}</span></span></div>
				<p class="note">At its size in a match. In a match, the pause menu's Crosshair edits it live over your game.</p>
			</div>
		</div>
		<div class="pfoot">
			<button id="xh_copy" class="btn small" onclick="copycode crosshair/">Copy crosshair code</button>
			<button id="xh_paste" class="btn small" onclick="pastecode">Paste code</button>
			<button id="xh_reset" class="btn small" onclick="xhreset">Reset</button>
			<span class="note">Saved as you go.</span>
		</div>
	</div>
	<div class="live" data-if="crosshair.live"><div class="tl"/><div class="tr"/><div class="bl"/><div class="br"/>
		<span class="cap q3">Live<span class="w" data-if="crosshair.weapon_name != ''">{{ crosshair.weapon_name }}</span></span></div>
</body>
</rml>
