<rml>
<head>
	<title>Dedicated Server</title>
	<link type="text/rcss" href="../rcss/menu.rcss"/>
	<link type="text/rcss" href="../rcss/play.rcss"/>
	<style>
		.cols {
			position: absolute;
			left: 0; right: 0; top: 0; bottom: 0;
			display: flex;
			padding: 1.25rem 2.5rem;
		}
		.form {
			flex: 1 1 auto;
			width: 10rem;
			margin-right: 2rem;
			padding-right: 0.5rem;
			overflow-y: auto;
		}
		.side { flex: 0 0 auto; width: 24rem; }
		.field { margin-bottom: 0.75rem; }
		.field .l {
			margin-bottom: 0.25rem;
			font-weight: 500;
			font-size: 0.9rem;
			line-height: 1.5;
			color: #e6ddd2cc;
		}
		.sl {
			display: flex;
			align-items: center;
			width: 22rem;
			padding: 0.375rem 0.25rem;
			border-radius: 2dp;
		}
		.sl input.slider { flex: 1 1 auto; width: 10rem; }
		.sl .val {
			width: 5rem;
			margin-left: 1rem;
			text-align: right;
			font-size: 0.875rem;
			letter-spacing: 0.05em;
			color: #e6ddd2;
		}
		.togs { display: flex; align-items: center; margin-top: 0.5rem; }
		.status { padding: 1rem; }
		.status .row { display: flex; align-items: center; }
		.status .dot { width: 0.75rem; height: 0.75rem; margin-right: 0.75rem; border-radius: 0.375rem; background-color: #ffffff40; }
		.status .dot.on { background-color: #22c55e; }
		.status .st { font-size: 1rem; letter-spacing: 0.1em; color: #fff3e6; }
		.buttons { display: flex; margin-top: 0.75rem; }
		.buttons button { margin-right: 0.75rem; }
		.side .section.first { margin-top: 0; }
		.console { display: flex; align-items: center; margin-top: 1.5rem; }
		.console input.text { flex: 1 1 auto; width: 10rem; margin-right: 0.5rem; }
		.side .lbl { margin-top: 0.75rem; font-size: 0.9rem; }
		.side .note { margin-top: 0.5rem; font-size: 0.8rem; }
		.form .section.first { margin-bottom: 1.25rem; }
		.side .section { margin-top: 2.25rem; }
		/* the form's top goes up to Start; the toggles take Left and Right, so Down and Up step through their row */
		#ded_name { nav-up: #ded_start; }
		#ded_sleep { nav-down: #ded_online; }
		#ded_online { nav-up: #ded_sleep; }
	</style>
</head>
<!--
Dedicated Server (DedicatedPage.tsx): an always-on server run from this PC, in its own window. Its
settings work on stand-in values (dedicated.json, the web menu's defaults); starting, stopping and
the server's console come with P9 and are refused. Each mode keeps its own map choice.
-->
<body data-model="menu">
	<div class="panel">
		<div class="corners"><div class="tl"/><div class="tr"/><div class="bl"/><div class="br"/></div>
		<div class="topline"/>
		<div class="phead">
			<div><banner text="Dedicated Server"/><p class="subtitle">An always-on server run from this PC, in its own window on your taskbar. It keeps running after you close the game; close its window to stop it.</p></div>
			<div class="backbtn" onclick="back"><kbd>Esc</kbd><span>Back</span></div>
		</div>
		<div class="divider"/>
		<div class="pbody">
			<div class="cols">
				<div class="form">
					<div class="section first"><span class="t">Server</span><span class="rule"/></div>
					<div class="field"><div class="l">Name</div><input id="ded_name" class="text wide" type="text" maxlength="40" data-value="dedicated.name"/></div>
					<div class="field"><div class="l">Password</div><input id="ded_password" class="text wide" type="text" maxlength="40" placeholder="None" data-value="dedicated.password"/></div>
					<div class="field"><div class="l">Mode</div>
						<div id="ded_mode" class="spinner wide" spin="dedicated.mode" data-attr-options="dedicated.mode_options"><span class="arrow prev">&lt;</span><span class="v">{{ dedicated.mode }}</span><span class="arrow next">&gt;</span></div>
					</div>
					<div class="field" data-for="m : dedicated.modes" data-if="m.name == dedicated.mode"><div class="l">Maps</div>
						<div class="spinner wide" data-attr-spin="m.path" data-attr-options="m.maps"><span class="arrow prev">&lt;</span><span class="v">{{ m.rotation }}</span><span class="arrow next">&gt;</span></div>
					</div>
					<div class="field"><div class="l">Max players: {{ dedicated.max_players }}</div>
						<div class="sl"><input id="ded_max" class="slider" type="range" min="2" max="32" step="1" data-value="dedicated.max_players"/><span class="q3 val">{{ dedicated.max_players }}</span></div>
					</div>
					<div class="field"><div class="l">Fill with bots up to: {{ dedicated.bots > 0 ? dedicated.bots : 'off' }}</div>
						<div class="sl"><input id="ded_bots" class="slider" type="range" min="0" max="16" step="1" data-value="dedicated.bots"/><span class="q3 val">{{ dedicated.bots }}</span></div>
					</div>
					<div class="field" data-if="dedicated.bots > 0"><div class="l">Bot skill</div>
						<div id="ded_skill" class="spinner wide" spin="dedicated.bot_skill" data-attr-options="dedicated.skills"><span class="arrow prev">&lt;</span><span class="v">{{ dedicated.bot_skill }}</span><span class="arrow next">&gt;</span></div>
					</div>
					<div class="field"><div class="l">Message of the day</div><input id="ded_motd" class="text wide" type="text" maxlength="60" data-value="dedicated.motd"/></div>
					<div class="field"><div class="l">Remote console password</div><input id="ded_rcon" class="text wide" type="text" maxlength="40" placeholder="None" data-value="dedicated.rcon"/></div>
					<div class="togs">
						<div class="lbl"><span class="t">Sleep when empty</span>
							<div id="ded_sleep" class="toggle" data-class-on="dedicated.idle_sleep" data-event-click="dedicated.idle_sleep = !dedicated.idle_sleep"
								data-event-keydown="dedicated.idle_sleep = (ev.key_identifier == 90 || ev.key_identifier == 92) ? !dedicated.idle_sleep : dedicated.idle_sleep"><span class="track"><span class="knob"/></span><span class="state">{{ dedicated.idle_sleep ? 'On' : 'Off' }}</span></div>
						</div>
						<div class="lbl"><span class="t">List online</span>
							<div id="ded_online" class="toggle" data-class-on="dedicated.online" data-event-click="dedicated.online = !dedicated.online"
								data-event-keydown="dedicated.online = (ev.key_identifier == 90 || ev.key_identifier == 92) ? !dedicated.online : dedicated.online"><span class="track"><span class="knob"/></span><span class="state">{{ dedicated.online ? 'On' : 'Off' }}</span></div>
						</div>
					</div>
				</div>

				<div class="side">
					<div class="section first"><span class="t">Status</span><span class="rule"/></div>
					<div class="box status">
						<div class="row"><span class="dot" data-class-on="dedicated.running"/><span class="q3 st">{{ dedicated.status }}</span></div>
					</div>
					<div class="buttons">
						<button id="ded_start" class="btn primary" autofocus="" onclick="soon dedicated">Start</button>
						<button id="ded_stop" class="btn refused" onclick="soon dedicated">Stop</button>
					</div>
					<div class="section"><span class="t">Console</span><span class="rule"/></div>
					<div class="console">
						<input id="ded_console" class="text" type="text" maxlength="120" placeholder="map q3dm6, say hello, kick name ..." data-value="dedicated.console"/>
						<button id="ded_run" class="btn small refused" onclick="soon dedicated">Run</button>
					</div>
					<div class="lbl"><span class="t">Start with Windows</span>
						<div id="ded_autostart" class="toggle" data-class-on="dedicated.autostart" onclick="soon dedicated"><span class="track"><span class="knob"/></span><span class="state">{{ dedicated.autostart ? 'On' : 'Off' }}</span></div>
					</div>
					<p class="note">Settings apply when you press Start. Start with Windows adds an entry to this PC's sign-in list that runs the server; turn it off to remove it.</p>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
