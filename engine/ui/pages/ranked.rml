iv><div class="p" style="left: 0.3285em; top: 0.7648em; width: 0.3431em; height: 0.0289em; decorator: linear-gradient( 151.8deg, #7a1d10 0%, #59150c 100% );"></div><div class="p" style="left: 0.3484em; top: 0.7922em; width: 0.3033em; height: 0.025em; decorator: linear-gradient( 151.8deg, #741c0f 0%, #57150c 100% );"></div><div class="p" style="left: 0.3677em; top: 0.8156em; width: 0.2646em; height: 0.0211em; decorator: linear-gradient( 151.8deg, #6f1b0f 0%, #56140b 100% );"></div><div class="p" style="left: 0.3878em; top: 0.8352em; width: 0.2245em; height: 0.0211em; decorator: linear-gradient( 151.8deg, #6a190e 0%, #54140b 100% );"></div><div class="p" style="left: 0.4081em; top: 0.8547em; width: 0.1839em; height: 0.0172em; decorator: linear-gradient( 151.8deg, #65180e 0%, #54140b 100% );"></div><div class="p" style="left: 0.4286em; top: 0.8703em; width: 0.1429em; height: 0.0172em; decorator: linear-gradient( 151.8deg, #61170d 0%, #53140b 100% );"></div><div class="p" style="left: 0.4519em; top: 0.8859em; width: 0.0963em; height: 0.0172em; decorator: linear-gradient( 151.8deg, #5d160c 0%, #52140b 100% );"></div><div class="p" style="left: 0.475em; top: 0.9016em; width: 0.05em; height: 0.0133em; decorator: linear-gradient( 151.8deg, #59150c 0%, #52140b 100% );"></div><div class="p" style="left: 0.4937em; top: 0.9133em; width: 0.0126em; height: 0.0094em; decorator: linear-gradient( 151.8deg, #55140b 0%, #53140b 100% );"></div><i class="t" style="left: 0.3483em; top: 0.6199em; border-top-color: #ffcf6a; transform: matrix(-0.0872, -0.0887, 0.0000, -0.1774, 0, 0);"/><i class="t" style="left: 0.3461em; top: 0.62em; border-top-color: #ffcf6a; transform: matrix(-0.0014, -0.1768, 0.1029, -0.2160, 0, 0);"/><i class="t" style="left: 0.3448em; top: 0.6194em; border-top-color: #ffcf6a; transform: matrix(0.1016, -0.2162, 0.2119, -0.2145, 0, 0);"/><i class="t" style="left: 0.3439em; top: 0.6185em; border-top-color: #ffcf6a; transform: matrix(0.2111, -0.2151, 0.3127, -0.1735, 0, 0);"/><i class="t" style="left: 0.3434em; top: 0.6176em; border-top-color: #ffcf6a; transform: matrix(0.3121, -0.1742, 0.3955, -0.0863, 0, 0);"/><i class="t" style="left: 0.3432em; top: 0.6167em; border-top-color: #ffcf6a; transform: matrix(0.3955, -0.0868, 0.3134, 0.0009, 0, 0);"/><i class="t" style="left: 0.3432em; top: 0.6159em; border-top-color: #ffcf6a; transform: matrix(0.3136, -0.0001, 0.2134, 0.0419, 0, 0);"/><i class="t" style="left: 0.5574em; top: 0.656em; border-top-color: #ffcf6a; transform: matrix(-0.1116, 0.0034, -0.2141, -0.0407, 0, 0);"/><i class="t" style="left: 0.3616em; top: 0.6em; border-top-color: #1a0503; transform: matrix(-0.0680, -0.0687, 0.0000, -0.1375, 0, 0);"/><i class="t" style="left: 0.3593em; top: 0.6em; border-top-color: #1a0503; transform: matrix(-0.0016, -0.1366, 0.0943, -0.1725, 0, 0);"/><i class="t" style="left: 0.3579em; top: 0.5993em; border-top-color: #1a0503; transform: matrix(0.0929, -0.1727, 0.1945, -0.1708, 0, 0);"/><i class="t" style="left: 0.3571em; top: 0.5984em; border-top-color: #1a0503; transform: matrix(0.1936, -0.1714, 0.2863, -0.1331, 0, 0);"/><i class="t" style="left: 0.3567em; top: 0.5975em; border-top-color: #1a0503; transform: matrix(0.2858, -0.1338, 0.3497, -0.0662, 0, 0);"/><i class="t" style="left: 0.3565em; top: 0.5967em; border-top-color: #1a0503; transform: matrix(0.3496, -0.0666, 0.2868, 0.0007, 0, 0);"/><i class="t" style="left: 0.3565em; top: 0.596em; border-top-color: #1a0503; transform: matrix(0.2870, -0.0001, 0.1957, 0.0383, 0, 0);"/><i class="t" style="left: 0.5529em; top: 0.6325em; border-top-color: #1a0503; transform: matrix(-0.1027, 0.0033, -0.1963, -0.0372, 0, 0);"/><div class="p" style="left: 0.4062em; top: 0.4375em; width: 0.1875em; height: 0.1875em; border-radius: 0.0938em; background-color: #ffcf6a;"></div><div class="p" style="left: 0.4594em; top: 0.4906em; width: 0.0813em; height: 0.0813em; border-radius: 0.0406em; background-color: #1a0503;"></div><i class="t" style="left: 0.3594em; top: 0.7651em; border-top-color: #ffcf6a; transform: matrix(0.0249, -0.0338, 0.1440, 0.0561, 0, 0);"/><i class="t" style="left: 0.4966em; top: 0.8212em; border-top-color: #ffcf6a; transform: matrix(0.1191, -0.0899, 0.1440, -0.0561, 0, 0);"/><i class="t" style="left: 0.4961em; top: 0.8195em; border-top-color: #ffcf6a; transform: matrix(0.1440, -0.0558, 0.0013, 0.0516, 0, 0);"/><i class="t" style="left: 0.5039em; top: 0.8195em; border-top-color: #ffcf6a; transform: matrix(-0.0013, 0.0516, -0.1440, -0.0558, 0, 0);"/></div>
							<div class="q3 n" style="color: #ff3d22;">{{ ranked.tiers[5].name }}</div>
							<div class="mono r">{{ ranked.tiers[5].range }}</div>
							<div class="q3 you" data-if="ranked.tier == 'godlike'">You</div>
						</div>
						<!-- end: tier cards -->
					</div>
					<p class="tnote">Reaching Silver or higher earns that tier's card frame and title for good, and Gold to Godlike are achievements too. Your card shows your tier and MMR to everyone.</p>
					<div class="section"><span class="t">How ranked works</span><span class="rule"/></div>
					<div class="how">
						<div class="cell" data-for="h : ranked.how">
							<div class="item">
								<div class="q3 k" data-class-sym="h.k == '±'">{{ h.k }}</div>
								<div class="txt"><div class="q3 n">{{ h.name }}</div><div class="t">{{ h.text }}</div></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
