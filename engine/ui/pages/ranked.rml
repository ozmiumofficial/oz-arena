<rml>
<head>
	<title>Ranked</title>
	<link type="text/rcss" href="../rcss/menu.rcss"/>
	<link type="text/rcss" href="../rcss/play.rcss"/>
	<style>
		.cols {
			position: absolute;
			left: 0; right: 0; top: 0; bottom: 0;
			display: flex;
			padding: 1.25rem 2.5rem;
		}
		.lcol { flex: 0 0 auto; width: 22rem; margin-right: 2.5rem; display: flex; flex-direction: column; }
		.rcol { flex: 1 1 auto; width: 10rem; padding-right: 0.5rem; overflow-y: auto; }
		/* under 1020 dp tall the left column scrolls too (menu.rcss) */
		@media (max-height: 1019dp) { .lcol { overflow-y: auto; padding-right: 0.5rem; } }

		/* the player's rank */
		.card { display: flex; flex-direction: column; align-items: center; padding: 1.25rem 1.5rem; text-align: center; }
		.badge9 { position: relative; width: 9rem; height: 9rem; }
		.ring {
			position: absolute;
			left: 0.25rem; top: 0.25rem; right: 0.25rem; bottom: 0.25rem;
			decorator: repeating-conic-gradient( #db24104d 0deg, #db24104d 7deg, #db241000 7deg, #db241000 12deg );
			mask-image: radial-gradient( circle closest-side, #00000000 96.5%, #000000 97%, #000000 100%, #00000000 100% );
		}
		/* endless animations only on a shown page: a hidden one's would keep RmlUi updating it */
		body.shown .ring { animation: 40s linear-in-out infinite ring-spin; }
		@keyframes ring-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
		.badge9 .rk { position: absolute; left: 1.7rem; top: 1rem; font-size: 5.6rem; }
		.card .big { margin-top: 0.5rem; font-size: 1.4rem; line-height: 1.4; letter-spacing: 0.1em; color: #e6ddd2; }
		.card .why { margin-top: 0.25rem; font-size: 0.95rem; line-height: 1.5; color: #8d847c; }
		.bar { width: 100%; height: 0.5rem; margin-top: 1rem; border-radius: 0.25rem; background-color: #ffffff1a; }
		.bar .fill { height: 0.5rem; border-radius: 0.25rem; decorator: linear-gradient( 90deg, #db2410 0%, #ff4a1c 100% ); }
		.card .lvl { margin-top: 0.5rem; font-size: 0.75rem; line-height: 1.5; letter-spacing: 0.2em; color: #8d847c; }
		button.btn.wide { display: block; width: 100%; box-sizing: border-box; margin-top: 0.75rem; }
		.lcol .section { margin-top: 1.25rem; }

		/* the queues */
		.queue { display: flex; align-items: center; margin-bottom: 0.5rem; padding: 0.625rem 1rem; border: 1dp #ffffff12; border-radius: 2dp; background-color: #00000040; }
		.queue .who { flex: 1 1 auto; width: 4rem; margin-right: 1rem; }
		.queue .n { font-size: 0.95rem; line-height: 1.5; letter-spacing: 0.06em; color: #fff3e6; }
		.queue .t { font-size: 0.8rem; line-height: 1.5; color: #8d847c; }

		/* the tiers */
		.tiers { display: flex; margin: 0 -0.25rem; }
		.tier { flex: 1 1 0; width: 1rem; margin: 0 0.25rem; padding: 1rem 0.5rem 0.75rem 0.5rem; display: flex; flex-direction: column; align-items: center;
			border: 1dp #ffffff12; border-radius: 2dp; background-color: #0000004d; text-align: center; }
		.tier .rk { font-size: 4rem; }
		.tier.mine { background-color: #ffffff0d; }
		.tier .you { margin-top: 0.25rem; font-size: 0.55rem; letter-spacing: 0.2em; color: #fff3e6; }
		.tier .n { margin-top: 0.5rem; font-size: 0.85rem; line-height: 1.4; letter-spacing: 0.1em; }
		.tier .r { font-size: 0.68rem; line-height: 1.5; color: #8d847c; }
		.tnote { margin-top: 0.5rem; font-size: 0.8rem; line-height: 1.375; color: #5d554f; }

		/* how ranked works */
		.how { display: flex; flex-wrap: wrap; margin: 0 -0.25rem; }
		.how .cell { display: flex; width: 50%; box-sizing: border-box; padding: 0 0.25rem 0.5rem 0.25rem; }
		.how .item { flex: 1 1 auto; display: flex; padding: 0.75rem; border: 1dp #ffffff12; border-radius: 2dp; background-color: #00000040; }
		.how .k {
			flex: 0 0 auto; width: 2.5rem; height: 2.5rem; margin-right: 0.75rem; box-sizing: border-box;
			border: 1dp #db241066; border-radius: 2dp; background-color: #db24101a;
			font-size: 0.95rem; line-height: 2.4rem; text-align: center; color: #ff4a1c;
		}
		.how .k.sym { font-family: Barlow; font-weight: 600; font-size: 1.1rem; }
		.how .txt { flex: 1 1 auto; width: 4rem; }
		.how .n { font-size: 0.8rem; line-height: 1.5; letter-spacing: 0.12em; color: #fff3e6; }
		.how .t { font-size: 0.8rem; line-height: 1.375; color: #8d847c; }
	</style>
</head>
<!--
Ranked (RankedPage.tsx): your rank, how the ladder works, and the six tiers from Bronze to Godlike
with their icons (RankIcon.tsx, built in CSS in play.rcss). The ladder and its queues come with
matchmaking (P8b): the player's rank is stand-in data (level 1, locked until 30) and Queue is refused.
-->
<body data-model="menu">
	<div class="panel">
		<div class="corners"><div class="tl"/><div class="tr"/><div class="bl"/><div class="br"/></div>
		<div class="topline"/>
		<div class="phead">
			<div>
				<banner text="Ranked"/>
				<p class="subtitle" data-if="ranked.locked">Competitive queues with an MMR ladder from Bronze to Godlike, open from level {{ ranked.need }}. Every match you finish earns XP toward it.</p>
				<p class="subtitle" data-if="!ranked.locked">Competitive queues with an MMR ladder from Bronze to Godlike. Ten placement matches set your starting rank.</p>
			</div>
			<div class="backbtn" onclick="back"><kbd>Esc</kbd><span>Back</span></div>
		</div>
		<div class="divider"/>
		<div class="pbody">
			<div class="cols">
				<div class="lcol">
					<div class="box card">
						<div class="badge9">
							<div class="ring"/>
							<!-- generated: unranked icon -->
							<div class="rk"><i class="t" style="left: 0.1367em; top: 0.1921em; border-top-color: #0a0807; transform: matrix(0.3633, -0.1187, 0.7265, 0.0000, 0, 0);"/><i class="t" style="left: 0.1368em; top: 0.1908em; border-top-color: #0a0807; transform: matrix(0.7261, -0.0007, 0.7255, 0.3285, 0, 0);"/><i class="t" style="left: 0.1372em; top: 0.1898em; border-top-color: #0a0807; transform: matrix(0.7260, 0.3278, 0.7069, 0.4641, 0, 0);"/><i class="t" style="left: 0.1375em; top: 0.1893em; border-top-color: #0a0807; transform: matrix(0.7072, 0.4636, 0.6554, 0.5829, 0, 0);"/><i class="t" style="left: 0.1379em; top: 0.1889em; border-top-color: #0a0807; transform: matrix(0.6557, 0.5825, 0.5777, 0.6849, 0, 0);"/><i class="t" style="left: 0.1383em; top: 0.1885em; border-top-color: #0a0807; transform: matrix(0.5781, 0.6846, 0.4806, 0.7715, 0, 0);"/><i class="t" style="left: 0.1388em; top: 0.1882em; border-top-color: #0a0807; transform: matrix(0.4811, 0.7712, 0.3622, 0.8499, 0, 0);"/><i class="t" style="left: 0.1393em; top: 0.188em; border-top-color: #0a0807; transform: matrix(0.3625, 0.8498, 0.2441, 0.7723, 0, 0);"/><i class="t" style="left: 0.1396em; top: 0.1879em; border-top-color: #0a0807; transform: matrix(0.2445, 0.7722, 0.1472, 0.6865, 0, 0);"/><i class="t" style="left: 0.14em; top: 0.1878em; border-top-color: #0a0807; transform: matrix(0.1476, 0.6864, 0.0696, 0.5854, 0, 0);"/><i class="t" style="left: 0.1403em; top: 0.1878em; border-top-color: #0a0807; transform: matrix(0.0700, 0.5853, 0.0181, 0.4674, 0, 0);"/><i class="t" style="left: 0.159em; top: 0.6552em; border-top-color: #0a0807; transform: matrix(-0.0188, -0.1347, -0.0185, -0.4674, 0, 0);"/><i class="t" style="left: 0.168em; top: 0.215em; border-top-color: #1a1614; transform: matrix(0.3320, -0.1087, 0.6640, 0.0000, 0, 0);"/><i class="t" style="left: 0.1681em; top: 0.2137em; border-top-color: #1a1614; transform: matrix(0.6636, -0.0008, 0.6629, 0.3035, 0, 0);"/><i class="t" style="left: 0.1685em; top: 0.2126em; border-top-color: #1a1614; transform: matrix(0.6634, 0.3029, 0.6452, 0.4329, 0, 0);"/><i class="t" style="left: 0.1688em; top: 0.2121em; border-top-color: #1a1614; transform: matrix(0.6455, 0.4324, 0.5969, 0.5443, 0, 0);"/><i class="t" style="left: 0.1692em; top: 0.2117em; border-top-color: #1a1614; transform: matrix(0.5972, 0.5439, 0.5233, 0.6409, 0, 0);"/><i class="t" style="left: 0.1696em; top: 0.2113em; border-top-color: #1a1614; transform: matrix(0.5237, 0.6405, 0.4300, 0.7240, 0, 0);"/><i class="t" style="left: 0.1701em; top: 0.2111em; border-top-color: #1a1614; transform: matrix(0.4305, 0.7237, 0.3309, 0.7896, 0, 0);"/><i class="t" style="left: 0.1705em; top: 0.2109em; border-top-color: #1a1614; transform: matrix(0.3312, 0.7895, 0.2321, 0.7247, 0, 0);"/><i class="t" style="left: 0.1708em; top: 0.2108em; border-top-color: #1a1614; transform: matrix(0.2324, 0.7246, 0.1390, 0.6423, 0, 0);"/><i class="t" style="left: 0.1712em; top: 0.2107em; border-top-color: #1a1614; transform: matrix(0.1394, 0.6423, 0.0656, 0.5466, 0, 0);"/><i class="t" style="left: 0.1715em; top: 0.2107em; border-top-color: #1a1614; transform: matrix(0.0660, 0.5466, 0.0173, 0.4361, 0, 0);"/><i class="t" style="left: 0.1894em; top: 0.6468em; border-top-color: #1a1614; transform: matrix(-0.0180, -0.1283, -0.0177, -0.4362, 0, 0);"/><i class="t" style="left: 0.2227em; top: 0.2525em; border-top-color: #43403e; transform: matrix(0.2773, -0.0928, 0.5546, 0.0000, 0, 0);"/><i class="t" style="left: 0.2228em; top: 0.2512em; border-top-color: #43403e; transform: matrix(0.5542, -0.0008, 0.5535, 0.2676, 0, 0);"/><i class="t" style="left: 0.2232em; top: 0.2501em; border-top-color: #43403e; transform: matrix(0.5540, 0.2670, 0.5388, 0.3762, 0, 0);"/><i class="t" style="left: 0.2235em; top: 0.2497em; border-top-color: #43403e; transform: matrix(0.5391, 0.3758, 0.4984, 0.4726, 0, 0);"/><i class="t" style="left: 0.2239em; top: 0.2492em; border-top-color: #43403e; transform: matrix(0.4988, 0.4722, 0.4383, 0.5567, 0, 0);"/><i class="t" style="left: 0.2244em; top: 0.2489em; border-top-color: #43403e; transform: matrix(0.4387, 0.5563, 0.3638, 0.6293, 0, 0);"/><i class="t" style="left: 0.2249em; top: 0.2486em; border-top-color: #43403e; transform: matrix(0.3643, 0.6290, 0.2761, 0.6946, 0, 0);"/><i class="t" style="left: 0.2253em; top: 0.2484em; border-top-color: #43403e; transform: matrix(0.2764, 0.6945, 0.1887, 0.6300, 0, 0);"/><i class="t" style="left: 0.2256em; top: 0.2483em; border-top-color: #43403e; transform: matrix(0.1891, 0.6299, 0.1145, 0.5581, 0, 0);"/><i class="t" style="left: 0.2259em; top: 0.2483em; border-top-color: #43403e; transform: matrix(0.1149, 0.5580, 0.0545, 0.4748, 0, 0);"/><i class="t" style="left: 0.2262em; top: 0.2482em; border-top-color: #43403e; transform: matrix(0.0549, 0.4748, 0.0143, 0.3794, 0, 0);"/><i class="t" style="left: 0.2411em; top: 0.6276em; border-top-color: #43403e; transform: matrix(-0.0149, -0.1076, -0.0146, -0.3794, 0, 0);"/><i class="t" style="left: 0.2383em; top: 0.2639em; border-top-color: #110e0d; transform: matrix(0.2617, -0.0877, 0.5234, 0.0000, 0, 0);"/><i class="t" style="left: 0.2384em; top: 0.2626em; border-top-color: #110e0d; transform: matrix(0.5229, -0.0008, 0.5222, 0.2553, 0, 0);"/><i class="t" style="left: 0.2388em; top: 0.2615em; border-top-color: #110e0d; transform: matrix(0.5227, 0.2547, 0.5079, 0.3608, 0, 0);"/><i class="t" style="left: 0.2392em; top: 0.261em; border-top-color: #110e0d; transform: matrix(0.5082, 0.3604, 0.4690, 0.4536, 0, 0);"/><i class="t" style="left: 0.2396em; top: 0.2606em; border-top-color: #110e0d; transform: matrix(0.4693, 0.4532, 0.4106, 0.5352, 0, 0);"/><i class="t" style="left: 0.24em; top: 0.2602em; border-top-color: #110e0d; transform: matrix(0.4111, 0.5348, 0.3379, 0.6061, 0, 0);"/><i class="t" style="left: 0.2405em; top: 0.26em; border-top-color: #110e0d; transform: matrix(0.3384, 0.6058, 0.2604, 0.6638, 0, 0);"/><i class="t" style="left: 0.2409em; top: 0.2598em; border-top-color: #110e0d; transform: matrix(0.2608, 0.6637, 0.1833, 0.6067, 0, 0);"/><i class="t" style="left: 0.2412em; top: 0.2597em; border-top-color: #110e0d; transform: matrix(0.1836, 0.6066, 0.1108, 0.5365, 0, 0);"/><i class="t" style="left: 0.2416em; top: 0.2596em; border-top-color: #110e0d; transform: matrix(0.1112, 0.5365, 0.0526, 0.4558, 0, 0);"/><i class="t" style="left: 0.2419em; top: 0.2596em; border-top-color: #110e0d; transform: matrix(0.0530, 0.4558, 0.0139, 0.3639, 0, 0);"/><i class="t" style="left: 0.2563em; top: 0.6235em; border-top-color: #110e0d; transform: matrix(-0.0145, -0.1045, -0.0142, -0.3639, 0, 0);"/><div class="p q">?</div></div>
							<!-- end: unranked icon -->
						</div>
						<div class="q3 big">{{ ranked.locked ? 'Locked' : 'Unranked' }}</div>
						<div class="why">Reach level {{ ranked.need }} to play ranked</div>
						<div class="bar"><div class="fill" data-style-width="ranked.progress"/></div>
						<div class="q3 lvl">Level {{ ranked.level }} / {{ ranked.need }}</div>
					</div>
					<button id="rk_boards" class="btn small wide" onclick="page leaderboards">Leaderboards</button>
					<div class="section"><span class="t">Queues</span><span class="rule"/></div>
					<div class="queue" data-for="q : ranked.queues">
						<div class="who"><div class="q3 n">{{ q.name }}</div><div class="t trunc">{{ q.text }}</div></div>
						<button class="btn small" autofocus="" data-attr-id="'rk_queue_' + q.id" data-class-refused="ranked.locked" onclick="soon ranked">Queue</button>
					</div>
				</div>

				<div class="rcol">
					<div class="section first"><span class="t">Tiers</span><span class="rule"/></div>
					<div class="tiers">
						<!-- generated: tier cards -->
						<div class="tier" data-class-mine="ranked.tier == 'bronze'" data-style-border-color="ranked.tier == 'bronze' ? '#c27a45' : '#ffffff12'">
