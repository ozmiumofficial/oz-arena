<rml>
<head>
	<title>UI effects test</title>
	<style>
		/* ui_test.py's measured page: clip masks, mask images and blurred box shadows on a flat gray,
		   at fixed places in dp (1dp is a pixel at 1080p), so the checks can read the capture's pixels.
		   RmlUi has no default style sheet: divs are inline until told otherwise. */
		body {
			display: block;
			width: 100%;
			height: 100%;
			background-color: #808080;
		}
		div {
			display: block;
		}
		scrollbarvertical { width: 10dp; }
		scrollbarvertical slidertrack { background-color: #00000040; }
		scrollbarvertical sliderbar { background-color: #ffffff80; min-height: 20dp; }
		.cell {
			position: absolute;
			width: 200dp;
			height: 200dp;
		}
		.fill {
			position: absolute;
			left: -20dp; top: -20dp; right: -20dp; bottom: -20dp;
			background-color: #ffffff;
		}

		/* rounded clips: on the page, inside a filtered layer, inside a glass panel, a scroll container */
		.round {
			overflow: hidden;
			border-radius: 80dp;
		}
		.layer {
			position: absolute;
			left: 340dp; top: 60dp;
			width: 280dp; height: 280dp;
			filter: brightness( 1 );
		}
		.glass {
			position: absolute;
			left: 660dp; top: 60dp;
			width: 280dp; height: 280dp;
			backdrop-filter: blur( 6dp );
			box-shadow: #00000000 0dp 0dp 10dp 0dp;
		}
		.scroll {
			position: absolute;
			left: 1450dp; top: 100dp;
			width: 300dp; height: 300dp;
			overflow-y: auto;
			border-radius: 60dp;
		}
		.scroll .tall {
			height: 900dp;
			background-color: #ffffff;
		}

		/* mask images: a linear fade, a ring, translucent faded rows in a scroll container (P5's lists) */
		.fade {
			background-color: #ff0000;
			mask-image: linear-gradient( to right, #000000ff, #00000000 );
		}
		.ring {
			background-color: #ffffff;
			mask-image: radial-gradient( circle closest-side, #00000000 70%, #000000 71%, #000000 100%, #00000000 100% );
		}
		.rows {
			position: absolute;
			left: 1450dp; top: 500dp;
			width: 300dp; height: 300dp;
			overflow-y: auto;
		}
		.rows .row {
			position: relative;
			height: 100dp;
			margin-bottom: 20dp;
		}
		.rows .strip {
			position: absolute;
			left: 0; right: 0; top: 0; bottom: 0;
			background-color: #ff0000;
			opacity: 0.5;
			mask-image: linear-gradient( to right, #000000ff, #00000000 );
		}

		/* box shadows: a blurred one without offset or spread (drew nothing), the glass panels' own (a band) */
		.shadow {
			background-color: #808080;
			box-shadow: #000000 0dp 0dp 40dp 0dp;
		}
		.panel-shadow {
			background-color: #808080;
			box-shadow: #000000a0 0dp 12dp 40dp 0dp;
		}
	</style>
</head>
<body>
	<div class="cell round" style="left: 100dp; top: 100dp;"><div class="fill"/></div>
	<div class="layer"><div class="cell round" style="left: 40dp; top: 40dp;"><div class="fill"/></div></div>
	<div class="glass"><div class="cell round" style="left: 40dp; top: 40dp;"><div class="fill"/></div></div>
	<div class="scroll"><div class="tall"/></div>

	<div class="cell fade" style="left: 100dp; top: 500dp;"/>
	<div class="cell ring" style="left: 380dp; top: 500dp;"/>
	<div class="rows"><div class="row"><div class="strip"/></div><div class="row"><div class="strip"/></div><div class="row"><div class="strip"/></div><div class="row"><div class="strip"/></div></div>

	<div class="cell shadow" style="left: 1100dp; top: 140dp;"/>
	<div class="cell panel-shadow" style="left: 1100dp; top: 600dp;"/>
</body>
</rml>
