/* Settings > Accessibility for color_picker: generated by engine/tools/menu/gen_access.py from its styles; don't edit. */

/* rcss/menu.rcss */
body.hc .dim { color: #d9d0c6; }
body.hc .faint { color: #b0a79e; }
body.hc .mitem .num { color: #b0a79e; }
body.hc .mitem .label { color: #e6ddd2; }
body.hc .mitem.dimmed .label { color: #e6ddd2; }
body.calm .mitem button:focus .label { animation: none; }
body.hc .mitem .hint { color: #d9d0c6; }
body.hc .mitem.md button:focus + .hint { color: #e6ddd2; }
body.hc .panel { background-color: #0a0807; }
body.hc .subtitle { color: #d9d0c6; }
body.hc .backbtn { color: #d9d0c6; }
body.hc .backbtn kbd { color: #d9d0c6; }
body.hc .pfoot { background-color: #000000; }
body.hc .badge.dimb { color: #d9d0c6; }
body.hc .empty { background-color: #000000; }
body.hc .empty p { color: #d9d0c6; }
body.hc .toggle .track { background-color: #000000; }
body.hc .toggle .state { color: #d9d0c6; }
body.hc .spinner { background-color: #000000; }
body.hc .spinner .arrow { color: #d9d0c6; }
body.hc input.text { background-color: #000000; }
body.hc input.text:focus { background-color: #000000; }
body.hc input.text:placeholder-shown { color: #b0a79e; }
body.hc .tabs .tab { color: #d9d0c6; }
body.hc .table { background-color: #000000; }
body.hc .thead { color: #d9d0c6; }
body.hc .dialog { background-color: #0a0807; }
body.hc scrollbarvertical slidertrack { background-color: #000000; }
