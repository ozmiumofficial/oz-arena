/*
The Play pages' shared pieces (ENGINE_PLAN.md P5): Quick Play, Ranked, the Server Browser,
Dedicated Server and Training (the web menu's PlayPages.tsx, RankedPage.tsx, RankIcon.tsx,
DedicatedPage.tsx, QueueBar.tsx). Linked after menu.rcss.
*/

/* the panel's body as a padded column (flex h-full flex-col px-10 py-6) */
.col {
	position: absolute;
	left: 0; right: 0; top: 0; bottom: 0;
	display: flex;
	flex-direction: column;
	padding: 1.5rem 2.5rem;
}

.grow { flex: 1; min-height: 0; }

.note {
	font-size: 0.85rem;
	line-height: 1.5;
	color: #5d554f;
}

/* a dark box (rounded-sm border border-white/10 bg-black/30) */
.box {
	border: 1dp #ffffff1a;
	border-radius: 2dp;
	background-color: #0000004d;
}

/* the big call to action (px-14 py-4; Button's own text-[1rem] wins over the page's text-[1.4rem]) */
button.btn.big {
	padding: 1rem 3.5rem;
	font-size: 1rem;
}

/* "Region: Automatic (Settings, Network)" */
.region {
	font-size: 0.95rem;
	color: #8d847c;
}

.region .ink { color: #e6ddd2; }

/* a label beside a toggle (label flex items-center gap-3 text-[0.95rem] text-dim) */
.lbl {
	display: flex;
	align-items: center;
	margin-right: 2rem;
	font-size: 0.95rem;
	color: #8d847c;
}

.lbl > span.t { margin-right: 0.75rem; }

/* ---------------------------------------------------------------- playlist cards (PlaylistCard) */

.cards {
	display: flex;
	flex-wrap: wrap;
	margin: 0 -0.375rem;
}

.cards .cell {
	display: flex;
	flex-direction: column;
	width: 25%;
	box-sizing: border-box;
	padding: 0 0.375rem 0.75rem 0.375rem;
}

button.pcard {
	display: block;
	position: relative;
	flex: 1 1 auto;
	padding: 1rem;
	border: 1dp #ffffff1a;
	border-radius: 2dp;
	background-color: #0000004d;
	text-align: left;
	transition: border-color background-color 0.15s linear-in-out;
}

button.pcard:focus, button.pcard:hover { border-color: #ffffff4d; }

button.pcard.on {
	border-color: #ff4a1cb3;
	background-color: #db241026;
	box-shadow: #db241040 0 0 1.2rem 0;
}

button.pcard .n {
	padding-right: 1rem;
	font-size: 1.15rem;
	line-height: 1.4;
	letter-spacing: 0.06em;
	color: #e6ddd2;
}

button.pcard.on .n { color: #fff3e6; }

button.pcard .t {
	margin-top: 0.25rem;
	font-size: 0.85rem;
	line-height: 1.45;
	color: #8d847c;
}

button.pcard .dot {
	position: absolute;
	right: 0.75rem;
	top: 0.75rem;
	width: 0.75rem;
	height: 0.75rem;
	box-sizing: border-box;
	border: 1dp #ffffff33;
	border-radius: 0.375rem;
}

button.pcard.on .dot {
	border-color: #ff4a1c;
	background-color: #ff4a1c;
	box-shadow: #ff4a1c 0 0 0.6rem 0;
}

/* ---------------------------------------------------------------- a five-pointed star (three triangles), 1em wide */

.star5 {
	position: relative;
	display: block;
	width: 0;
	height: 0;
	border-left: 0.5em #00000000;
	border-right: 0.5em #00000000;
	border-bottom: 0.35em #ffffff;
	transform: rotate(35deg);
}

.star5 .s1, .star5 .s2 {
	position: absolute;
	display: block;
	width: 0;
	height: 0;
}

.star5 .s1 {
	top: -0.225em;
	left: -0.325em;
	border-left: 0.15em #00000000;
	border-right: 0.15em #00000000;
	border-bottom: 0.4em #ffffff;
	transform: rotate(-35deg);
}

.star5 .s2 {
	top: 0.015em;
	left: -0.525em;
	border-left: 0.5em #00000000;
	border-right: 0.5em #00000000;
	border-bottom: 0.35em #ffffff;
	transform: rotate(-70deg);
}

/* ---------------------------------------------------------------- rank icons (RankIcon.tsx)

Built by engine/tools/make_rank_icons.py from the web's SVG paths (it writes the markup into
ranked.rml): 1em wide and 1.25em tall, a unit of the web's 64 x 80 viewBox is 1/64 em. A .t is a
triangle: the right triangle of its top border, mapped onto the path's triangle by matrix(). A .p
is a box: the shield's gradient rows, the glows, the eye's iris. */
.rk {
	position: relative;
	width: 1em;
	height: 1.25em;
}

.rk .p, .rk .t { position: absolute; display: block; }

.rk .t {
	width: 0;
	height: 0;
	border-top: 1em #000000;
	border-right: 1em #00000000;
	transform-origin: left top;
}

/* Unranked's question mark (22 units, centered on the shield) */
.rk .q {
	left: 0;
	top: 1.05em;
	width: 2.909em;
	font-family: OzDisplay;
	font-size: 0.34375em;
	line-height: 1;
	text-align: center;
	color: #8d847c;
}

/* Godlike's glow breathes (the web's q3-godlike) */
.rk.godlike > .p:first-child, .rk.godlike > .p:first-child + .p { animation: 2s sine-in-out infinite alternate rk-pulse; }
@keyframes rk-pulse { from { opacity: 0.65; } to { opacity: 1; } }
