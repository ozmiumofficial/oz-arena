/*
The Settings page (generated from ui/settings.json by the engine, oz_ui_settings.cpp), laid out as the
web menu's SettingsPage in its PagePanel: the tabs and the search over a scrolling list of rows, the
focused setting's description beside it, reset and config codes below. On top of menu.rcss.
*/

.bar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin: 0.75rem 2.5rem 0 2.5rem;
	border-bottom: 1dp #ffffff14;
}

.bar .tabs .tab { margin-right: 1.25rem; font-size: 0.7rem; }

.bar input.text {
	width: 10rem;
	height: 2rem;
	padding: 0.3rem 0.625rem;
	font-size: 0.85rem;
	margin-bottom: 0.4rem;
}

.body {
	position: relative;
	flex: 1;
	min-height: 0;
	display: flex;
	padding: 0 2.5rem;
}

.list {
	flex: 1;
	overflow-y: auto;
	padding: 0.5rem 1rem 1rem 0;
}

.group {
	display: flex;
	align-items: center;
	margin: 0.9rem 0 0.4rem 0;
}

.group .t {
	font-family: OzDisplay;
	font-size: 0.7rem;
	letter-spacing: 0.3em;
	color: #db2410;
	margin-right: 0.75rem;
}

.group .rule {
	flex: 1;
	height: 1px;	/* 1dp falls between pixel rows below 1080p */
	decorator: linear-gradient( 90deg, #db241066 0%, #db241000 100% );
}

.row {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 2.7rem;
	padding: 0 3rem 0 0.625rem;
	border-left: 3dp #00000000;
}

.row:hover { background-color: #ffffff08; }

.row .label {
	display: flex;
	align-items: center;
	font-size: 1rem;
	color: #e6ddd2;
}

.row.modified .label span { color: #ffad33; }

.row .badge { margin-left: 0.5rem; }

.control {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	width: 18.25rem;
}

.control .value {
	min-width: 5rem;
	margin-left: 0.75rem;
	font-size: 0.85rem;
	letter-spacing: 0.05em;
	text-align: right;
	color: #e6ddd2;
}

.control input.slider { width: 13rem; }

.control .spinner { width: 18.25rem; height: 2.1rem; }

.control .toggle { margin-right: 0.25rem; }

.binds { display: flex; }

.binds .bind {
	min-width: 5.5rem;
	margin-left: 0.375rem;
	padding: 0.3rem 0.6rem;
	border: 1dp #ffffff1a;
	border-radius: 2dp;
	background-color: #00000066;
	font-family: OzDisplay;
	font-size: 0.75rem;
	letter-spacing: 0.08em;
	text-align: center;
	color: #e6ddd2;
}

.binds .bind:focus, .binds .bind:hover {
	border-color: #ff4a1cb3;
	background-color: #db24101a;
	color: #fff3e6;
}

.binds .bind.pad { color: #8d847c; }

.swatch {
	display: inline-block;
	width: 1.6rem;
	height: 1.6rem;
	margin-right: 0.5rem;
	border: 1dp #5a4f49;
	border-radius: 2dp;
}

.control input.text { width: 13rem; height: 2.1rem; padding: 0.35rem 0.6rem; }
.control input.color { width: 8rem; }

/* the focused setting's description */
.info {
	width: 17.5rem;
	margin: 0.5rem 0 1rem 1.5rem;
	padding: 1rem;
	align-self: flex-start;
	border: 1dp #ffffff12;
	background-color: #00000040;
}

.info-label {
	font-size: 1rem;
	letter-spacing: 0.06em;
	color: #fff3e6;
}

.info-text {
	margin-top: 0.6rem;
	font-size: 0.9rem;
	line-height: 1.5;
	color: #e6ddd2;
}

.info-note {
	margin-top: 0.9rem;
	padding-top: 0.6rem;
	border-top: 1dp #ffffff14;
	font-size: 0.75rem;
	color: #8d847c;
}

.preview {
	margin-top: 1rem;
	padding: 1rem;
	text-align: center;
	background-color: #00000060;
}

.preview.crosshair {
	position: relative;
	height: 9rem;
	padding: 0;
	overflow: hidden;
	clip: always;	/* the close-up is absolute, so it would never count as overflow */
}

/* the level shot close up, on the space beside the arena, a little darker (as the crosshair editor's) */
.preview.crosshair .bg {
	position: absolute;
	left: -27%; top: -60%; width: 220%; height: 400%;
	decorator: image( /levelshots/q3dm17 cover );
}

.veil {
	position: absolute;
	left: 0; right: 0; top: 0; bottom: 0;
	background-color: #00000040;
}

/* the HUD draws it, at its size in the match (oz_ui_crosshair.cpp) */
.preview.crosshair crosshair {
	position: absolute;
	left: 0; right: 0; top: 0; bottom: 0;
}

.preview.cm360 {
	font-family: OzDisplay;
	font-size: 1.1rem;
	color: #ffad33;
}

.footer .note {
	margin-left: auto;
	font-size: 0.8rem;
	color: #5d554f;
}

/* a Video change waiting for Apply */
.row.pending { border-left-color: #ffad3399; }

.row.current {
	border-left-color: #ff4a1c;
	background-color: #ffffff0d;
}
