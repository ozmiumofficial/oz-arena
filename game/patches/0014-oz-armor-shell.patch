 /*
 ===============
+CG_OzArmorShell
+
+Oz: for 0.4 s after armor took part of a hit ("armorhit"), a glow over the body in the armor color, red
+under 50 armor, fading out (the Godot build's armor shell). Not on an invisible body.
+===============
+*/
+#define OZ_ARMOR_SHELL_MS	400
+static void CG_OzArmorShell( const refEntity_t *ent, const centity_t *cent ) {
+	int clientNum = cent->currentState.clientNum;
+	int dt;
+	float f;
+	qboolean low;
+	refEntity_t shell;
+
+	if ( clientNum < 0 || clientNum >= MAX_CLIENTS || !cgs.media.ozArmorShellShader || !cg.ozArmorHitTime[clientNum] ||
+		 cg.ozArmorLeft[clientNum] <= 0 || ( cent->currentState.powerups & ( 1 << PW_INVIS ) ) ) {
+		return;
+	}
+	dt = cg.time - cg.ozArmorHitTime[clientNum];
+	if ( dt < 0 || dt >= OZ_ARMOR_SHELL_MS ) {
+		return;
+	}
+	f = 1.0f - (float)dt / OZ_ARMOR_SHELL_MS;
+	low = cg.ozArmorLeft[clientNum] < 50;
+	shell = *ent;
+	shell.customShader = cgs.media.ozArmorShellShader;
+	shell.shaderRGBA[0] = 255 * f;
+	shell.shaderRGBA[1] = ( low ? 64 : 199 ) * f;
+	shell.shaderRGBA[2] = ( low ? 38 : 71 ) * f;
+	shell.shaderRGBA[3] = 255;
+	trap_R_AddRefEntityToScene( &shell );
+}
+
