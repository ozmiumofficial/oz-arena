+=================
+CG_OzFxUpdateCvars
+=================
+*/
+static int OzPick( const char *s, const char **names, int count, int fallback ) {
+	int i;
+	for ( i = 0; i < count; i++ ) {
+		if ( !Q_stricmp( s, names[i] ) ) {
+			return i;
+		}
+	}
+	return fallback;
+}
+
+// hue in sixths of a turn (0 red, 2 green, 4 blue), saturation, value
+static void OzRgbToHsv( const vec3_t c, vec3_t hsv ) {
+	float hi = MAX( c[0], MAX( c[1], c[2] ) ), lo = MIN( c[0], MIN( c[1], c[2] ) ), d = hi - lo, h = 0.0f;
+
+	if ( d > 0.0f ) {
+		if ( hi == c[0] ) {
+			h = ( c[1] - c[2] ) / d;
+		} else if ( hi == c[1] ) {
+			h = 2.0f + ( c[2] - c[0] ) / d;
+		} else {
+			h = 4.0f + ( c[0] - c[1] ) / d;
+		}
+	}
+	hsv[0] = h < 0.0f ? h + 6.0f : h;
+	hsv[1] = hi > 0.0f ? d / hi : 0.0f;
+	hsv[2] = hi;
+}
+
+static void OzHsvToRgb( const vec3_t hsv, vec3_t c ) {
+	float h = hsv[0], s = hsv[1], v = hsv[2], f;
+	int i;
+
+	while ( h < 0.0f ) {
+		h += 6.0f;
+	}
+	while ( h >= 6.0f ) {
+		h -= 6.0f;
+	}
+	i = (int)h;
+	f = h - i;
+	switch ( i ) {
+	case 0: VectorSet( c, v, v * ( 1 - s * ( 1 - f ) ), v * ( 1 - s ) ); break;
+	case 1: VectorSet( c, v * ( 1 - s * f ), v, v * ( 1 - s ) ); break;
+	case 2: VectorSet( c, v * ( 1 - s ), v, v * ( 1 - s * ( 1 - f ) ) ); break;
+	case 3: VectorSet( c, v * ( 1 - s ), v * ( 1 - s * f ), v ); break;
+	case 4: VectorSet( c, v * ( 1 - s * ( 1 - f ) ), v * ( 1 - s ), v ); break;
+	default: VectorSet( c, v, v * ( 1 - s ), v * ( 1 - s * f ) ); break;
+	}
+}
+
+#define OzLuma( c )		( 0.2126f * (c)[0] + 0.7152f * (c)[1] + 0.0722f * (c)[2] )
+
+/*
+A part of an effect made in the color `made`, in the color `pick` (Lightning color, Plasma color): its
+hue turns as far as made's turns to pick's, its saturation scales by pick's over made's, its value
+stays. So made gives every part back as it was, white or grey makes them white, and a dark color
+gives its hue at the part's brightness. A hue brighter to the eye than the part's (yellow, green for
+a blue) is dimmed halfway (in the square root) back to the part's luma, or the beams burn out to white.
+*/
+static void OzTint( const vec3_t pick, const vec3_t made, const vec3_t part, vec3_t out ) {
+	vec3_t p, m, h;
+	float y;
+
+	OzRgbToHsv( pick, p );
+	OzRgbToHsv( made, m );
+	OzRgbToHsv( part, h );
+	h[0] += p[0] - m[0];
+	h[1] = m[1] > 0.0f ? Com_Clamp( 0.0f, 1.0f, h[1] * p[1] / m[1] ) : 0.0f;
+	OzHsvToRgb( h, out );
+	y = OzLuma( out );
+	if ( y > OzLuma( part ) ) {
+		VectorScale( out, sqrt( OzLuma( part ) / y ), out );
+	}
+}
+
+// a color setting ("#rrggbb") on the parts made in parts[0], which is the setting's default `made`:
+// that, anything unreadable or `on` false leaves them as made; whether they changed
+static qboolean OzColorSetting( const char *s, int made, const vec3_t *parts, int count, qboolean on, vec3_t *out ) {
+	vec3_t pick;
+	int i, d, n = 0;
+
+	for ( i = 0; i < count; i++ ) {
+		VectorCopy( parts[i], out[i] );
+	}
+	if ( *s == '#' ) {
+		s++;
+	}
+	for ( i = 0; i < 6; i++ ) {
+		d = s[i] >= '0' && s[i] <= '9' ? s[i] - '0' : s[i] >= 'a' && s[i] <= 'f' ? s[i] - 'a' + 10 :
+			s[i] >= 'A' && s[i] <= 'F' ? s[i] - 'A' + 10 : -1;
+		if ( d < 0 ) {
+			return qfalse;
+		}
+		n = n * 16 + d;
+	}
+	if ( !on || s[6] || n == made ) {
+		return qfalse;
+	}
+	VectorSet( pick, ( n >> 16 & 255 ) / 255.0f, ( n >> 8 & 255 ) / 255.0f, ( n & 255 ) / 255.0f );
+	for ( i = 0; i < count; i++ ) {
+		OzTint( pick, parts[0], parts[i], out[i] );
+	}
+	return qtrue;
+}
