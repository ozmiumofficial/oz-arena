+/*
+=================
+CG_OzImpact
+
+The remaster's part of CG_MissileHitWall: sparks off bullet, rail, lightning and explosion hits
+(cg_fxStyle 1), and with Explosions "enhanced" embers and smoke after blasts and a glow where
+energy shots hit. `color` is the rail's color2.
+=================
+*/
+void CG_OzImpact( int weapon, vec3_t origin, vec3_t dir, const vec3_t color ) {
+	static const vec4_t fire0 = { 1, 0.9f, 0.6f, 1 }, fire1 = { 1, 0.45f, 0.1f, 1 }, fire2 = { 0.5f, 0.08f, 0.02f, 0 };
+	static const vec4_t bfg0 = { 0.8f, 1, 0.8f, 1 }, bfg1 = { 0.35f, 1, 0.35f, 1 }, bfg2 = { 0.1f, 0.4f, 0.1f, 0 };
+	// the puff image is id's tan (0.66 0.52 0.47): the smoke a light neutral grey, orange where the fire lights it
+	static const vec3_t smoke = { 0.75f, 0.9f, 1.0f }, lit = { 1.0f, 0.7f, 0.45f };
+	static const vec3_t hot = { 1, 0.85f, 0.6f }, green = { 0.4f, 1, 0.4f };
+	vec4_t pl0, pl1, pl2;		// the plasma's embers, in Plasma color
+
+	int surface, metal;
+
+	if ( !oz.remade ) {
+		return;
+	}
+	surface = OzSurface( origin, dir );
+	if ( surface == OZS_NONE ) {
+		return;
+	}
+	metal = surface == OZS_METAL;
+	// sparks off metal; off stone a puff of dust and grit, with a few sparks
+	switch ( weapon ) {
+	case WP_MACHINEGUN:
+		OzSparks( origin, dir, metal ? 8 : 2, 340, 0.45f, 0.8f );
+		if ( !metal ) {
+			OzDust( origin, dir, 3, 7.0f );
+		}
+		break;
+	case WP_SHOTGUN:
+		OzSparks( origin, dir, metal ? 3 : 1, 300, 0.4f, 0.8f );
+		if ( !metal ) {
+			OzDust( origin, dir, 1, 6.0f );
+		}
+		break;
+	case WP_RAILGUN:
+		OzSparks( origin, dir, metal ? 18 : 6, 420, 0.6f, 0.9f );
+		if ( !metal ) {
+			OzDust( origin, dir, 6, 12.0f );
+		}
+		break;
+	case WP_LIGHTNING: OzSparks( origin, dir, metal ? 2 : 1, 260, 0.3f, 0.9f ); break;
+	case WP_ROCKET_LAUNCHER:
+	case WP_GRENADE_LAUNCHER:
+		OzSparks( origin, dir, metal ? 30 : 14, 560, 0.9f, 1.0f );
+		if ( !metal ) {
+			OzDust( origin, dir, 8, 26.0f );
+		}
+		break;
+	default: break;
+	}
+	if ( weapon == WP_ROCKET_LAUNCHER || weapon == WP_GRENADE_LAUNCHER ) {
+		OzHeatBlast( origin, dir );
+	}
+	if ( !oz.explosions ) {
+		return;
+	}
+	switch ( weapon ) {
+	case WP_ROCKET_LAUNCHER:
+	case WP_GRENADE_LAUNCHER:
+		// a white-hot flash that lights the room, id's fireball (brighter, CG_OzExplosionShader),
+		// flames lingering and rising, embers thrown off, and smoke lit by the fire from below
+		OzFlash( origin, dir, hot, 70, 140, 520 );
+		OzFlames( origin, dir, 10 );
+		OzEmbers( origin, dir, 54, 110, 380, 1.2f, fire0, fire1, fire2 );
+		OzSmoke( origin, dir, 10, 2.2f, lit, smoke );
+		break;
+	case WP_BFG:
+		OzFlash( origin, dir, green, 60, 200, 400 );
+		OzEmbers( origin, dir, 36, 96, 320, 0.9f, bfg0, bfg1, bfg2 );
+		break;
+	case WP_PLASMAGUN:
+		VectorCopy( oz.pg[PG_EMBER], pl0 );
+		VectorCopy( oz.pg[PG_GLOW], pl1 );
+		VectorCopy( oz.pg[PG_EMBER_OUT], pl2 );
+		pl0[3] = pl1[3] = 1.0f;
+		pl2[3] = 0.0f;
+		OzFlash( origin, dir, oz.pg[PG_GLOW], 30, 180, 160 );
+		OzEmbers( origin, dir, 10, 48, 140, 0.45f, pl0, pl1, pl2 );
+		break;
+	case WP_RAILGUN:
+		OzFlash( origin, dir, color, 32, 260, 200 );
+		break;
+	case WP_LIGHTNING:
+		OzFlash( origin, dir, oz.lg[LG_HIT], 14, 100, 0 );
+		break;
+	default:
+		break;
+	}
+}
