+#define OzLerp3( f, a, b, out ) ( (out)[0] = (a)[0] + (f) * ( (b)[0] - (a)[0] ), (out)[1] = (a)[1] + (f) * ( (b)[1] - (a)[1] ), 	(out)[2] = (a)[2] + (f) * ( (b)[2] - (a)[2] ) )
+#define OzLerp4( f, a, b, out ) ( OzLerp3( f, a, b, out ), (out)[3] = (a)[3] + (f) * ( (b)[3] - (a)[3] ) )
