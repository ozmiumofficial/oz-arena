+// a muzzle flash's light color (CG_AddPlayerWeapon): id's, or the lightning and plasma guns' in their color
+const float *CG_OzFlashColor( int weapon, const float *color ) {
+	return weapon == WP_LIGHTNING ? oz.lg[LG_FLASH] : weapon == WP_PLASMAGUN ? oz.pg[PG_FLASH] : color;
+}
+
+/*
+id's images in another Lightning or Plasma color: the bolt, the plasma ball, its ring and its scorch
+are cyan or blue, with next to no red in them, so a color multiplied in lost them. Their tint shaders
+(scripts/oz_cgame.ozmtr, the oz renderer's) draw the image grey first (ozMono, its brightest
+channel), and the entity or vertex color colors it: the part's hue at full brightness, `white` of
+the way to white (their cores are near white), dimmed as OzTint dims where it's brighter to the eye
+than the part made in blue would be.
+*/
+static void OzTintColor( const vec3_t c, float white, vec3_t out ) {
+	float hi = MAX( c[0], MAX( c[1], c[2] ) );
+	int i;
+
+	for ( i = 0; i < 3; i++ ) {
+		float v = hi > 0.0f ? c[i] / hi : 1.0f;
+		out[i] = v + white * ( 1.0f - v );
+	}
+}
+
+static void OzTintBytes( const vec3_t c, const vec3_t made, float white, byte *rgba ) {
+	vec3_t t, m;
+	float k = 1.0f;
+	int i;
+
+	OzTintColor( c, white, t );
+	OzTintColor( made, white, m );
+	if ( OzLuma( t ) > OzLuma( m ) ) {
+		k = sqrt( OzLuma( m ) / OzLuma( t ) );
+	}
+	for ( i = 0; i < 3; i++ ) {
+		rgba[i] = (byte)( 255 * Com_Clamp( 0.0f, 1.0f, t[i] * k ) );
+	}
+	rgba[3] = 255;
+}
