+/*
+=================
+CG_OzBleed
+
+Blood "heavy": a spray of droplets falling away from the hit, with CG_Bleed's puff.
+=================
+*/
+void CG_OzBleed( vec3_t origin ) {
+	static const vec4_t c0 = { 0.55f, 0, 0, 0.95f }, c2 = { 0.35f, 0, 0, 0 };
+	static const vec3_t up = { 0, 0, 1 };
+	vec4_t c1;
+	vec3_t d, vel;
+	int i, n;
+
+	if ( oz.blood != 2 ) {
+		return;
+	}
+	OzLerp4( 0.5f, c0, c2, c1 );
+	n = OzCount( 18 );
+	for ( i = 0; i < n; i++ ) {
+		float r = OzRand( 0.8f, 1.8f );
+		OzConeDir( up, 90.0f, d );
+		VectorScale( d, OzRand( 32.0f, 128.0f ), vel );
+		OzParticle( origin, vel, 800, r, r * 0.6f, c0, c1, c2, ozMedia.blood, OZP_STICK )->ozGravity = 314.0f;
+	}
+}
+
+/*
+=================
+CG_OzMissileTrail
+
+Missile trails "enhanced": glowing puffs left along the flight (Godot's GLOW_TRAILS: step,
+radius, life, color), a burning core behind rockets and grenades and energy trails behind
+plasma and the BFG, beside id's smoke.
+=================
+*/
+void CG_OzMissileTrail( centity_t *cent ) {
+	entityState_t *es = &cent->currentState;
+	int step, life, t;
+	float radius, endRadius;
+	vec4_t c0, c1, c2;
+	vec3_t at;
+
+	if ( es->weapon == WP_ROCKET_LAUNCHER && oz.heat && ozMedia.heat && es->pos.trType != TR_STATIONARY ) {
+		// heat shimmer in the exhaust: a small disc 20 units behind, half the blast's bend
+		refEntity_t re;
+		vec3_t back;
+		memset( &re, 0, sizeof( re ) );
+		BG_EvaluateTrajectory( &es->pos, cg.time, re.origin );
+		VectorCopy( es->pos.trDelta, back );
+		if ( VectorNormalize( back ) > 0.0f && !( CG_PointContents( re.origin, -1 ) & CONTENTS_WATER ) ) {
+			VectorMA( re.origin, -20.0f, back, re.origin );
+			re.reType = RT_SPRITE;
+			re.radius = 18.0f;
+			re.customShader = ozMedia.heat;
+			re.shaderRGBA[0] = re.shaderRGBA[1] = re.shaderRGBA[2] = 255;
+			re.shaderRGBA[3] = 128;
+			trap_R_AddRefEntityToScene( &re );
+		}
+	}
+	if ( !oz.trails || es->pos.trType == TR_STATIONARY ) {
+		cent->ozTrailTime = cg.time;
+		return;
+	}
+	switch ( es->weapon ) {
+	case WP_ROCKET_LAUNCHER: step = 10; radius = 9; life = 170; VectorSet( c0, 1.0f, 0.55f, 0.2f ); break;
+	case WP_GRENADE_LAUNCHER: step = 16; radius = 5; life = 220; VectorSet( c0, 1.0f, 0.4f, 0.12f ); break;
+	case WP_PLASMAGUN: step = 6; radius = 6; life = 160; VectorCopy( oz.pg[PG_TRAIL], c0 ); break;
+	case WP_BFG: step = 10; radius = 16; life = 320; VectorSet( c0, 0.3f, 1.0f, 0.3f ); break;
+	default: return;
+	}
+	VectorCopy( c0, c1 );
+	endRadius = radius;
+	if ( es->weapon == WP_ROCKET_LAUNCHER ) {
+		// the rocket's flame: hot behind the rocket, cooling to a dim red as it shrinks (at full
+		// strength all along its puffs added up to a white blur, far brighter than id's rocket)
+		VectorSet( c0, 0.5f, 0.24f, 0.07f );
+		VectorSet( c1, 0.22f, 0.07f, 0.02f );
+		endRadius = 3.0f;
+	}
+	BG_EvaluateTrajectory( &es->pos, cg.time, at );
+	if ( CG_PointContents( at, -1 ) & ( CONTENTS_WATER | CONTENTS_SLIME | CONTENTS_LAVA ) ) {
+		cent->ozTrailTime = cg.time;
+		return;
+	}
+	if ( cent->ozTrailTime < cg.time - 500 || cent->ozTrailTime > cg.time ) {
+		cent->ozTrailTime = cg.time - step;		// a missile just seen: start here, not at its launch
+	}
+	c0[3] = c1[3] = 1.0f;
+	VectorCopy( c1, c2 );
+	c2[3] = 0.0f;
+	for ( t = step * ( ( cent->ozTrailTime + step ) / step ); t <= cg.time; t += step ) {
+		localEntity_t *le;
+		BG_EvaluateTrajectory( &es->pos, t, at );
+		le = OzParticle( at, vec3_origin, life, radius, endRadius, c0, c1, c2, ozMedia.glow, OZP_ADD );
+		le->ozGravity = 0.0f;
+		le->startTime = t;
+		le->endTime = t + life;
+	}
+	cent->ozTrailTime = cg.time;
+}
+
+/*
+=================
+CG_OzMuzzleFlash
+
+The remade muzzle flash, with id's flash model (CG_AddPlayerWeapon): a hot flare in the flash's
+color while it shows, and once a shot sparks thrown forward and a wisp of smoke from the machine
+gun and shotgun. None with Reduced flashing.
+=================
+*/
+void CG_OzMuzzleFlash( centity_t *cent, int weapon, const refEntity_t *flash, const vec3_t color ) {
+	static const vec4_t s0 = { 0.5f, 0.48f, 0.45f, 0.0f }, s1 = { 0.45f, 0.43f, 0.4f, 0.3f }, s2 = { 0.4f, 0.38f, 0.36f, 0.0f };
+	refEntity_t re;
+	vec3_t vel, d, c;
+	float size;
+	int i, sparks;
+	localEntity_t *le;
+
+	if ( !oz.remade || oz.calm || weapon == WP_GAUNTLET || weapon == WP_GRAPPLING_HOOK ) {
+		return;
+	}
+	switch ( weapon ) {
+	case WP_MACHINEGUN: size = 10.0f; sparks = 2; break;
+	case WP_SHOTGUN: size = 16.0f; sparks = 5; break;
+	case WP_LIGHTNING: size = 7.0f; sparks = 0; break;
+	case WP_ROCKET_LAUNCHER: case WP_GRENADE_LAUNCHER: size = 13.0f; sparks = 0; break;
+	default: size = 9.0f; sparks = 0; break;
+	}
+	memset( &re, 0, sizeof( re ) );
+	re.reType = RT_SPRITE;
+	VectorCopy( flash->origin, re.origin );
+	re.radius = size * ( 0.85f + 0.3f * OzFlicker( 16 + cent->currentState.number ) );	// the lightning gun's shows on
+	re.rotation = OzFlicker( 1040 + cent->currentState.number ) * 360.0f;					// while it fires
+	re.customShader = ozMedia.glow;
+	if ( weapon == WP_LIGHTNING ) {
+		// the beam's blue, dim (in Lightning color's hue): a near-white flare, held all the time the
+		// beam fires, bloomed into a white blob in front of the view
+		VectorCopy( oz.lg[LG_MUZZLE], c );
+	} else {
+		VectorSet( c, 0.5f + 0.5f * color[0], 0.4f + 0.5f * color[1], 0.3f + 0.5f * color[2] );
+	}
+	re.shaderRGBA[0] = (byte)( 255 * Com_Clamp( 0, 1, c[0] ) * Com_Clamp( 0, 1, oz.gain ) );
+	re.shaderRGBA[1] = (byte)( 255 * Com_Clamp( 0, 1, c[1] ) * Com_Clamp( 0, 1, oz.gain ) );
+	re.shaderRGBA[2] = (byte)( 255 * Com_Clamp( 0, 1, c[2] ) * Com_Clamp( 0, 1, oz.gain ) );
+	re.shaderRGBA[3] = 255;
+	re.renderfx = flash->renderfx & ( RF_DEPTHHACK | RF_FIRST_PERSON | RF_THIRD_PERSON );
+	trap_R_AddRefEntityToScene( &re );
+
+	if ( cent->ozMuzzleTime == cent->muzzleFlashTime || !sparks ) {
+		return;
+	}
+	cent->ozMuzzleTime = cent->muzzleFlashTime;
+	if ( flash->renderfx & RF_DEPTHHACK ) {
+		return;		// the view's own gun: its sparks would fly in another depth range
+	}
+	OzSparks( flash->origin, flash->axis[0], sparks, 420, 0.18f, 0.35f );
+	for ( i = 0; i < OzCount( 2 ); i++ ) {
+		OzConeDir( flash->axis[0], 25.0f, d );
+		VectorScale( d, OzRand( 20.0f, 50.0f ), vel );
+		le = OzParticle( flash->origin, vel, (int)OzRand( 500.0f, 800.0f ), 2.0f, 9.0f, s0, s1, s2, ozMedia.smoke, 0 );
+		le->ozGravity = -20.0f;
+		le->ozDrag = 30.0f;
+	}
+}
