+void CG_OzFxRegisterCvars( void ) {
+	int i;
+	for ( i = 0; i < ARRAY_LEN( ozCvars ); i++ ) {
+		trap_Cvar_Register( ozCvars[i].vmCvar, ozCvars[i].cvarName, ozCvars[i].defaultString, ozCvars[i].cvarFlags );
+	}
+	oz.modCount = -1;
+	CG_OzFxUpdateCvars();
+}
