+// The rail gun's glow (id's rgbGen entity stages; brighter than white on the oz renderer,
+// scripts/oz_cgame.ozmtr) in the remade style, as the Godot build's q3_weapon_fx.gd: the player's
+// rail color almost dark after a shot, filling up with a flicker through the 1.5 s reload, a flash
+// when it's ready, then a slow breathing glow. With Reduced flashing, no flicker and no flash.
+// The classic style keeps id's ramp (CG_AddPlayerWeapon).
+void CG_OzRailTint( centity_t *cent, const clientInfo_t *ci, byte *rgba ) {
+	int since = cg.time - cent->pe.railFireTime;
+	float f, pop = 0.0f;
+	int i;
+
+	if ( !oz.remade ) {
+		return;
+	}
+	if ( since >= 0 && since < 1500 ) {
+		float c = since / 1500.0f;
+		f = 0.06f + 0.94f * c * c;
+		if ( !oz.calm ) {
+			f *= 0.85f + 0.15f * sin( cg.time * 0.001f * 2.0f * M_PI * 9.0f );
+		}
+	} else {
+		f = 0.72f + 0.28f * sin( cg.time * 0.001f * 2.0f * M_PI * 0.55f );
+		if ( since >= 1500 && since < 1750 && !oz.calm ) {
+			pop = 1.2f * ( 1.0f - ( since - 1500 ) / 250.0f );
+		}
+	}
+	for ( i = 0; i < 3; i++ ) {
+		rgba[i] = (byte)Com_Clamp( 0.0f, 255.0f, ci->c1RGBA[i] * f + 255.0f * pop );
+	}
+	rgba[3] = 255;
+}
