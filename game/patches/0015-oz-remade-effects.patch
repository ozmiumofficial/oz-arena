+/*
+Heat shimmer over a blast: a disc bending the picture behind it, swelling in fast and fading as
+it rises (Godot's 110 units across, 24 off the wall).
+*/
+static void OzHeatBlast( const vec3_t origin, const vec3_t dir ) {
+	static const vec4_t c0 = { 1, 1, 1, 0 }, c1 = { 1, 1, 1, 1 }, c2 = { 1, 1, 1, 0 };
+	vec3_t at;
+	localEntity_t *le;
+
+	if ( !oz.heat || !ozMedia.heat ) {
+		return;
+	}
+	VectorMA( origin, 24.0f, dir, at );
+	le = OzParticle( at, vec3_origin, 900, 70.0f, 110.0f, c0, c1, c2, ozMedia.heat, 0 );
+	le->ozGravity = -30.0f;
+	le->refEntity.rotation = 0.0f;
+}
+
+/*
+Smoke rising from a blast and spreading: lit by the fire at first (`lit`, its color while it
+fades in), then the smoke's own `color` paling as it rises and thins out. A thin haze at most
+(a third opaque): it never hides a fight behind it.
+*/
+static void OzSmoke( const vec3_t origin, const vec3_t dir, int count, float life, const vec3_t lit, const vec3_t color ) {
+	vec4_t c0, c1, c2;
+	vec3_t d, vel, at;
+	localEntity_t *le;
+	int i;
+
+	count = OzCount( count );
+	VectorCopy( lit, c0 ); c0[3] = 0.0f;
+	VectorCopy( color, c1 ); c1[3] = 0.32f;
+	VectorScale( color, 1.3f, c2 ); c2[3] = 0.0f;
+	for ( i = 0; i < count; i++ ) {
+		float r = OzRand( 14.0f, 26.0f );
+		OzConeDir( dir, 60.0f, d );
+		VectorScale( d, OzRand( 12.0f, 56.0f ), vel );
+		VectorSet( at, crandom(), crandom(), crandom() );
+		VectorMA( origin, 16.0f * random(), at, at );
+		VectorMA( at, 10.0f, dir, at );
+		le = OzParticle( at, vel, (int)( life * OzRand( 0.75f, 1.0f ) * 1000 ), r * 0.5f, r * 2.6f, c0, c1, c2, ozMedia.smoke, 0 );
+		le->ozGravity = -14.0f;
+		le->ozDrag = 8.0f;
+	}
+}
