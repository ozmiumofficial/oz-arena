+/*
+=================
+Particles (LE_OZ_PARTICLE): a sprite or a streak that flies under gravity, optionally bouncing,
+its color going start -> middle -> end over its life (le->color, le->ozColor[0], le->ozColor[1])
+and its radius from le->radius to le->ozRadius.
+=================
+*/
+static int OzCount( int n ) {
+	return (int)( n * oz.amount + 0.5f );
+}
+
+static float OzRand( float lo, float hi ) {
+	return lo + ( hi - lo ) * random();
+}
+
+// a flicker's 0..1 for `salt`, the same through each 25 ms: 40 changes a second at any frame rate
+static float OzFlicker( int salt ) {
+	unsigned h = (unsigned)( cg.time / 25 ) * 2654435761u ^ (unsigned)salt * 40503u;
+
+	h ^= h >> 15;
+	h *= 2246822519u;
+	h ^= h >> 13;
+	return ( h & 0xffff ) / 65535.0f;
+}
+
+// a direction off a surface with normal n: within `spread` (0 straight out .. 1 any way off it)
+static void OzSprayDir( const vec3_t n, float spread, vec3_t out ) {
+	vec3_t r;
+	float d;
+
+	r[0] = crandom(); r[1] = crandom(); r[2] = crandom();
+	VectorNormalize( r );
+	VectorMA( n, spread * random(), r, out );
+	VectorNormalize( out );
+	d = DotProduct( out, n );
+	if ( d < 0.05f ) {
+		VectorMA( out, 0.05f - d, n, out );
+		VectorNormalize( out );
+	}
+}
+
+// a direction within `degrees` of n (a cone, as Godot's particle spread)
+static void OzConeDir( const vec3_t n, float degrees, vec3_t out ) {
+	vec3_t right, up;
+	float a = DEG2RAD( degrees ) * random(), b = 2.0f * M_PI * random();
+
+	PerpendicularVector( right, n );
+	CrossProduct( n, right, up );
+	VectorScale( n, cos( a ), out );
+	VectorMA( out, sin( a ) * cos( b ), right, out );
+	VectorMA( out, sin( a ) * sin( b ), up, out );
+}
+
+static localEntity_t *OzParticle( const vec3_t at, const vec3_t vel, int lifeMs, float radius, float endRadius,
+		const vec4_t c0, const vec4_t c1, const vec4_t c2, qhandle_t shader, int flags ) {
+	localEntity_t *le = CG_AllocLocalEntity();
+
+	le->leType = LE_OZ_PARTICLE;
+	le->ozFlags = flags;
+	le->startTime = cg.time;
+	le->endTime = cg.time + lifeMs;
+	le->lifeRate = 1.0f / lifeMs;
+	le->pos.trType = TR_LINEAR;
+	le->pos.trTime = cg.time;
+	VectorCopy( at, le->pos.trBase );
+	VectorCopy( vel, le->pos.trDelta );
+	le->radius = radius;
+	le->ozRadius = endRadius;
+	Vector4Copy( c0, le->color );
+	Vector4Copy( c1, le->ozColor[0] );
+	Vector4Copy( c2, le->ozColor[1] );
+	le->ozGravity = GRAVITY;
+	le->refEntity.customShader = shader;
+	le->refEntity.rotation = random() * 360.0f;
+	return le;
+}
+
+// a quad from a to b turned to the view, s from s0 at a to s1 at b (the same: one column of the
+// image), colored rgbaA at a and rgbaB at b; right is half its width across
+static void OzQuad( const vec3_t a, const vec3_t b, const vec3_t right, float s0, float s1, qhandle_t shader,
+		const byte *rgbaA, const byte *rgbaB ) {
+	polyVert_t v[4];
+	int i;
+
+	VectorAdd( a, right, v[0].xyz ); v[0].st[0] = s0; v[0].st[1] = 0;
+	VectorSubtract( a, right, v[1].xyz ); v[1].st[0] = s0; v[1].st[1] = 1;
+	VectorSubtract( b, right, v[2].xyz ); v[2].st[0] = s1; v[2].st[1] = 1;
+	VectorAdd( b, right, v[3].xyz ); v[3].st[0] = s1; v[3].st[1] = 0;
+	for ( i = 0; i < 4; i++ ) {
+		const byte *rgba = i < 2 ? rgbaA : rgbaB;
+		v[i].modulate[0] = rgba[0]; v[i].modulate[1] = rgba[1];
+		v[i].modulate[2] = rgba[2]; v[i].modulate[3] = rgba[3];
+	}
+	trap_R_AddPolyToScene( shader, 4, v );
+}
+
+// the side vector of a quad from a along dir turned to the view, `width` across; qfalse seen end-on
+static qboolean OzBeamSide( const vec3_t a, const vec3_t dir, float width, vec3_t right ) {
+	vec3_t view;
+
+	VectorSubtract( a, cg.refdef.vieworg, view );
+	CrossProduct( dir, view, right );
+	if ( VectorNormalize( right ) == 0.0f ) {
+		return qfalse;
+	}
+	VectorScale( right, width * 0.5f, right );
+	return qtrue;
+}
+
+// a particle's streak: a flat quad from a to b turned to the view, the whole image along it
+static void OzStreakPoly( const vec3_t a, const vec3_t b, float width, qhandle_t shader, const byte *rgba ) {
+	vec3_t dir, right;
+
+	VectorSubtract( b, a, dir );
+	VectorNormalize( dir );
+	if ( OzBeamSide( a, dir, width, right ) ) {
+		OzQuad( a, b, right, 0.0f, 1.0f, shader, rgba, rgba );
+	}
+}
+
+#define BEAM_FADE_IN	32.0f		// units a lightning layer takes to come up from the gun (no hard edge at its start)
+#define BEAM_NEAR		0.23f		// view depth, in the layer's widths, where a beam layer is gone, and full from
+#define BEAM_NEAR_FULL	2.75f		// BEAM_NEAR_FULL on: the Godot build's near_fade (0.1 to 1.2 m) on the rail's halo
+#define BEAM_PIECES		4			// pieces the near fade is drawn in
+
+/*
+A glowing beam layer from a to b, `width` wide in rgba, added: a flat quad turned to the view, the
+image's middle column across it (its falloff), or with OZB_TILE the image repeating along it every
+256 units. It comes up from `a` over `fadeIn` units and fades out close to the eye, drawn in pieces
+with the fades in their corners' colors. A shooter's own rail runs about 6 units beside the eye, so
+its quad lies almost flat to the view: unfaded, the halo (14 units wide, spreading to 49) stood across
+the screen as a wedge, cut off in a hard line at the gun. The near fade scales with the width, as
+that wedge does: the halo comes up a meter or more out, the narrow white-hot core from the gun.
+*/
+static void OzBeamStrip( const vec3_t a, const vec3_t b, float width, qhandle_t shader, const byte *rgba, int flags,
+		float fadeIn ) {
+	float at[BEAM_PIECES + 4], fade[2], st[2], len, in, depth, slope, near0, near1, s, x;
+	vec3_t dir, view, right, p[2];
+	byte c[2][4];
+	int i, j, k, n = 0;
+
+	VectorSubtract( b, a, dir );
+	len = VectorNormalize( dir );
+	if ( len == 0.0f || width <= 0.0f || !OzBeamSide( a, dir, width, right ) ) {
+		return;
+	}
+	// where the fades bend, in order along the beam: the fade-in's end and the near fade's steps (the
+	// view depth runs straight along it)
+	in = MAX( 0.01f, MIN( fadeIn, len * 0.5f ) );
+	VectorSubtract( a, cg.refdef.vieworg, view );
+	depth = DotProduct( view, cg.refdef.viewaxis[0] );
+	slope = DotProduct( dir, cg.refdef.viewaxis[0] );
+	near0 = BEAM_NEAR * width;
+	near1 = BEAM_NEAR_FULL * width;
+	at[n++] = 0.0f;
+	at[n++] = in;
+	at[n++] = len;
+	for ( i = 0; i <= BEAM_PIECES && slope != 0.0f; i++ ) {
+		s = ( near0 + ( near1 - near0 ) * i / BEAM_PIECES - depth ) / slope;
+		if ( s > 0.0f && s < len ) {
+			at[n++] = s;
+		}
+	}
+	for ( i = 1; i < n; i++ ) {
+		for ( j = i; j > 0 && at[j - 1] > at[j]; j-- ) {
+			s = at[j]; at[j] = at[j - 1]; at[j - 1] = s;
+		}
+	}
+
+	for ( i = 0; i + 1 < n; i++ ) {
+		if ( at[i + 1] <= at[i] ) {
+			continue;
+		}
+		for ( j = 0; j < 2; j++ ) {
+			s = at[i + j];
+			x = Com_Clamp( 0.0f, 1.0f, ( depth + slope * s - near0 ) / ( near1 - near0 ) );
+			fade[j] = MIN( 1.0f, s / in ) * x * x * ( 3.0f - 2.0f * x );
+			for ( k = 0; k < 3; k++ ) {
+				c[j][k] = (byte)( rgba[k] * fade[j] );
+			}
+			c[j][3] = rgba[3];
+			st[j] = flags & OZB_TILE ? s / 256.0f : 0.5f;
+			VectorMA( a, s, dir, p[j] );
+		}
+		if ( fade[0] > 0.0f || fade[1] > 0.0f ) {
+			OzQuad( p[0], p[1], right, st[0], st[1], shader, c[0], c[1] );
+		}
+	}
+}
+
+static void OzColorBytes( const vec4_t c, qboolean add, float gain, byte *out ) {
+	float a = Com_Clamp( 0, 1, c[3] );
+	float k = add ? a * gain : 1.0f;
+	out[0] = (byte)( Com_Clamp( 0, 1, c[0] * k ) * 255 );
+	out[1] = (byte)( Com_Clamp( 0, 1, c[1] * k ) * 255 );
+	out[2] = (byte)( Com_Clamp( 0, 1, c[2] * k ) * 255 );
+	out[3] = add ? 255 : (byte)( a * 255 );
+}
+
+void CG_AddOzParticle( localEntity_t *le ) {
+	refEntity_t *re = &le->refEntity;
+	float dt = ( cg.time - le->pos.trTime ) * 0.001f, t, speed;
+	vec3_t from, to, tail;
+	vec4_t c;
+	byte rgba[4];
+	trace_t tr;
+
+	if ( dt > 0.0f ) {
+		// gravity, then the move, through the map when it bounces or sticks
+		VectorCopy( le->pos.trBase, from );
+		le->pos.trDelta[2] -= le->ozGravity * dt;
+		if ( le->ozDrag > 0.0f ) {
+			speed = VectorLength( le->pos.trDelta );
+			if ( speed > 0.0f ) {
+				VectorScale( le->pos.trDelta, MAX( 0.0f, speed - le->ozDrag * dt ) / speed, le->pos.trDelta );
+			}
+		}
+		VectorMA( from, dt, le->pos.trDelta, to );
+		if ( le->ozFlags & ( OZP_BOUNCE | OZP_STICK ) ) {
+			trap_CM_BoxTrace( &tr, from, to, vec3_origin, vec3_origin, 0, CONTENTS_SOLID );	// the world alone
+			if ( tr.startsolid ) {
+				CG_FreeLocalEntity( le );
+				return;
+			}
+			if ( tr.fraction < 1.0f ) {
+				float into;
+				if ( le->ozFlags & OZP_STICK ) {
+					CG_FreeLocalEntity( le );
+					return;
+				}
+				into = DotProduct( le->pos.trDelta, tr.plane.normal );
+				VectorMA( le->pos.trDelta, -into, tr.plane.normal, le->pos.trDelta );
+				VectorScale( le->pos.trDelta, SPARK_FRICTION, le->pos.trDelta );
+				VectorMA( le->pos.trDelta, -into * SPARK_BOUNCE, tr.plane.normal, le->pos.trDelta );
+				VectorMA( tr.endpos, 0.25f, tr.plane.normal, to );
+				if ( VectorLength( le->pos.trDelta ) < SPARK_MIN_SPEED ) {
+					CG_FreeLocalEntity( le );
+					return;
+				}
+			}
+		}
+		VectorCopy( to, le->pos.trBase );
+		le->pos.trTime = cg.time;
+	}
+
+	t = ( cg.time - le->startTime ) * le->lifeRate;
+	if ( t < 0.5f ) {
+		OzLerp4( t * 2.0f, le->color, le->ozColor[0], c );
+	} else {
+		OzLerp4( t * 2.0f - 1.0f, le->ozColor[0], le->ozColor[1], c );
+	}
+	OzColorBytes( c, ( le->ozFlags & OZP_ADD ) != 0, oz.gain, rgba );
+	if ( le->light > 0.0f && t < 1.0f ) {
+		// a flash's light, shrinking fast (by the square of the life left)
+		trap_R_AddLightToScene( le->pos.trBase, le->light * ( 1.0f - t ) * ( 1.0f - t ) * MAX( oz.gain, 0.1f ),
+			le->lightColor[0], le->lightColor[1], le->lightColor[2] );
+	}
+
+	if ( le->ozFlags & OZP_STREAK ) {
+		vec3_t along;
+		VectorScale( le->pos.trDelta, STREAK_TIME, along );
+		if ( VectorLength( along ) < le->radius ) {
+			if ( VectorNormalize( along ) == 0.0f ) {
+				VectorSet( along, 0, 0, 1 );
+			}
+			VectorScale( along, le->radius, along );
+		}
+		VectorSubtract( le->pos.trBase, along, tail );
+		OzStreakPoly( tail, le->pos.trBase, le->radius, re->customShader, rgba );
+		return;
+	}
+
+	re->reType = RT_SPRITE;
+	VectorCopy( le->pos.trBase, re->origin );
+	re->radius = le->radius + ( le->ozRadius - le->radius ) * t;
+	if ( !( le->ozFlags & OZP_ADD ) ) {
+		// a puff fades as the view comes within its width, and the view inside it leaves it out (as
+		// CG_AddScaleFade does): a blast's smoke rising through the eye never stands in front of it
+		float off = Distance( re->origin, cg.refdef.vieworg ) / re->radius - 1.0f;
+		if ( off <= 0.0f ) {
+			return;
+		}
+		if ( off < 1.0f ) {
+			rgba[3] = (byte)( rgba[3] * off );
+		}
+	}
+	re->shaderRGBA[0] = rgba[0]; re->shaderRGBA[1] = rgba[1];
+	re->shaderRGBA[2] = rgba[2]; re->shaderRGBA[3] = rgba[3];
+	re->shaderTime = le->startTime / 1000.0f;
+	trap_R_AddRefEntityToScene( re );
+}
+
+/*
+=================
+Glowing beams (LE_OZ_BEAM): a beam layer (OzBeamStrip) from re->origin to re->oldorigin,
+le->radius wide at the start and le->ozRadius at the end of its life, coming up from the gun over
+its width, its color fading as (1 - t), or (1 - t) ^ 1.5 when le->ozFade is above 1.
+=================
+*/
+void CG_AddOzBeam( localEntity_t *le ) {
+	refEntity_t *re = &le->refEntity;
+	float t = ( cg.time - le->startTime ) * le->lifeRate;
+	float fade = Com_Clamp( 0, 1, 1.0f - t );
+	float width = le->radius + ( le->ozRadius - le->radius ) * t;
+	vec4_t c;
+	byte rgba[4];
+
+	if ( le->ozFade > 1.0f ) {
+		fade *= sqrt( fade );		// (1 - t) ^ 1.5, for the glow beams' 1.3 and 1.6
+	}
+	VectorScale( le->color, fade, c );
+	c[3] = 1.0f;
+	OzColorBytes( c, qtrue, oz.gain, rgba );
+	OzBeamStrip( re->origin, re->oldorigin, width, re->customShader, rgba, le->ozFlags & OZB_TILE, width );
+}
+
+static void OzBeam( const vec3_t from, const vec3_t to, int lifeMs, float width, float endWidth, const vec3_t color,
+		float fadePow, qhandle_t shader, int flags ) {
+	localEntity_t *le = CG_AllocLocalEntity();
+
+	le->leType = LE_OZ_BEAM;
+	le->ozFlags = flags;
+	le->startTime = cg.time;
+	le->endTime = cg.time + lifeMs;
+	le->lifeRate = 1.0f / lifeMs;
+	VectorCopy( from, le->refEntity.origin );
+	VectorCopy( to, le->refEntity.oldorigin );
+	le->radius = width;
+	le->ozRadius = endWidth;
+	VectorCopy( color, le->color );
+	le->color[3] = 1.0f;
+	le->ozFade = fadePow;
+	le->refEntity.customShader = shader;
+}
+
+/*
+The remaster's glowing beam (fx_glow_beam.gdshader): a soft halo `width` wide in `color`, which
+widens by `spread` times over its life, and a white-hot core `core` of the width.
+*/
+static void OzGlowBeam( const vec3_t from, const vec3_t to, int lifeMs, float width, const vec3_t color,
+		float core, float coreGain, float haloGain, float spread, float fadePow ) {
+	vec3_t c, hot;
+
+	VectorScale( color, haloGain, c );
+	OzBeam( from, to, lifeMs, width, width * ( 1.0f + spread ), c, fadePow, ozMedia.glow, 0 );
+	VectorSet( hot, 1, 1, 1 );
+	OzLerp3( 0.65f, color, hot, hot );
+	VectorScale( hot, coreGain, hot );
+	OzBeam( from, to, lifeMs, width * core * 1.6f, width * core * 1.6f, hot, fadePow, ozMedia.glow, 0 );
+}
+
+/*
+=================
+CG_OzRailTrail
+
+The remaster's rail: CG_RailTrail draws id's core and spiral for the classic, glow and core
+styles (core leaves the spiral out) and calls this after; "glow" adds a halo in color1 that
+outlasts the core, "ql" is Quake Live's single thick beam instead of id's.
+=================
+*/
+void CG_OzRailTrail( clientInfo_t *ci, vec3_t start, vec3_t end ) {
+	float w = oz.railWidth;
+
+	if ( oz.railStyle == OZ_RAIL_GLOW ) {
+		OzGlowBeam( start, end, 1000, 14.0f * w, ci->color1, 0.22f, 1.0f, 0.55f, 2.5f, 1.3f );
+	} else if ( oz.railStyle == OZ_RAIL_QL ) {
+		OzGlowBeam( start, end, 700, 12.0f * w, ci->color1, 0.3f, 1.6f, 0.8f, 0.6f, 1.6f );
+	}
+}
+
+/*
+Rail trail "glow": id's core (CG_RailTrail's, fading as LE_FADE_RGB) drawn as a glowing beam layer
+in its own image (OZB_TILE), as wide as the renderer draws it (r_railCoreWidth each side). The
+renderer's core ends in a hard line at the gun, which shows as the gun kicks back from it.
+*/
+void CG_OzRailCore( localEntity_t *le ) {
+	char width[16];
+
+	if ( oz.railStyle != OZ_RAIL_GLOW ) {
+		return;
+	}
+	trap_Cvar_VariableStringBuffer( "r_railCoreWidth", width, sizeof( width ) );
+	le->leType = LE_OZ_BEAM;
+	le->ozFlags = OZB_TILE;
+	le->radius = le->ozRadius = 2.0f * ( width[0] ? atoi( width ) : 6 );
+	le->ozFade = 1.0f;
+}
+
+// one layer of a glowing beam, `width` wide in `color` times k, added
+static void OzBeamLayer( const vec3_t from, const vec3_t to, float width, qhandle_t shader, const vec3_t color, float k ) {
+	vec4_t c;
+	byte rgba[4];
+
+	VectorScale( color, k, c );
+	c[3] = 1.0f;
+	OzColorBytes( c, qtrue, oz.gain, rgba );
+	OzBeamStrip( from, to, width, shader, rgba, 0, BEAM_FADE_IN );
+}
+
+#define BOLT_WHITE		0.4f		// share of white in id's bolt drawn in Lightning color (its core is near white)
+
+// Lightning beam "glow" in another Lightning color: id's bolt as oz/fx/lightningBoltTint (OzTintBytes)
+static void OzBoltTint( refEntity_t *beam ) {
+	OzTintBytes( oz.lg[LG_GLOW], lgBlue[LG_GLOW], BOLT_WHITE, beam->shaderRGBA );
+	beam->customShader = ozMedia.lightningTint;
+}
+
+/*
+=================
+CG_OzLightningBeam
+
+Lightning beam, every frame the bolt draws (CG_LightningBolt): "classic" is id's bolt; "glow" is
+id's bolt brighter (oz/fx/lightningBolt, the oz renderer's) in a flickering blue halo three bolts
+wide around a white-hot core; "straight" (after Quake Live's straight beams) is a steady line in
+place of the bolt, a pale blue core in a deep blue glow, with no zigzag and no flicker. Where a glowing
+beam hits something, a flare and a light. Returns whether id's bolt draws.
+=================
+*/
+qboolean CG_OzLightningBeam( refEntity_t *beam, qboolean hit ) {
+	const float *blue = oz.lg[LG_GLOW], *hot = oz.lg[LG_HOT];	// in Lightning color's hue
+	const float *deep = oz.lg[LG_DEEP], *ice = oz.lg[LG_ICE];		// "straight"
+	const float *halo = blue;
+	float w = 8.0f * oz.lightningWidth, f = 1.0f;
+	vec3_t dir, at;
+	vec4_t c;
+	refEntity_t flare;
+
+	if ( oz.lightningStyle == OZ_LG_CLASSIC ) {
+		return qtrue;
+	}
+	if ( oz.lightningStyle == OZ_LG_GLOW ) {
+		f = 0.7f + 0.3f * OzFlicker( 1 );		// it flickers with the bolt
+		if ( oz.lgTint && ozMedia.lightningTint ) {
+			OzBoltTint( beam );
+		} else if ( ozMedia.lightningBolt ) {
+			beam->customShader = ozMedia.lightningBolt;
+		}
+		OzBeamLayer( beam->origin, beam->oldorigin, w * 3.0f, ozMedia.glow, blue, 0.8f * f );
+		OzBeamLayer( beam->origin, beam->oldorigin, w * 0.9f, ozMedia.beam, hot, 0.75f * f );
+	} else {
+		// blue through to the core: with a white-hot core the layers added up past white in every
+		// channel, a white line blooming into a white blob near the gun
+		halo = deep;
+		OzBeamLayer( beam->origin, beam->oldorigin, w * 1.8f, ozMedia.glow, deep, 0.4f );
+		OzBeamLayer( beam->origin, beam->oldorigin, w * 0.6f, ozMedia.beam, deep, 0.5f );
+		OzBeamLayer( beam->origin, beam->oldorigin, w * 0.22f, ozMedia.beam, ice, 0.5f );
+	}
+	if ( hit ) {
+		VectorSubtract( beam->oldorigin, beam->origin, dir );
+		VectorNormalize( dir );
+		VectorMA( beam->oldorigin, -4.0f, dir, at );
+		memset( &flare, 0, sizeof( flare ) );
+		flare.reType = RT_SPRITE;
+		flare.customShader = ozMedia.glow;
+		VectorCopy( at, flare.origin );
+		flare.radius = 22.0f * oz.lightningWidth * ( oz.lightningStyle == OZ_LG_GLOW ? 0.85f + 0.3f * OzFlicker( 2 ) : 1.0f );
+		flare.rotation = cg.time * 0.35f;
+		VectorScale( halo, 1.6f * f, c );
+		c[3] = 1.0f;
+		OzColorBytes( c, qtrue, oz.gain, flare.shaderRGBA );
+		trap_R_AddRefEntityToScene( &flare );
+		trap_R_AddLightToScene( at, 160.0f * f * MAX( oz.gain, 0.1f ), halo[0], halo[1], halo[2] );
+	}
+	return oz.lightningStyle != OZ_LG_STRAIGHT;
+}
+
+/*
+=================
+The lightning gun's burn lines (the Godot build's fx_burns.gd; id's beam left bullet holes): where
+the beam touches the map it melts a line that follows the beam as it sweeps, white-hot, cooling
+through orange and dull red to a dark scorch that fades away. Each shooter's beam draws one stroke:
+hits on the same surface stretch its last segment, and a turn or a jump starts the next segment
+where that one ends, so a sweep is one smooth line. A segment is projected onto the map as marks
+are (trap_CM_MarkFragments), so it wraps over steps and curves and goes with cg_marks 0; the next
+one keeps its projection until the surface has bent BURN_BEND from it, so their ends meet without
+a seam even where the beam hits a clip brush in front of the wall it draws on. Each vertex keeps
+when the beam was there, so the line cools from its far end. A stroke's two ends are round
+(gfx/oz/burn's half discs: its middle half is the line, the rest the ends).
+=================
+*/
+#define BURN_WIDTH			7.0f		// units
+#define BURN_SEGMENT		40.0f		// units before a stroke starts a new segment
+#define BURN_TURN			0.99f		// cosine: a sharper turn starts a new segment
+#define BURN_BEND			0.82f		// cosine: bent more from a segment's projection, the next is projected its way
+#define BURN_CURVE			0.9f		// cosine: bent more from one hit to the next (a corner), the stroke ends
+#define BURN_JUMP			96.0f		// units between hits that still join into one stroke
+#define BURN_PLANE			8.0f		// units off a segment's plane that still join it (a clip brush in front of the wall)
+#define BURN_GAP			150			// ms without a hit that ends a stroke
+#define BURN_LIFE			4000		// ms until it has faded out
+#define BURN_FADE			2400		// ms when the scorch starts to fade
+#define MAX_BURNS			96			// segments, the oldest go first
+#define MAX_BURN_POLYS		192			// fragments all of them keep, as MAX_MARK_POLYS
+#define BURN_POLYS			12			// fragments a segment keeps
+#define BURN_VERTS			96
+
+#define BURN_CAP_START		1			// a round end before a
+#define BURN_CAP_END		2			// and after b
+
+typedef struct {
+	int			id;						// 0 free; new each time it's used, so a stroke can tell it was taken
+	vec3_t		a, b, normal;
+	int			ta, tb;					// when the beam was at a and at b
+	int			caps;
+	int			numPolys, numVerts;
+	int			polyVerts[BURN_POLYS];
+	polyVert_t	verts[BURN_VERTS];
+	float		along[BURN_VERTS];		// 0 at a .. 1 at b: the vertex's time between ta and tb
+} ozBurn_t;
+
+static ozBurn_t	ozBurns[MAX_BURNS];
+static struct {
+	int			burn, id;				// the stroke's last segment (an id that changed: the stroke ended)
+	int			time;					// its last hit
+	vec3_t		normal;					// the surface's there
+} ozStrokes[MAX_CLIENTS];
+static int		ozBurnIds, ozBurnPolys, ozBurnTime;
+
+void CG_OzClearBurns( void ) {
+	memset( ozBurns, 0, sizeof( ozBurns ) );
+	memset( ozStrokes, 0, sizeof( ozStrokes ) );
+	ozBurnPolys = 0;
+	ozBurnTime = cg.time;
+}
+
+// whether the lightning gun burns lines, in place of id's bullet holes (CG_MissileHitWall)
+qboolean CG_OzBurns( void ) {
+	return oz.remade && ozMedia.burn && cg_addMarks.integer;
+}
+
+static void OzBurnFree( ozBurn_t *bn ) {
+	ozBurnPolys -= bn->numPolys;
+	bn->id = bn->numPolys = bn->numVerts = 0;
+}
+
+// a free segment, or the oldest but `keep`
+static ozBurn_t *OzBurnAlloc( const ozBurn_t *keep ) {
+	ozBurn_t *bn, *pick = NULL;
+	int i;
+
+	for ( i = 0, bn = ozBurns; i < MAX_BURNS; i++, bn++ ) {
+		if ( !bn->id ) {
+			pick = bn;
+			break;
+		}
+		if ( bn != keep && ( !pick || bn->tb < pick->tb ) ) {
+			pick = bn;
+		}
+	}
+	OzBurnFree( pick );
+	if ( ++ozBurnIds <= 0 ) {
+		ozBurnIds = 1;
+	}
+	pick->id = ozBurnIds;
+	return pick;
+}
+
+// one part of a segment onto the map, the strip from `from` to `to` (along dir) BURN_WIDTH wide:
+// the texture's s runs s0 .. s1 along it
+static void OzBurnProject( ozBurn_t *bn, const vec3_t from, const vec3_t to, const vec3_t dir, const vec3_t across,
+		float len, float s0, float s1 ) {
+	vec3_t corners[4], projection, points[BURN_VERTS], d;
+	markFragment_t frags[BURN_POLYS], *mf;
+	float hw = BURN_WIDTH * 0.5f, part = Distance( from, to );
+	int i, j, n;
+
+	// CG_ImpactMark's winding, seen from the surface: the fragments come back on the map
+	VectorMA( from, -hw, across, corners[0] );
+	VectorMA( from, hw, across, corners[1] );
+	VectorMA( to, hw, across, corners[2] );
+	VectorMA( to, -hw, across, corners[3] );
+	if ( bn->numPolys >= BURN_POLYS || bn->numVerts >= BURN_VERTS - 3 ) {
+		return;
+	}
+	VectorScale( bn->normal, -20, projection );
+	n = trap_CM_MarkFragments( 4, (void *)corners, projection, BURN_VERTS - bn->numVerts, points[0],
+		BURN_POLYS - bn->numPolys, frags );
+	for ( i = 0, mf = frags; i < n; i++, mf++ ) {
+		for ( j = 0; j < mf->numPoints; j++ ) {
+			polyVert_t *v = &bn->verts[bn->numVerts + j];
+			float u;
+
+			VectorCopy( points[mf->firstPoint + j], v->xyz );
+			VectorSubtract( v->xyz, from, d );
+			v->st[0] = part > 0.0f ? s0 + ( s1 - s0 ) * Com_Clamp( 0, 1, DotProduct( d, dir ) / part ) : s0;
+			v->st[1] = 0.5f + DotProduct( d, across ) / BURN_WIDTH;
+			VectorSubtract( v->xyz, bn->a, d );
+			u = DotProduct( d, dir );
+			bn->along[bn->numVerts + j] = len > 0.0f ? Com_Clamp( 0, 1, u / len ) : 1.0f;
+		}
+		bn->polyVerts[bn->numPolys++] = mf->numPoints;
+		bn->numVerts += mf->numPoints;
+		ozBurnPolys++;
+	}
+}
+
+// the segment's fragments again, after a, b or its ends changed
+static void OzBurnPlace( ozBurn_t *bn ) {
+	vec3_t dir, across, at;
+	float len, hw = BURN_WIDTH * 0.5f;
+
+	ozBurnPolys -= bn->numPolys;
+	bn->numPolys = bn->numVerts = 0;
+	VectorSubtract( bn->b, bn->a, dir );
+	VectorMA( dir, -DotProduct( dir, bn->normal ), bn->normal, dir );	// in the surface's plane
+	len = VectorNormalize( dir );
+	if ( len < 0.5f ) {
+		PerpendicularVector( dir, bn->normal );		// a spot: its two ends make a disc
+		len = 0.0f;
+	}
+	CrossProduct( bn->normal, dir, across );
+	if ( bn->caps & BURN_CAP_START ) {
+		VectorMA( bn->a, -hw, dir, at );
+		OzBurnProject( bn, at, bn->a, dir, across, len, 0.0f, 0.25f );
+	}
+	if ( len > 0.0f ) {
+		OzBurnProject( bn, bn->a, bn->b, dir, across, len, 0.5f, 0.5f );
+	}
+	if ( bn->caps & BURN_CAP_END ) {
+		VectorMA( bn->b, hw, dir, at );
+		OzBurnProject( bn, bn->b, at, dir, across, len, 0.75f, 1.0f );
+	}
+}
+
+/*
+=================
+CG_OzLightningBurn
+
+Every frame a lightning beam draws (CG_LightningBolt), where its trace stopped: the world takes
+the burn, anything else (a player, a mover, the sky) ends the shooter's stroke. A nomarks hit goes
+on: the projection leaves out the nomarks surfaces it draws on, and a clip brush (nodraw, nomarks)
+in front of a curved wall passes the line to the wall behind, as id's marks do.
+=================
+*/
+// the shooter's stroke ends at `bn` now; over MAX_BURN_POLYS the oldest segments go
+static void OzBurnStroke( int clientNum, ozBurn_t *bn ) {
+	ozBurn_t *oldest, *other;
+	int i;
+
+	ozStrokes[clientNum].burn = bn - ozBurns;
+	ozStrokes[clientNum].id = bn->id;
+	while ( ozBurnPolys > MAX_BURN_POLYS ) {
+		oldest = NULL;
+		for ( i = 0, other = ozBurns; i < MAX_BURNS; i++, other++ ) {
+			if ( other->id && other != bn && ( !oldest || other->tb < oldest->tb ) ) {
+				oldest = other;
+			}
+		}
+		if ( !oldest ) {
+			break;
+		}
+		OzBurnFree( oldest );
+	}
+}
+
+void CG_OzLightningBurn( int clientNum, const trace_t *tr ) {
+	ozBurn_t *bn = NULL, *next;
+	vec3_t d0, d1;
+	float jump, bend;
+
+	if ( clientNum < 0 || clientNum >= MAX_CLIENTS || !CG_OzBurns() ) {
+		return;
+	}
+	if ( tr->fraction >= 1.0f || tr->entityNum != ENTITYNUM_WORLD || ( tr->surfaceFlags & SURF_NOIMPACT ) ) {
+		ozStrokes[clientNum].id = 0;
+		return;
+	}
+	if ( ozStrokes[clientNum].id && ozBurns[ozStrokes[clientNum].burn].id == ozStrokes[clientNum].id &&
+			cg.time >= ozStrokes[clientNum].time && cg.time - ozStrokes[clientNum].time <= BURN_GAP ) {
+		bn = &ozBurns[ozStrokes[clientNum].burn];
+	}
+	ozStrokes[clientNum].time = cg.time;
+
+	// the stroke goes on along the surface it was on, bent at most 25 degrees since the last hit
+	// (a curve), and up or down a step only as far as BURN_PLANE and a curve would take it
+	if ( bn ) {
+		VectorSubtract( tr->endpos, bn->b, d1 );
+		jump = VectorLength( d1 );
+		bend = DotProduct( bn->normal, tr->plane.normal );
+		if ( DotProduct( ozStrokes[clientNum].normal, tr->plane.normal ) < BURN_CURVE || jump > BURN_JUMP ||
+				fabs( DotProduct( d1, bn->normal ) ) > BURN_PLANE + 0.25f * jump ) {
+			bn = NULL;
+		}
+	}
+	VectorCopy( tr->plane.normal, ozStrokes[clientNum].normal );
+	if ( !bn ) {
+		// a new stroke: a round spot where the beam landed
+		bn = OzBurnAlloc( NULL );
+		VectorCopy( tr->endpos, bn->a );
+		VectorCopy( tr->endpos, bn->b );
+		VectorCopy( tr->plane.normal, bn->normal );
+		bn->ta = bn->tb = cg.time;
+		bn->caps = BURN_CAP_START | BURN_CAP_END;
+		OzBurnPlace( bn );
+		OzBurnStroke( clientNum, bn );
+		return;
+	}
+	if ( jump < 0.5f ) {
+		// held still: it stays hot
+		if ( Distance( bn->a, bn->b ) < 0.5f ) {
+			bn->ta = cg.time;
+		}
+		bn->tb = cg.time;
+		return;
+	}
+	VectorSubtract( bn->b, bn->a, d0 );
+	VectorSubtract( tr->endpos, bn->a, d1 );
+	if ( VectorNormalize( d0 ) < 0.5f || ( VectorLength( d1 ) <= BURN_SEGMENT &&
+			DotProduct( d0, d1 ) >= BURN_TURN * VectorLength( d1 ) && bend >= BURN_BEND ) ) {
+		VectorCopy( tr->endpos, bn->b );		// the segment (or the spot) stretches to the hit
+		bn->tb = cg.time;
+		OzBurnPlace( bn );
+		OzBurnStroke( clientNum, bn );
+		return;
+	}
+	// the next segment, from where this one ends, projected as this one unless the surface bent
+	next = OzBurnAlloc( bn );
+	VectorCopy( bn->b, next->a );
+	next->ta = bn->tb;
+	VectorCopy( tr->endpos, next->b );
+	next->tb = cg.time;
+	if ( bend >= BURN_BEND ) {
+		VectorCopy( bn->normal, next->normal );
+	} else {
+		VectorCopy( tr->plane.normal, next->normal );
+	}
+	next->caps = BURN_CAP_END;
+	bn->caps &= ~BURN_CAP_END;
+	OzBurnPlace( bn );
+	OzBurnPlace( next );
+	OzBurnStroke( clientNum, next );
+}
+
+/*
+The line's color `age` ms after the beam was there: the glow (rgb, added, ozGlow on the oz renderer)
+from white-hot through orange and red to dull red and out, and under it the scorch (alpha) that
+darkens the wall, fading at the end.
+*/
+static void OzBurnColor( int age, byte *out ) {
+	static const struct { int ms; float c[3]; } heat[] = {
+		{ 0, { 1.0f, 0.95f, 0.82f } },		// white-hot
+		{ 150, { 1.0f, 0.86f, 0.5f } },	// yellow
+		{ 450, { 1.0f, 0.52f, 0.14f } },	// orange
+		{ 950, { 0.72f, 0.15f, 0.03f } },	// red
+		{ 1600, { 0.3f, 0.035f, 0.01f } },	// dull red
+		{ 2300, { 0.0f, 0.0f, 0.0f } },
+	};
+	float f, scorch;
+	vec3_t c;
+	int i;
+
+	i = 1;
+	while ( i < ARRAY_LEN( heat ) - 1 && age > heat[i].ms ) {
+		i++;
+	}
+	f = Com_Clamp( 0, 1, (float)( age - heat[i - 1].ms ) / ( heat[i].ms - heat[i - 1].ms ) );
+	OzLerp3( f, heat[i - 1].c, heat[i].c, c );
+	VectorScale( c, oz.gain, c );
+	out[0] = (byte)( Com_Clamp( 0, 1, c[0] ) * 255 );
+	out[1] = (byte)( Com_Clamp( 0, 1, c[1] ) * 255 );
+	out[2] = (byte)( Com_Clamp( 0, 1, c[2] ) * 255 );
+	f = Com_Clamp( 0, 1, (float)( age - BURN_FADE ) / ( BURN_LIFE - BURN_FADE ) );
+	scorch = 0.85f * ( 1.0f - f * f * ( 3.0f - 2.0f * f ) );
+	out[3] = (byte)( scorch * 255 );
+}
+
+/*
+=================
+CG_OzAddBurns
+
+Every frame, from CG_AddMarks (so not with cg_marks 0): the burn lines as they cool.
+=================
+*/
+void CG_OzAddBurns( void ) {
+	ozBurn_t *bn;
+	int i, j, k;
+
+	if ( cg.time < ozBurnTime ) {
+		CG_OzClearBurns();		// time went back: a demo seek, a restart
+	}
+	ozBurnTime = cg.time;
+	for ( i = 0, bn = ozBurns; i < MAX_BURNS; i++, bn++ ) {
+		if ( !bn->id ) {
+			continue;
+		}
+		if ( cg.time - bn->tb >= BURN_LIFE ) {
+			OzBurnFree( bn );
+			continue;
+		}
+		for ( j = 0; j < bn->numVerts; j++ ) {
+			OzBurnColor( cg.time - ( bn->ta + (int)( bn->along[j] * ( bn->tb - bn->ta ) ) ), bn->verts[j].modulate );
+		}
+		for ( j = k = 0; j < bn->numPolys; k += bn->polyVerts[j++] ) {
+			trap_R_AddPolyToScene( ozMedia.burn, bn->polyVerts[j], &bn->verts[k] );
+		}
+	}
+}
+
+/*
+=================
+Impacts
+=================
+*/
+#define OZS_STONE	0	// stone, concrete and the rest: dust and grit, fewer sparks
+#define OZS_METAL	1	// surfaceparm metalsteps: sparks
+#define OZS_NONE	2	// sky and no-impact surfaces: nothing
+
+// the surface under an impact, by the cgame's own trace a little into it
+static int OzSurface( const vec3_t origin, const vec3_t dir ) {
+	vec3_t from, to;
+	trace_t tr;
+
+	VectorMA( origin, 4.0f, dir, from );
+	VectorMA( origin, -8.0f, dir, to );
+	CG_Trace( &tr, from, NULL, NULL, to, ENTITYNUM_NONE, MASK_SOLID );
+	if ( tr.fraction == 1.0f ) {
+		return OZS_STONE;
+	}
+	if ( tr.surfaceFlags & ( SURF_SKY | SURF_NOIMPACT ) ) {
+		return OZS_NONE;
+	}
+	return ( tr.surfaceFlags & SURF_METALSTEPS ) ? OZS_METAL : OZS_STONE;
+}
+
+static void OzSparks( const vec3_t origin, const vec3_t dir, int count, float speed, float life, float spread ) {
+	static const vec4_t hot = { 1.0f, 0.85f, 0.55f, 1.0f }, mid = { 1.0f, 0.45f, 0.12f, 0.5f }, cold = { 0.6f, 0.1f, 0.03f, 0.0f };
+	vec3_t at, d, vel;
+	int i;
+
+	count = OzCount( count );
+	VectorMA( origin, 2.0f, dir, at );
+	for ( i = 0; i < count; i++ ) {
+		OzSprayDir( dir, spread, d );
+		VectorScale( d, speed * OzRand( 0.5f, 1.2f ), vel );
+		OzParticle( at, vel, (int)( life * OzRand( 0.6f, 1.4f ) * 1000 ), SPARK_WIDTH, SPARK_WIDTH, hot, mid, cold,
+			ozMedia.glow, OZP_ADD | OZP_STREAK | OZP_BOUNCE );
+	}
+}
+
+// glowing embers thrown off the surface and falling (Godot's _embers): speed in units/s
+static void OzEmbers( const vec3_t origin, const vec3_t dir, int count, float speedLo, float speedHi, float life,
+		const vec4_t c0, const vec4_t c1, const vec4_t c2 ) {
+	vec3_t d, vel;
+	localEntity_t *le;
+	int i;
+
+	count = OzCount( count );
+	for ( i = 0; i < count; i++ ) {
+		float r = OzRand( 0.8f, 1.9f );
+		OzConeDir( dir, 75.0f, d );
+		VectorScale( d, OzRand( speedLo, speedHi ), vel );
+		// streaks: their motion reads at speed, where a dot of the same size vanishes
+		le = OzParticle( origin, vel, (int)( life * OzRand( 0.7f, 1.0f ) * 1000 ), r, r * 0.5f, c0, c1, c2,
+			ozMedia.glow, OZP_ADD | OZP_BOUNCE | OZP_STREAK );
+		le->ozGravity = 288.0f;
+		le->ozDrag = OzRand( 16.0f, 64.0f );
+	}
+}
+
+/*
+A puff of dust off stone and grit thrown out of the hit: pale puffs swelling and settling, dark
+chips that bounce. `size` is the puffs' radius as they end.
+*/
+static void OzDust( const vec3_t origin, const vec3_t dir, int count, float size ) {
+	static const vec4_t d0 = { 0.62f, 0.57f, 0.5f, 0.0f }, d1 = { 0.55f, 0.51f, 0.45f, 0.55f }, d2 = { 0.5f, 0.47f, 0.42f, 0.0f };
+	static const vec4_t g0 = { 0.2f, 0.18f, 0.16f, 0.9f }, g1 = { 0.18f, 0.16f, 0.14f, 0.8f }, g2 = { 0.16f, 0.14f, 0.12f, 0.0f };
+	vec3_t d, vel, at;
+	localEntity_t *le;
+	int i, n;
+
+	VectorMA( origin, 2.0f, dir, at );
+	n = OzCount( count );
+	for ( i = 0; i < n; i++ ) {
+		OzConeDir( dir, 50.0f, d );
+		VectorScale( d, OzRand( 18.0f, 70.0f ), vel );
+		le = OzParticle( at, vel, (int)OzRand( 650.0f, 1100.0f ), size * 0.3f, size * OzRand( 0.8f, 1.2f ), d0, d1, d2, ozMedia.smoke, 0 );
+		le->ozGravity = 40.0f;		// dust settles
+		le->ozDrag = 60.0f;
+	}
+	n = OzCount( count * 2 );
+	for ( i = 0; i < n; i++ ) {
+		OzSprayDir( dir, 0.8f, d );
+		VectorScale( d, OzRand( 140.0f, 320.0f ), vel );
+		OzParticle( at, vel, (int)OzRand( 450.0f, 900.0f ), 0.7f, 0.7f, g0, g1, g2, ozMedia.smoke, OZP_STREAK | OZP_BOUNCE );
+	}
+}
