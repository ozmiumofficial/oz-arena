+/*
+A flare swelling from a third of `radius` and fading over `ms`, off the surface, and with `light`
+a light of that radius in its color fading with it (it lights the room for a moment).
+*/
+static void OzFlash( const vec3_t origin, const vec3_t dir, const vec3_t color, float radius, int ms, float light ) {
+	vec4_t c0, c2;
+	vec3_t at;
+	localEntity_t *le;
+
+	if ( oz.calm ) {
+		radius *= 0.6f;
+		light *= 0.4f;
+	}
+	VectorMA( origin, radius * 0.25f, dir, at );
+	VectorScale( color, oz.calm ? 0.6f : 1.2f, c0 ); c0[3] = 1.0f;
+	VectorCopy( c0, c2 ); c2[3] = 0.0f;
+	le = OzParticle( at, vec3_origin, ms, radius * 0.35f, radius, c0, c0, c2, ozMedia.glow, OZP_ADD );
+	le->ozGravity = 0.0f;
+	le->light = light;
+	VectorCopy( color, le->lightColor );
+}
