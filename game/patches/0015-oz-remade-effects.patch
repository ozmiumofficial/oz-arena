diff --git a/code/cgame/cg_oz_fx.c b/code/cgame/cg_oz_fx.c
new file mode 100644
--- /dev/null
+++ b/code/cgame/cg_oz_fx.c
@@ -0,0 +1,1740 @@
+/*
+===========================================================================
+Oz Arena: the remade effects (ENGINE_PLAN.md P3), after the Godot build's (scripts/fx/q3_fx.gd,
+fx_sparks.gd, fx_lightning_beam.gd and the client's trail tables). GPL-2.0, as the rest of cgame.
+
+cg_fxStyle 0 is id's effects as they were; 1 (the default) adds the remaster's on cgame's own
+timings, each with its Graphics setting (the oz_graphics_* cvars the engine makes from
+engine/ui/settings.json):
+  - impacts by surface: on metal hot sparks that bounce off the map, on stone a puff of dust and
+    grit with fewer sparks; with Explosions "enhanced", embers and rising smoke after rocket,
+    grenade and BFG blasts and a glow where energy shots hit
+  - muzzle flashes: a hot flare at the muzzle while id's flash shows, sparks and a wisp of smoke
+    from the machine gun and shotgun
+  - Heat shimmer: the air behind a rocket and over a blast bends the picture (oz renderer only:
+    scripts/oz_cgame.ozmtr's oz/fx/heat)
+  - Rail trail: classic, glow (a halo outlasting the core), ql (one thick glowing beam), core (no spiral)
+  - Lightning beam: classic, glow (id's bolt brighter in a flickering halo, a flare and a light
+    where it hits) or straight (a steady glowing line in place of the bolt); in any of them, a
+    burn line where the beam touches the map, in place of id's bullet holes
+  - Missile trails: classic, or enhanced (a burning core behind rockets and grenades, glowing
+    trails behind plasma and the BFG)
+  - Lightning color and Plasma color: the two guns' remade parts, made in blue, turn to the
+    color's hue (OzTint), for every player's shots, and id's bolt, plasma ball, ring and scorch
+    with them (OzTintBytes, the oz renderer's); Classic lightning keeps id's colors
+  - Blood: off, classic, heavy (a spray of droplets)
+  - Particles (low, medium, high) scales how many each effect throws; Effect intensity scales
+    the glowing ones and their lights.
+The plasma ball keeps id's sprite, so it still reads as a projectile. Gameplay > Spawn effects and
+Hit twitch, and Accessibility > Reduced flashing (no flares at the muzzle, dimmer flashes and their
+lights, no red blob on the screen when hit) are read here for cgame's code too, in any style.
+===========================================================================
+*/
+#include "cg_local.h"
+
+vmCvar_t	cg_fxStyle;
+static vmCvar_t	oz_railStyle, oz_railWidth, oz_lightningStyle, oz_lightningWidth;
+static vmCvar_t	oz_missileTrails, oz_explosions, oz_blood, oz_particles, oz_intensity, oz_hitSound;
+static vmCvar_t	oz_heatShimmer, oz_spawnEffect, oz_painTwitch, oz_reducedFlashing;
+static vmCvar_t	oz_lightningColor, oz_plasmaColor;
+
+static const struct {
+	vmCvar_t	*vmCvar;
+	char		*cvarName;
+	char		*defaultString;
+	int			cvarFlags;
+} ozCvars[] = {
+	{ &cg_fxStyle, "cg_fxStyle", "1", CVAR_ARCHIVE },
+	{ &oz_railStyle, "oz_graphics_rail_style", "glow", CVAR_ARCHIVE },
+	{ &oz_railWidth, "oz_graphics_rail_width", "1.0", CVAR_ARCHIVE },
+	{ &oz_lightningStyle, "oz_graphics_lightning_style", "glow", CVAR_ARCHIVE },
+	{ &oz_lightningWidth, "oz_graphics_lightning_width", "1.0", CVAR_ARCHIVE },
+	{ &oz_missileTrails, "oz_graphics_missile_trails", "enhanced", CVAR_ARCHIVE },
+	{ &oz_explosions, "oz_graphics_explosions", "enhanced", CVAR_ARCHIVE },
+	{ &oz_blood, "oz_graphics_blood", "classic", CVAR_ARCHIVE },
+	{ &oz_particles, "oz_graphics_particles", "high", CVAR_ARCHIVE },
+	{ &oz_intensity, "oz_graphics_effect_intensity", "1.0", CVAR_ARCHIVE },
+	{ &oz_hitSound, "oz_audio_hit_sound", "classic", CVAR_ARCHIVE },
+	{ &oz_heatShimmer, "oz_graphics_heat_shimmer", "1", CVAR_ARCHIVE },
+	{ &oz_spawnEffect, "oz_gameplay_spawn_effect", "1", CVAR_ARCHIVE },
+	{ &oz_painTwitch, "oz_gameplay_pain_twitch", "0", CVAR_ARCHIVE },
+	{ &oz_reducedFlashing, "oz_accessibility_reduced_flashing", "0", CVAR_ARCHIVE },
+	{ &oz_lightningColor, "oz_graphics_lightning_color", "#2e66ff", CVAR_ARCHIVE },
+	{ &oz_plasmaColor, "oz_graphics_plasma_color", "#5980ff", CVAR_ARCHIVE },
+};
+
+// Graphics > Lightning color and Plasma color: the guns' remade parts in the blues they were made in
+// (each setting's default is its first). The lightning gun's glow beam's halo and white-hot core, glow
+// where it hits, muzzle light (id's flashDlightColor), straight beam's deep glow and pale core, and dim
+// muzzle flare; the plasma gun's trail, glow where it hits, embers (hot, then fading), and muzzle flare
+// and light (id's flashDlightColor).
+enum { LG_GLOW, LG_HOT, LG_HIT, LG_FLASH, LG_DEEP, LG_ICE, LG_MUZZLE, LG_PARTS };
+enum { PG_TRAIL, PG_GLOW, PG_EMBER, PG_EMBER_OUT, PG_FLASH, PG_PARTS };
+static const vec3_t lgBlue[LG_PARTS] = { { 0.18f, 0.4f, 1.0f }, { 0.8f, 0.9f, 1.0f }, { 0.6f, 0.75f, 1.0f }, { 0.6f, 0.6f, 1.0f },
+	{ 0.1f, 0.28f, 1.0f }, { 0.3f, 0.55f, 1.0f }, { 0.08f, 0.22f, 0.6f } };
+static const vec3_t pgBlue[PG_PARTS] = { { 0.35f, 0.5f, 1.0f }, { 0.45f, 0.6f, 1.0f }, { 0.9f, 0.95f, 1.0f }, { 0.1f, 0.15f, 0.6f },
+	{ 0.6f, 0.6f, 1.0f } };
+
+// the settings as numbers, read again when a cvar changes
+static struct {
