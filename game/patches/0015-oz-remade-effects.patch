+void CG_OzFxUpdateCvars( void ) {
+	static const char *rails[] = { "classic", "glow", "ql", "core" };
+	static const char *lightnings[] = { "classic", "glow", "straight" };
+	static const char *bloods[] = { "off", "classic", "heavy" };
+	static const char *amounts[] = { "low", "medium", "high" };
+	static const char *hits[] = { "off", "classic", "pitch" };
+	static const float amountShare[] = { 0.35f, 0.65f, 1.0f };
+	int i, sum = 0;
+
+	for ( i = 0; i < ARRAY_LEN( ozCvars ); i++ ) {
+		trap_Cvar_Update( ozCvars[i].vmCvar );
+		sum += ozCvars[i].vmCvar->modificationCount;
+	}
+	if ( sum == oz.modCount ) {
+		return;
+	}
+	oz.modCount = sum;
+	oz.remade = cg_fxStyle.integer != 0;
+	oz.railStyle = oz.remade ? OzPick( oz_railStyle.string, rails, 4, OZ_RAIL_GLOW ) : OZ_RAIL_CLASSIC;
+	oz.railWidth = Com_Clamp( 0.25f, 4.0f, oz_railWidth.value );
+	oz.lightningStyle = oz.remade ? OzPick( oz_lightningStyle.string, lightnings, 3, OZ_LG_GLOW ) : OZ_LG_CLASSIC;
+	oz.lightningWidth = Com_Clamp( 0.25f, 4.0f, oz_lightningWidth.value );
+	oz.trails = oz.remade && !Q_stricmp( oz_missileTrails.string, "enhanced" );
+	oz.explosions = oz.remade && !Q_stricmp( oz_explosions.string, "enhanced" );
+	oz.blood = OzPick( oz_blood.string, bloods, 3, 1 );
+	if ( !oz.remade && oz.blood == 2 ) {
+		oz.blood = 1;
+	}
+	oz.amount = amountShare[OzPick( oz_particles.string, amounts, 3, 2 )];
+	oz.gain = Com_Clamp( 0.0f, 2.0f, oz_intensity.value );
+	oz.hitSound = OzPick( oz_hitSound.string, hits, 3, 1 );
+	oz.heat = oz.remade && oz_heatShimmer.integer;
+	oz.spawnEffect = oz_spawnEffect.integer;
+	oz.painTwitch = oz_painTwitch.integer;
+	oz.calm = oz_reducedFlashing.integer;
+	oz.lgTint = OzColorSetting( oz_lightningColor.string, 0x2e66ff, lgBlue, LG_PARTS, oz.lightningStyle != OZ_LG_CLASSIC, oz.lg );
+	oz.pgTint = OzColorSetting( oz_plasmaColor.string, 0x5980ff, pgBlue, PG_PARTS, oz.remade, oz.pg );
+}
