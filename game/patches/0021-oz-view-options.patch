+/*
+===============
+CG_OzViewCvars
+
+Oz: Gameplay > View bob and Damage view kick (engine/ui/settings.json). Oz's own cvars: cg_bobup is
+cheat-protected, and the damage kick has none.
+===============
+*/
+static vmCvar_t	oz_gameplay_view_bob, oz_gameplay_damage_kick;
+static qboolean	ozViewCvars;
+
+static void CG_OzViewCvars( void ) {
+	if ( !ozViewCvars ) {
+		trap_Cvar_Register( &oz_gameplay_view_bob, "oz_gameplay_view_bob", "1", CVAR_ARCHIVE );
+		trap_Cvar_Register( &oz_gameplay_damage_kick, "oz_gameplay_damage_kick", "0", CVAR_ARCHIVE );
+		ozViewCvars = qtrue;
+	}
+	trap_Cvar_Update( &oz_gameplay_view_bob );
+	trap_Cvar_Update( &oz_gameplay_damage_kick );
+}
+
