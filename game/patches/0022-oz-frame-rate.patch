 	int			predictedErrorTime;
 	vec3_t		predictedError;
 
+	qboolean	ozStepShift;			// Oz: predictedPlayerState.origin is drawn between two fixed steps,
+	vec3_t		ozStepTrue;				// and this is where the prediction has it (CG_PredictPlayerState)
+	playerState_t	ozStepFrom, ozStepTo;	// the last fixed step the prediction ran: its start and end
+
 	int			eventSequence;
 	int			predictableEvents[MAX_PREDICTED_EVENTS];
 
