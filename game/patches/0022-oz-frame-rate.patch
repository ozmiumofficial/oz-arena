diff --git a/code/cgame/cg_predict.c b/code/cgame/cg_predict.c
--- a/code/cgame/cg_predict.c
+++ b/code/cgame/cg_predict.c
@@ -415,9 +415,17 @@
 	qboolean	moved;
 	usercmd_t	oldestCmd;
 	usercmd_t	latestCmd;
+	playerState_t	stepFrom;
+	vec3_t		stepBack;
 
 	cg.hyperspace = qfalse;	// will be set if touching a trigger_teleport
 
+	// Oz: the last frame drew the player between two fixed steps: predict from where it really was
+	if ( cg.ozStepShift ) {
+		VectorCopy( cg.ozStepTrue, cg.predictedPlayerState.origin );
+		cg.ozStepShift = qfalse;
+	}
+
 	// if this is the first frame we must guarantee
 	// predictedPlayerState is valid even if there is some
 	// other error condition
@@ -498,6 +506,8 @@
 
 	cg_pmove.pmove_fixed = pmove_fixed.integer;// | cg_pmove_fixed.integer;
 	cg_pmove.pmove_msec = pmove_msec.integer;
+	stepFrom = cg.predictedPlayerState;
+	cg_pmove.stepFrom = &stepFrom;
 
 	// run cmds
 	moved = qfalse;
@@ -592,14 +602,47 @@
 		//CG_CheckChangedPredictableEvents(&cg.predictedPlayerState);
 	}
 
+	cg_pmove.stepFrom = NULL;
+
 	if ( cg_showmiss.integer > 1 ) {
 		CG_Printf( "[%i : %i] ", cg_pmove.cmd.serverTime, cg.time );
 	}
 
+	// Oz: under pmove_fixed the player moves in whole steps of pmove_msec, the last one up to a step
+	// ahead of the latest command; it's drawn where it is at that command's time, between the last
+	// step's start and end, so the view moves every frame as it did without fixed steps. The step is
+	// kept: a snapshot that already reached its end runs no step here, and is drawn between the same
+	// two. On the ground the height isn't eased (a stair step eases on its own, EV_STEP), nor across
+	// a teleport.
+	if ( moved && stepFrom.commandTime < cg.predictedPlayerState.commandTime ) {
+		cg.ozStepFrom = stepFrom;
+		cg.ozStepTo = cg.predictedPlayerState;
+	}
+	VectorClear( stepBack );
+	if ( cg_pmove.pmove_fixed && cg.ozStepTo.commandTime == cg.predictedPlayerState.commandTime
+			&& cg.ozStepFrom.commandTime < cg.ozStepTo.commandTime && latestCmd.serverTime < cg.ozStepTo.commandTime
+			&& cg.ozStepFrom.pm_type == cg.predictedPlayerState.pm_type
+			&& !( ( cg.ozStepFrom.eFlags ^ cg.predictedPlayerState.eFlags ) & EF_TELEPORT_BIT ) ) {
+		float	f = (float)( cg.ozStepTo.commandTime - latestCmd.serverTime ) / ( cg.ozStepTo.commandTime - cg.ozStepFrom.commandTime );
+		VectorSubtract( cg.ozStepFrom.origin, cg.ozStepTo.origin, stepBack );
+		if ( cg.ozStepFrom.groundEntityNum != ENTITYNUM_NONE && cg.predictedPlayerState.groundEntityNum != ENTITYNUM_NONE ) {
+			stepBack[2] = 0;
+		}
+		if ( VectorLength( stepBack ) > 64 ) {
+			VectorClear( stepBack );
+		}
+		VectorScale( stepBack, f > 1 ? 1 : f, stepBack );
+	}
+
 	if ( !moved ) {
 		if ( cg_showmiss.integer ) {
 			CG_Printf( "not moved\n" );
 		}
+		if ( !VectorCompare( stepBack, vec3_origin ) ) {
+			VectorCopy( cg.predictedPlayerState.origin, cg.ozStepTrue );
+			VectorAdd( cg.predictedPlayerState.origin, stepBack, cg.predictedPlayerState.origin );
+			cg.ozStepShift = qtrue;
+		}
 		return;
 	}
 
@@ -623,6 +666,12 @@
 			cg.eventSequence = cg.predictedPlayerState.eventSequence;
 		}
 	}
+
+	if ( !VectorCompare( stepBack, vec3_origin ) ) {
+		VectorCopy( cg.predictedPlayerState.origin, cg.ozStepTrue );
+		VectorAdd( cg.predictedPlayerState.origin, stepBack, cg.predictedPlayerState.origin );
+		cg.ozStepShift = qtrue;
+	}
 }
 
 
