 */
 void Pmove (pmove_t *pmove) {
 	int			finalTime;
+	usercmd_t	cmd;
 
 	finalTime = pmove->cmd.serverTime;
 
@@ -2047,14 +2048,17 @@
 
 	// chop the move up if it is too long, to prevent framerate
 	// dependent behavior
+	cmd = pmove->cmd;
 	while ( pmove->ps->commandTime != finalTime ) {
 		int		msec;
 
 		msec = finalTime - pmove->ps->commandTime;
 
 		if ( pmove->pmove_fixed ) {
-			if ( msec > pmove->pmove_msec ) {
-				msec = pmove->pmove_msec;
+			// Oz: each step ends on pmove_msec's grid (a spawn starts off it, at level.time - 100), so the
+			// short one is first and the same steps run at every frame rate
+			if ( msec > pmove->pmove_msec - pmove->ps->commandTime % pmove->pmove_msec ) {
+				msec = pmove->pmove_msec - pmove->ps->commandTime % pmove->pmove_msec;
 			}
 		}
 		else {
@@ -2063,9 +2067,17 @@
 			}
 		}
 		pmove->cmd.serverTime = pmove->ps->commandTime + msec;
+		if ( pmove->stepFrom ) {
+			*pmove->stepFrom = *pmove->ps;	// Oz: where this step starts (the cgame draws between steps)
+		}
 		PmoveSingle( pmove );
 
-		if ( pmove->ps->pm_flags & PMF_JUMP_HELD ) {
+		if ( pmove->pmove_fixed ) {
+			// Oz: each fixed step runs the command as it was sent, as one frame at 1000 / pmove_msec fps
+			// would (a step changes upmove: a held jump read again as a new press, or 20 below)
+			cmd.serverTime = pmove->cmd.serverTime;
+			pmove->cmd = cmd;
+		} else if ( pmove->ps->pm_flags & PMF_JUMP_HELD ) {
 			pmove->cmd.upmove = 20;
 		}
 	}
