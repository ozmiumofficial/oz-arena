+/*
+=================
+CG_OldestCmd
+
+Oz: the oldest command the engine still has, and its number. The prediction needs every command since the
+snapshot's; with only 64 kept, at 1000 fps behind 80 ms of round trip and a 20 Hz server's frame the
+snapshot's was older than all of them, and the view stood still ("exceeded PACKET_BACKUP on commands").
+Oz's engine keeps CMD_BACKUP (512); Quake3e and ioquake3 (Oz's own servers send them this code) keep 64,
+and don't fill in a command they no longer have.
+=================
+*/
+int CG_OldestCmd( int current, usercmd_t *cmd ) {
+	int		keep;
+
+	for ( keep = CMD_BACKUP; keep > 64; keep /= 2 ) {
+		if ( trap_GetUserCmd( current - keep + 1, cmd ) ) {
+			return current - keep + 1;
+		}
+	}
+	trap_GetUserCmd( current - 63, cmd );
+	return current - 63;
+}
 
 
