+		s->client = 0;
+	}
+}
+
+static void CG_OzParseMoreScores( void ) {
+	const int	first = atoi( CG_Argv( 1 ) );
+	int			n = atoi( CG_Argv( 2 ) ), i;
+
+	if ( first <= 0 || first >= MAX_CLIENTS || n < 0 ) {
+		return;
+	}
+	if ( first != ozMoreTo || ozMoreTo == 0 ) {
+		ozMoreFrom = ozMoreTo = first;		// the first part of a new list
+	}
+	if ( first + n > MAX_CLIENTS ) {
+		n = MAX_CLIENTS - first;
+	}
+	for ( i = 0; i < n; i++ ) {
+		CG_OzParseScore( i * 14 + 3, &ozMoreScores[first + i], &ozMorePowerups[first + i] );
+	}
+	ozMoreTo = first + n;
+}
