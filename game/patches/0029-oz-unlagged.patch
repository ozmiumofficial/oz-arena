+or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with Unlagged source code; if not, write to the Free Software
+Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+===========================================================================
+*/
+//
+// cg_unlagged.c -- Unlagged 2.01's client side (Neil "haste" Toronto), fitted to Oz's cgame
+//
+// Oz: what's kept and what changed (game patch 0029)
+//	- Attack prediction: on a server that compensates (g_delagHitscan in its serverinfo, g_unlagged.c), the
+//	  player's own railgun, shotgun and machine gun shots are drawn as he fires them, from his predicted place
+//	  and view, where the server traces them; the server's events for them are dropped (CG_UnlaggedPredicted).
+//	  The spread's seed is the command's time, the one the server takes (Unlagged read cg.oldTime, which is the
+//	  same time). Not while following someone, in a demo or without prediction: the view isn't the player's
+//	  own prediction then, so the server's events draw the shots. The lightning gun is game patch 0023's.
+//	- cg_projectileNudge draws the others' missiles that many ms ahead, so a high ping sees them nearer where
+//	  the server has them; the player's own aren't moved (Unlagged moved them a server frame ahead to make up
+//	  for its missile pass, which g_unlagged.c leaves out).
+//	- Left out: Unlagged's lag simulation, its optimized prediction (Oz's prediction is game patches 0022,
+//	  0025 and 0027), its early transitioning and timenudge extrapolation, the bounding boxes and the debug
+//	  prints.
+//
+#include "cg_local.h"
+
+vmCvar_t	cg_delag;
+vmCvar_t	cg_cmdTimeNudge;
+vmCvar_t	cg_projectileNudge;
+vmCvar_t	cg_debugDelag;
+
+// g_weapon.c's
+#define MACHINEGUN_SPREAD	200
+
+/*
+=================
+CG_UnlaggedServer
+
+The server's g_delagHitscan: "" when it isn't an Unlagged server
+=================
+*/
+static const char *CG_UnlaggedServer( void ) {
+	return Info_ValueForKey( CG_ConfigString( CS_SERVERINFO ), "g_delagHitscan" );
+}
+
+/*
+=================
+CG_UnlaggedOn
+
+Whether this player's shots with the weapon of this cg_delag bit are drawn as he fires them
+=================
+*/
+static qboolean CG_UnlaggedOn( int bit ) {
+	if ( !( cg_delag.integer & ( 1 | bit ) ) ) {
+		return qfalse;
+	}
+	if ( cg.demoPlayback || cg_nopredict.integer || cg_synchronousClients.integer ) {
+		return qfalse;
+	}
+	if ( !cg.snap || ( cg.snap->ps.pm_flags & PMF_FOLLOW ) ) {
+		return qfalse;
+	}
+	return atoi( CG_UnlaggedServer() ) != 0;
+}
+
+/*
+=================
+CG_UnlaggedRail
+
+Oz: the player's own rail is drawn as he fires on every server, Unlagged's or not (Ozmium, 2026-11-10): the
+trail is a straight line from his muzzle to the first wall, the same whoever traces it, and every game's rail
+event names its shooter as id's does. cg_delag 0 turns it off with the rest
+=================
+*/
+static qboolean CG_UnlaggedRail( void ) {
+	if ( !( cg_delag.integer & ( 1 | 16 ) ) ) {
+		return qfalse;
+	}
+	if ( cg.demoPlayback || cg_nopredict.integer || cg_synchronousClients.integer ) {
+		return qfalse;
+	}
+	return cg.snap && !( cg.snap->ps.pm_flags & PMF_FOLLOW );
+}
+
+/*
+=================
+CG_UnlaggedFor
+
+Whether this shooter's shots with this weapon are drawn as he fires them
+=================
+*/
+static qboolean CG_UnlaggedFor( int shooter, int weapon ) {
+	if ( shooter != cg.predictedPlayerState.clientNum ) {
+		return qfalse;
+	}
+	switch ( weapon ) {
+	case WP_MACHINEGUN:
+		return CG_UnlaggedOn( 2 );
+	case WP_SHOTGUN:
+		return CG_UnlaggedOn( 4 );
+	case WP_RAILGUN:
+		// Oz: on every server. Bullets and pellets only on Unlagged's: how another game seeds their spread
+		// isn't known
+		return CG_UnlaggedRail();
+	default:
+		return qfalse;
+	}
+}
+
+/*
+=================
+CG_UnlaggedPredicted
+
+Whether a shot event was drawn as its shooter fired it, so CG_EntityEvent drops it. cg_debugDelag 1 prints
+the event, "delag: server <weapon> <seed> <x> <y> <z>" (where the shot ended, or where the shotgun fired
+from, with its seed), as CG_PredictWeaponEffects prints what it drew ("delag: drawn ...";
+engine/tests/unlagged_test.py compares them)
+=================
+*/
+qboolean CG_UnlaggedPredicted( const entityState_t *es, int shooter, int weapon ) {
+	if ( !CG_UnlaggedFor( shooter, weapon ) ) {
+		return qfalse;
+	}
+	if ( cg_debugDelag.integer ) {
+		CG_Printf( "delag: server %d %d %.0f %.0f %.0f\n", weapon, weapon == WP_SHOTGUN ? es->eventParm : -1,
+			es->pos.trBase[0], es->pos.trBase[1], es->pos.trBase[2] );
+	}
+	return qtrue;
+}
+
+// cg_debugDelag's line for a shot drawn as it was fired
+static void CG_DebugDrawn( int weapon, int seed, const vec3_t at ) {
+	if ( cg_debugDelag.integer ) {
+		CG_Printf( "delag: drawn %d %d %.0f %.0f %.0f\n", weapon, seed, at[0], at[1], at[2] );
+	}
+}
+
+/*
+=================
+SnapVectorTowards
+
+Round a vector to integers for more efficient network transmission, but make sure that it rounds towards
+a given point rather than blindly truncating. This prevents it from truncating into a wall. (g_weapon.c's)
+=================
+*/
+static void SnapVectorTowards( vec3_t v, vec3_t to ) {
+	int		i;
+
+	for ( i = 0 ; i < 3 ; i++ ) {
+		if ( to[i] <= v[i] ) {
+			v[i] = floor( v[i] );
+		} else {
+			v[i] = ceil( v[i] );
+		}
+	}
+}
+
+/*
+=======================
+CG_PredictWeaponEffects
+
+Draws predicted effects for the railgun, shotgun, and machinegun, as the server's game makes them
+(CG_FireWeapon)
+=======================
+*/
+void CG_PredictWeaponEffects( centity_t *cent ) {
+	const int		self = cg.predictedPlayerState.clientNum;
+	const int		weapon = cent->currentState.weapon;
+	vec3_t			muzzle, forward, right, up, end, dir;
+	trace_t			tr;
+	usercmd_t		cmd;
+	int				seed;
+
+	// if the client isn't us, forget it
+	if ( cent->currentState.number != self || !CG_UnlaggedFor( self, weapon ) ) {
+		return;
+	}
+
+	// the server's muzzle point (CalcMuzzlePointOrigin) and the seed it takes for the spread: the command's time
+	VectorCopy( cg.predictedPlayerState.origin, muzzle );
+	SnapVector( muzzle );
+	muzzle[2] += cg.predictedPlayerState.viewheight;
+	AngleVectors( cg.predictedPlayerState.viewangles, forward, right, up );
+	VectorMA( muzzle, 14, forward, muzzle );
+	SnapVector( muzzle );
+	trap_GetUserCmd( trap_GetCurrentCmdNumber(), &cmd );
+	seed = cmd.serverTime & 255;
+
+	if ( weapon == WP_RAILGUN ) {
+		vec3_t	start;
+
+		// trace only against the solids, so the railgun goes through people
+		VectorMA( muzzle, 8192, forward, end );
+		CG_Trace( &tr, muzzle, vec3_origin, vec3_origin, end, self, CONTENTS_SOLID );
+		SnapVectorTowards( tr.endpos, muzzle );
+
+		// move the start a bit to come closer to the drawn gun muzzle, as the server and EV_RAILTRAIL do
+		VectorMA( muzzle, 4, right, start );
+		VectorMA( start, -1, up, start );
+		if ( !cg.renderingThirdPerson ) {
+			if ( cg_drawGun.integer == 2 ) {
+				VectorMA( start, 8, cg.refdef.viewaxis[1], start );
+			} else if ( cg_drawGun.integer == 3 ) {
+				VectorMA( start, 4, cg.refdef.viewaxis[1], start );
+			}
+		}
+		CG_RailTrail( &cgs.clientinfo[self], start, tr.endpos );
+		CG_DebugDrawn( weapon, -1, tr.endpos );
+
+		// no explosion at the end if SURF_NOIMPACT
+		if ( !( tr.surfaceFlags & SURF_NOIMPACT ) ) {
+			ByteToDir( DirToByte( tr.plane.normal ), dir );
+			CG_MissileHitWall( WP_RAILGUN, self, tr.endpos, dir, IMPACTSOUND_DEFAULT );
+		}
+	} else if ( weapon == WP_SHOTGUN ) {
+		entityState_t	es;
+
+		// the server's EV_SHOTGUN
+		memset( &es, 0, sizeof( es ) );
+		VectorCopy( muzzle, es.pos.trBase );
+		VectorScale( forward, 4096, es.origin2 );
+		SnapVector( es.origin2 );
+		es.eventParm = seed;
+		es.otherEntityNum = self;
+		CG_ShotgunFire( &es );
+		CG_DebugDrawn( weapon, seed, muzzle );
+	} else if ( weapon == WP_MACHINEGUN ) {
+		float	r, u;
+
+		// do everything exactly like the server does (Bullet_Fire)
+		r = Q_random( &seed ) * M_PI * 2.0f;
+		u = sin( r ) * Q_crandom( &seed ) * MACHINEGUN_SPREAD * 16;
+		r = cos( r ) * Q_crandom( &seed ) * MACHINEGUN_SPREAD * 16;
+		VectorMA( muzzle, 8192 * 16, forward, end );
+		VectorMA( end, r, right, end );
+		VectorMA( end, u, up, end );
+
+		CG_Trace( &tr, muzzle, NULL, NULL, end, self, MASK_SHOT );
+		if ( tr.surfaceFlags & SURF_NOIMPACT ) {
+			return;
+		}
+
+		// snap the endpos to integers, but nudged towards the line
+		SnapVectorTowards( tr.endpos, muzzle );
+		CG_DebugDrawn( weapon, -1, tr.endpos );
+
+		if ( tr.entityNum < MAX_CLIENTS ) {
+			CG_Bullet( tr.endpos, self, tr.plane.normal, qtrue, tr.entityNum );
+		} else {
+			ByteToDir( DirToByte( tr.plane.normal ), dir );
+			CG_Bullet( tr.endpos, self, dir, qfalse, ENTITYNUM_WORLD );
+		}
+	}
+}
+
+/*
+=======================
+CG_ProjectileNudge
+
+The others' missiles drawn cg_projectileNudge ms ahead, never through a wall (CG_CalcEntityLerpPositions)
+=======================
+*/
+void CG_ProjectileNudge( centity_t *cent ) {
+	const entityState_t	*s = &cent->currentState;
+	vec3_t				ahead;
+	trace_t				tr;
+
+	if ( cg_projectileNudge.integer <= 0 || s->eType != ET_MISSILE ) {
+		return;
+	}
+	// not a grapple, nor a bouncing grenade, nor one of the player's own (only an Unlagged server says whose)
+	if ( s->weapon == WP_GRAPPLING_HOOK || s->weapon == WP_GRENADE_LAUNCHER || !*CG_UnlaggedServer()
+			|| s->otherEntityNum == cg.predictedPlayerState.clientNum ) {
+		return;
+	}
+
+	BG_EvaluateTrajectory( &s->pos, cg.time + cg_projectileNudge.integer, ahead );
+	CG_Trace( &tr, cent->lerpOrigin, vec3_origin, vec3_origin, ahead, s->number, MASK_SHOT );
+	VectorCopy( tr.endpos, cent->lerpOrigin );
+}
