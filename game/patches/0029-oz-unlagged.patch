+//
+// g_unlagged.c -- Unlagged 2.01's lag compensation (Neil "haste" Toronto), fitted to Oz's game
+//
+// Oz: what's kept and what changed (game patch 0029)
+//	- Backward reconciliation: an instant-hit shot (machine gun, shotgun, lightning gun, railgun, and in Oz the
+//	  gauntlet too) is traced against every other player where the shooter saw him, at the shooter's command
+//	  time. g_delagHitscan 0 turns all of it off (Unlagged still took 50 ms off every shot then); a player's
+//	  cg_delag 0 keeps just those 50 ms.
+//	- Missiles run as in id's game. Unlagged ran them after the rest of the frame with the players shifted to
+//	  the last frame's time, but that time is always the newest in the history, which the shift leaves alone:
+//	  it moved no one.
+//	- The history is kept by time, 64 server frames (Unlagged kept 17, about 850 ms at sv_fps 20), and a shot
+//	  is never taken back further than g_delagMax ms, so a very high ping can't hit someone long since behind a
+//	  wall.
+//	- Skip correction: a player whose commands miss server frames is moved on along his path, up to two
+//	  frames, so the others don't see him stop and jump; the history keeps that place too, so shots at him
+//	  match what was drawn. The cgame's own extrapolation (g_smoothClients' TR_LINEAR_STOP) is off then.
+//	- Each player's state lives here, so g_local.h's structures are untouched and his options (cg_delag,
+//	  cg_cmdTimeNudge) survive a respawn. A client whose userinfo lacks cg_delag gets the full compensation.
+//	- Left out: Unlagged's lag simulation (Oz tests behind a relay), true ping, the grapple and the debug
+//	  prints.
+//
+#include "g_local.h"
+
+#define NUM_CLIENT_HISTORY	64
+
+// everything we need to know to backward reconcile
+typedef struct {
+	vec3_t		mins, maxs;
+	vec3_t		currentOrigin;
+	int			leveltime;
+} clientHistory_t;
+
+static struct {
+	int				delag;				// cg_delag: 0 off, 1 every instant-hit weapon, or 2 machine gun, 4 shotgun,
+										// 8 lightning gun, 16 railgun
+	int				cmdTimeNudge;		// cg_cmdTimeNudge: ms less compensation
+	int				attackTime;			// the command's time, before pmove_fixed rounds it: when the shooter saw
+										// what he shot at
+	int				frameOffset;		// ms into the server frame the command came
+	int				lastUpdateFrame;	// the server frame the last command came in
+	int				historyHead;
+	clientHistory_t	history[NUM_CLIENT_HISTORY];
+	clientHistory_t	saved;				// where he was before a time shift
+} ul[MAX_CLIENTS];
+
+static int	frameStartTime;		// trap_Milliseconds() as this server frame began
+
+
+/*
+============
+G_UnlaggedUserinfo
+
+A player's options, from his userinfo (ClientUserinfoChanged)
+============
+*/
+void G_UnlaggedUserinfo( gentity_t *ent, const char *userinfo ) {
+	const int	n = ent - g_entities;
+	const char	*s;
+
+	if ( n < 0 || n >= MAX_CLIENTS ) {
+		return;
+	}
+	s = Info_ValueForKey( userinfo, "cg_delag" );
+	ul[n].delag = *s ? atoi( s ) : 1;
+	// negative values would let people shoot others *long* after they had left the area, on purpose
+	ul[n].cmdTimeNudge = Com_Clamp( 0, 999, atoi( Info_ValueForKey( userinfo, "cg_cmdTimeNudge" ) ) );
+}
+
+
+/*
+============
+G_UnlaggedClientThink
+
+Each command a player sends, before pmove_fixed rounds its time (ClientThink_real)
+============
+*/
+void G_UnlaggedClientThink( gentity_t *ent, int serverTime ) {
+	const int n = ent - g_entities;
+
+	// frameOffset should be about the number of milliseconds into a frame this command packet was received,
+	// depending on how fast the server does a G_RunFrame()
+	ul[n].frameOffset = trap_Milliseconds() - frameStartTime;
+	// attackTime will be used for backward reconciliation later (time shift)
+	ul[n].attackTime = serverTime;
+	// keep track of this for later - we'll use this to decide whether or not to extrapolate this client
+	ul[n].lastUpdateFrame = level.framenum;
+}
+
+
+/*
+============
+G_AttackSeed
+
+A shot's spread, from something the client knows in advance (its command's time), so it can draw the same
+============
+*/
+int G_AttackSeed( gentity_t *ent ) {
+	return ul[ent - g_entities].attackTime & 255;
+}
+
+
+/*
+============
+G_ResetHistory
+
+Clear out the given client's history (should be called when the teleport bit is flipped)
+============
+*/
+void G_ResetHistory( gentity_t *ent ) {
+	const int	n = ent - g_entities;
+	const int	step = level.time > level.previousTime ? level.time - level.previousTime : 50;	// Oz: any sv_fps
+	int			i, time;
+
+	// fill up the history with data (assume the current position)
+	ul[n].historyHead = NUM_CLIENT_HISTORY - 1;
+	for ( i = ul[n].historyHead, time = level.time; i >= 0; i--, time -= step ) {
+		VectorCopy( ent->r.mins, ul[n].history[i].mins );
+		VectorCopy( ent->r.maxs, ul[n].history[i].maxs );
+		VectorCopy( ent->r.currentOrigin, ul[n].history[i].currentOrigin );
+		ul[n].history[i].leveltime = time;
+	}
+	// and this is as good a time as any to clear the saved state
+	ul[n].saved.leveltime = 0;
+}
+
+
+/*
+============
+G_StoreHistory
+
+Keep track of where the client's been
+============
+*/
+static void G_StoreHistory( gentity_t *ent ) {
+	const int	n = ent - g_entities;
+	int			head;
+
+	ul[n].historyHead++;
+	if ( ul[n].historyHead >= NUM_CLIENT_HISTORY ) {
+		ul[n].historyHead = 0;
+	}
+
+	head = ul[n].historyHead;
+
+	// store all the collision-detection info and the time
+	VectorCopy( ent->r.mins, ul[n].history[head].mins );
+	VectorCopy( ent->r.maxs, ul[n].history[head].maxs );
+	VectorCopy( ent->s.pos.trBase, ul[n].history[head].currentOrigin );
+	SnapVector( ul[n].history[head].currentOrigin );
+	ul[n].history[head].leveltime = level.time;
+}
+
+
+/*
+=============
+TimeShiftLerp
+
+Used below to interpolate between two previous vectors
+Returns a vector "frac" times the distance between "start" and "end"
+=============
+*/
+static void TimeShiftLerp( float frac, vec3_t start, vec3_t end, vec3_t result ) {
+	// From CG_InterpolateEntityPosition in cg_ents.c: making these exactly the same should avoid
+	// floating-point error
+	result[0] = start[0] + frac * ( end[0] - start[0] );
+	result[1] = start[1] + frac * ( end[1] - start[1] );
+	result[2] = start[2] + frac * ( end[2] - start[2] );
+}
+
+
+/*
+=================
+G_TimeShiftClient
+
+Move a client back to where he was at the specified "time"
+=================
+*/
+static void G_TimeShiftClient( gentity_t *ent, int time ) {
+	const int	n = ent - g_entities;
+	int			j, k;
+
+	// find two entries in the history whose times sandwich "time"
+	// assumes no two adjacent records have the same timestamp
+	j = k = ul[n].historyHead;
+	do {
+		if ( ul[n].history[j].leveltime <= time ) {
+			break;
+		}
+
+		k = j;
+		j--;
+		if ( j < 0 ) {
+			j = NUM_CLIENT_HISTORY - 1;
+		}
+	}
+	while ( j != ul[n].historyHead );
+
+	// if we got past the first iteration above, we've sandwiched (or wrapped)
+	if ( j != k ) {
+		// make sure it doesn't get re-saved
+		if ( ul[n].saved.leveltime != level.time ) {
+			// save the current origin and bounding box
+			VectorCopy( ent->r.mins, ul[n].saved.mins );
+			VectorCopy( ent->r.maxs, ul[n].saved.maxs );
+			VectorCopy( ent->r.currentOrigin, ul[n].saved.currentOrigin );
+			ul[n].saved.leveltime = level.time;
+		}
+
+		// if we haven't wrapped back to the head, we've sandwiched, so
+		// we shift the client's position back to where he was at "time"
+		if ( j != ul[n].historyHead ) {
+			float	frac = (float)( time - ul[n].history[j].leveltime ) /
+				(float)( ul[n].history[k].leveltime - ul[n].history[j].leveltime );
+
+			// interpolate between the two origins to give position at time index "time"
+			TimeShiftLerp( frac, ul[n].history[j].currentOrigin, ul[n].history[k].currentOrigin, ent->r.currentOrigin );
+
+			// lerp these too, just for fun (and ducking)
+			TimeShiftLerp( frac, ul[n].history[j].mins, ul[n].history[k].mins, ent->r.mins );
+			TimeShiftLerp( frac, ul[n].history[j].maxs, ul[n].history[k].maxs, ent->r.maxs );
+		} else {
+			// we wrapped, so grab the earliest
+			VectorCopy( ul[n].history[k].currentOrigin, ent->r.currentOrigin );
+			VectorCopy( ul[n].history[k].mins, ent->r.mins );
+			VectorCopy( ul[n].history[k].maxs, ent->r.maxs );
+		}
+
+		// this will recalculate absmin and absmax
+		trap_LinkEntity( ent );
+	}
+	// else the time is later than his newest record (a negative timenudge): he stays
+}
+
+
+/*
+=====================
+G_TimeShiftAllClients
+
+Move ALL clients back to where they were at the specified "time", except for "skip"
+=====================
+*/
+static void G_TimeShiftAllClients( int time, gentity_t *skip ) {
+	gentity_t	*ent;
+	int			i;
+
+	for ( i = 0, ent = g_entities; i < level.maxclients; i++, ent++ ) {
+		if ( ent->client && ent->inuse && ent->client->sess.sessionTeam < TEAM_SPECTATOR && ent != skip ) {
+			G_TimeShiftClient( ent, time );
+		}
+	}
+}
+
+
+/*
+================
+G_DoTimeShiftFor
+
+Decide what time to shift everyone back to, and do it
+================
+*/
+void G_DoTimeShiftFor( gentity_t *ent ) {
+	// Oz: the instant-hit weapons, and the cg_delag bit for each (the gauntlet goes with 1, every weapon)
+	static const qboolean	instant[WP_NUM_WEAPONS] = { qfalse, qtrue, qtrue, qtrue, qfalse, qfalse, qtrue, qtrue };
+	static const int		wpflags[WP_NUM_WEAPONS] = { 0, 0, 2, 4, 0, 0, 8, 16 };
+	int						n, flag, time;
+
+	// don't time shift for mistakes or bots, nor when it's off, nor for a missile
+	if ( !ent->inuse || !ent->client || ( ent->r.svFlags & SVF_BOT ) || !g_delagHitscan.integer ) {
+		return;
+	}
+	if ( ent->client->ps.weapon <= WP_NONE || ent->client->ps.weapon >= WP_NUM_WEAPONS || !instant[ent->client->ps.weapon] ) {
+		return;
+	}
+	n = ent - g_entities;
+	flag = wpflags[ent->client->ps.weapon];
+
+	// if the client wants it, or wants it for this weapon
+	if ( ( ul[n].delag & 1 ) || ( ul[n].delag & flag ) ) {
+		// do the full lag compensation, except what the client nudges
+		time = ul[n].attackTime + ul[n].cmdTimeNudge;
+		// Oz: no further back than g_delagMax
+		if ( time < level.time - g_delagMax.integer ) {
+			time = level.time - g_delagMax.integer;
+		}
+	} else {
+		// do just 50ms
+		time = level.previousTime + ul[n].frameOffset;
+	}
+
+	G_TimeShiftAllClients( time, ent );
+}
+
+
+/*
+===================
+G_UnTimeShiftClient
+
+Move a client back to where he was before the time shift
+===================
+*/
+void G_UnTimeShiftClient( gentity_t *ent ) {
+	const int n = ent - g_entities;
+
+	// if it was saved
+	if ( n >= 0 && n < MAX_CLIENTS && ul[n].saved.leveltime == level.time ) {
+		// move it back
+		VectorCopy( ul[n].saved.mins, ent->r.mins );
+		VectorCopy( ul[n].saved.maxs, ent->r.maxs );
+		VectorCopy( ul[n].saved.currentOrigin, ent->r.currentOrigin );
+		ul[n].saved.leveltime = 0;
+
+		// this will recalculate absmin and absmax
+		trap_LinkEntity( ent );
+	}
+}
+
+
+/*
+=======================
+G_UnTimeShiftAllClients
+
+Move ALL the clients back to where they were before the time shift, except for "skip"
+=======================
+*/
+static void G_UnTimeShiftAllClients( gentity_t *skip ) {
+	gentity_t	*ent;
+	int			i;
+
+	for ( i = 0, ent = g_entities; i < level.maxclients; i++, ent++ ) {
+		if ( ent->client && ent->inuse && ent->client->sess.sessionTeam < TEAM_SPECTATOR && ent != skip ) {
+			G_UnTimeShiftClient( ent );
+		}
+	}
+}
+
+
+/*
+==================
+G_UndoTimeShiftFor
+
+Put everyone except for this client back where they were
+==================
+*/
+void G_UndoTimeShiftFor( gentity_t *ent ) {
+	// don't un-time shift for mistakes or bots
+	if ( !ent->inuse || !ent->client || ( ent->r.svFlags & SVF_BOT ) ) {
+		return;
+	}
+
+	G_UnTimeShiftAllClients( ent );
+}
+
+
+/*
+=====================
+G_UnlaggedFrameStart
+
+Record the time at the start of this frame (G_RunFrame)
+=====================
+*/
+void G_UnlaggedFrameStart( void ) {
+	frameStartTime = trap_Milliseconds();
+}
+
+
+/*
+===========================
+G_PredictPlayerClipVelocity
+
+Slide on the impacting surface
+===========================
+*/
+
+#define	OVERCLIP		1.001f
+
+static void G_PredictPlayerClipVelocity( vec3_t in, vec3_t normal, vec3_t out ) {
+	float	backoff;
+
+	// find the magnitude of the vector "in" along "normal"
+	backoff = DotProduct (in, normal);
+
+	// tilt the plane a bit to avoid floating-point error issues
+	if ( backoff < 0 ) {
+		backoff *= OVERCLIP;
+	} else {
+		backoff /= OVERCLIP;
+	}
+
+	// slide along
+	VectorMA( in, -backoff, normal, out );
+}
+
+
+/*
+========================
+G_PredictPlayerSlideMove
+
+Advance the given entity frametime seconds, sliding as appropriate
+========================
+*/
+#define	MAX_CLIP_PLANES	5
+
+static qboolean G_PredictPlayerSlideMove( gentity_t *ent, float frametime ) {
+	int			bumpcount, numbumps;
+	vec3_t		dir;
+	float		d;
+	int			numplanes;
+	vec3_t		planes[MAX_CLIP_PLANES];
+	vec3_t		primal_velocity, velocity, origin;
+	vec3_t		clipVelocity;
+	int			i, j, k;
+	trace_t	trace;
+	vec3_t		end;
+	float		time_left;
+	float		into;
+	vec3_t		endVelocity;
+	vec3_t		endClipVelocity;
+
+	numbumps = 4;
+
+	VectorCopy( ent->s.pos.trDelta, primal_velocity );
+	VectorCopy( primal_velocity, velocity );
+	VectorCopy( ent->s.pos.trBase, origin );
+
+	VectorCopy( velocity, endVelocity );
+
+	time_left = frametime;
+
+	numplanes = 0;
+
+	for ( bumpcount = 0; bumpcount < numbumps; bumpcount++ ) {
+
+		// calculate position we are trying to move to
+		VectorMA( origin, time_left, velocity, end );
+
+		// see if we can make it there
+		trap_Trace( &trace, origin, ent->r.mins, ent->r.maxs, end, ent->s.number, ent->clipmask );
+
+		if (trace.allsolid) {
+			// entity is completely trapped in another solid
+			VectorClear( velocity );
+			VectorCopy( origin, ent->s.pos.trBase );
+			return qtrue;
+		}
+
+		if (trace.fraction > 0) {
+			// actually covered some distance
+			VectorCopy( trace.endpos, origin );
+		}
+
+		if (trace.fraction == 1) {
+			break;		// moved the entire distance
+		}
+
+		time_left -= time_left * trace.fraction;
+
+		if ( numplanes >= MAX_CLIP_PLANES ) {
+			// this shouldn't really happen
+			VectorClear( velocity );
+			VectorCopy( origin, ent->s.pos.trBase );
+			return qtrue;
+		}
+
+		//
+		// if this is the same plane we hit before, nudge velocity
+		// out along it, which fixes some epsilon issues with
+		// non-axial planes
+		//
+		for ( i = 0; i < numplanes; i++ ) {
+			if ( DotProduct( trace.plane.normal, planes[i] ) > 0.99 ) {
+				VectorAdd( trace.plane.normal, velocity, velocity );
+				break;
+			}
+		}
+
+		if ( i < numplanes ) {
+			continue;
+		}
+
+		VectorCopy( trace.plane.normal, planes[numplanes] );
+		numplanes++;
+
+		//
+		// modify velocity so it parallels all of the clip planes
+		//
+
+		// find a plane that it enters
+		for ( i = 0; i < numplanes; i++ ) {
+			into = DotProduct( velocity, planes[i] );
+			if ( into >= 0.1 ) {
+				continue;		// move doesn't interact with the plane
+			}
+
+			// slide along the plane
+			G_PredictPlayerClipVelocity( velocity, planes[i], clipVelocity );
+
+			// slide along the plane
+			G_PredictPlayerClipVelocity( endVelocity, planes[i], endClipVelocity );
+
+			// see if there is a second plane that the new move enters
+			for ( j = 0; j < numplanes; j++ ) {
+				if ( j == i ) {
+					continue;
+				}
+
+				if ( DotProduct( clipVelocity, planes[j] ) >= 0.1 ) {
+					continue;		// move doesn't interact with the plane
+				}
+
+				// try clipping the move to the plane
+				G_PredictPlayerClipVelocity( clipVelocity, planes[j], clipVelocity );
+				G_PredictPlayerClipVelocity( endClipVelocity, planes[j], endClipVelocity );
+
+				// see if it goes back into the first clip plane
+				if ( DotProduct( clipVelocity, planes[i] ) >= 0 ) {
+					continue;
+				}
+
+				// slide the original velocity along the crease
+				CrossProduct( planes[i], planes[j], dir );
+				VectorNormalize( dir );
+				d = DotProduct( dir, velocity );
+				VectorScale( dir, d, clipVelocity );
+
+				CrossProduct( planes[i], planes[j], dir );
+				VectorNormalize( dir );
+				d = DotProduct( dir, endVelocity );
+				VectorScale( dir, d, endClipVelocity );
+
+				// see if there is a third plane the the new move enters
+				for ( k = 0; k < numplanes; k++ ) {
+					if ( k == i || k == j ) {
+						continue;
+					}
+
+					if ( DotProduct( clipVelocity, planes[k] ) >= 0.1 ) {
+						continue;		// move doesn't interact with the plane
+					}
+
+					// stop dead at a tripple plane interaction
+					VectorClear( velocity );
+					VectorCopy( origin, ent->s.pos.trBase );
+					return qtrue;
+				}
+			}
+
+			// if we have fixed all interactions, try another move
+			VectorCopy( clipVelocity, velocity );
+			VectorCopy( endClipVelocity, endVelocity );
+			break;
+		}
+	}
+
+	VectorCopy( endVelocity, velocity );
+	VectorCopy( origin, ent->s.pos.trBase );
+
+	return (bumpcount != 0);
+}
+
+
+/*
+============================
+G_PredictPlayerStepSlideMove
+
+Advance the given entity frametime seconds, stepping and sliding as appropriate
+============================
+*/
+#define	STEPSIZE 18
+
+static void G_PredictPlayerStepSlideMove( gentity_t *ent, float frametime ) {
+	vec3_t start_o, start_v;
+	vec3_t down, up;
+	trace_t trace;
+	float stepSize;
+
+	VectorCopy (ent->s.pos.trBase, start_o);
+	VectorCopy (ent->s.pos.trDelta, start_v);
+
+	if ( !G_PredictPlayerSlideMove( ent, frametime ) ) {
+		// not clipped, so forget stepping
+		return;
+	}
+
+	VectorCopy (start_o, up);
+	up[2] += STEPSIZE;
+
+	// test the player position if they were a stepheight higher
+	trap_Trace( &trace, start_o, ent->r.mins, ent->r.maxs, up, ent->s.number, ent->clipmask );
+	if ( trace.allsolid ) {
+		return;		// can't step up
+	}
+
+	stepSize = trace.endpos[2] - start_o[2];
+
+	// try slidemove from this position
+	VectorCopy( trace.endpos, ent->s.pos.trBase );
+	VectorCopy( start_v, ent->s.pos.trDelta );
+
+	G_PredictPlayerSlideMove( ent, frametime );
+
+	// push down the final amount
+	VectorCopy( ent->s.pos.trBase, down );
+	down[2] -= stepSize;
+	trap_Trace( &trace, ent->s.pos.trBase, ent->r.mins, ent->r.maxs, down, ent->s.number, ent->clipmask );
+	if ( !trace.allsolid ) {
+		VectorCopy( trace.endpos, ent->s.pos.trBase );
+	}
+	if ( trace.fraction < 1.0 ) {
+		G_PredictPlayerClipVelocity( ent->s.pos.trDelta, trace.plane.normal, ent->s.pos.trDelta );
+	}
+}
+
+
+/*
+=====================
+G_UnlaggedClientEndFrame
+
+After the player's entity state is set each server frame (ClientEndFrame): skip correction, then the history
+=====================
+*/
+void G_UnlaggedClientEndFrame( gentity_t *ent ) {
+	const int	n = ent - g_entities;
+	int			frames;
+
+	if ( g_delagHitscan.integer && g_smoothClients.integer ) {
+		// see how many frames the client has missed, and don't extrapolate more than two
+		frames = level.framenum - ul[n].lastUpdateFrame - 1;
+		if ( frames > 2 ) {
+			frames = 2;
+		}
+
+		// did the client miss any frames? then move him along his path that far
+		if ( frames > 0 ) {
+			G_PredictPlayerStepSlideMove( ent, frames * ( level.time - level.previousTime ) * 0.001f );
+			// save network bandwidth
+			SnapVector( ent->s.pos.trBase );
+		}
+	}
+
+	// store the client's position for backward reconciliation later
+	G_StoreHistory( ent );
+}
diff --git a/code/cgame/cg_unlagged.c b/code/cgame/cg_unlagged.c
new file mode 100644
--- /dev/null
+++ b/code/cgame/cg_unlagged.c
@@ -0,0 +1,294 @@
+/*
