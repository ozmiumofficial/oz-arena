 extern char *eventnames[];
 
 /*
-==============
+==================
+CG_OzEventBase
+
+Oz: the prediction starts from the snapshot's state: the events before its eventSequence are the
+server's, those after it the prediction's
+==================
+*/
+void CG_OzEventBase( void ) {
+	cg.ozPredictBaseSeq = cg.ozTimedSeq = cg.predictedPlayerState.eventSequence;
+	cg.ozPredictBaseTime = cg.predictedPlayerState.commandTime;
+}
+
+/*
+==================
+CG_OzEventTimes
+
+Oz: after each command the prediction ran, the command time of the events it added
+==================
+*/
+void CG_OzEventTimes( void ) {
+	for ( ; cg.ozTimedSeq < cg.predictedPlayerState.eventSequence; cg.ozTimedSeq++ ) {
+		cg.ozEventTime[cg.ozTimedSeq & ( OZ_EVENT_TIMES - 1 )] = cg.predictedPlayerState.commandTime;
+	}
+}
+
+/*
+==================
+CG_OzFindPlayed
+
+Oz: the oldest predicted event played of this kind run between from and to, or NULL; one the server's
+snapshot has had already only if confirmed is qtrue
+==================
+*/
+static ozPlayedEvent_t *CG_OzFindPlayed( int event, int parm, int from, int to, qboolean confirmed ) {
+	ozPlayedEvent_t	*p, *best;
+	int				i;
+
+	best = NULL;
+	for ( i = 0, p = cg.ozPlayed ; i < OZ_PLAYED_EVENTS ; i++, p++ ) {
+		if ( p->event == event && p->parm == parm && p->time >= from && p->time <= to
+				&& ( confirmed || !p->confirmed ) && ( !best || p->time < best->time ) ) {
+			best = p;
+		}
+	}
+	return best;
+}
+
+/*
+==================
+CG_OzEventPlayed
+
+Oz: whether the predicted state's event seq, which id's code would play (new, or changed from the last
+frame's), is one the player's own prediction played already. id's numbered the server's events and the
+predicted ones in one sequence and played any slot whose event changed, so wherever the server's game
+had one event more or less than the prediction, or one a step earlier or later, every event after it
+moved a slot and played again: the jump and the shot heard twice on community servers whose game moves
+the player a little differently (A51's: a prediction miss at most landings), and a pickup at 1000 fps
+(game patch 0026). Each predicted event is kept with the command time it ran at: one of the server's
+plays only if no predicted event of its kind and parm from about that time played, and one the
+prediction runs again plays only if it didn't run at about that time before.
+
+play: qfalse for a slot id's code wouldn't play, which is only accounted for
+==================
+*/
+static qboolean CG_OzEventOnce( void ) {
+	static vmCvar_t	once;
+	static qboolean	registered;
+
+	if ( !registered ) {
+		trap_Cvar_Register( &once, "cg_ozEventOnce", "1", 0 );	// 0: id's way, for comparing
+		registered = qtrue;
+	}
+	trap_Cvar_Update( &once );
+	return once.integer != 0;
+}
+
+#define OZ_EVENT_SLACK		30		// ms either way: the same event a step or two off (the guns refire 50 ms on)
+#define OZ_EVENT_LATE		250		// ms the server's snapshot can be past one of its events
+
+static qboolean CG_OzEventPlayed( int seq, int event, int parm, qboolean play ) {
+	ozPlayedEvent_t	*p;
+	int				time;
+
+	event &= ~EV_EVENT_BITS;
+	if ( !event ) {
+		return qfalse;
+	}
+	if ( seq < cg.ozPredictBaseSeq ) {
+		// the server's: the first time it shows, take the oldest unconfirmed one played of its kind
+		if ( seq < cg.ozServerSeq && seq >= cg.ozServerSeq - OZ_EVENT_TIMES ) {
+			return play && CG_OzFindPlayed( event, parm, cg.ozPredictBaseTime - OZ_EVENT_LATE,
+				cg.ozPredictBaseTime + OZ_EVENT_SLACK, qtrue ) != NULL;
+		}
+		cg.ozServerSeq = seq + 1;
+		p = CG_OzFindPlayed( event, parm, cg.ozPredictBaseTime - OZ_EVENT_LATE, cg.ozPredictBaseTime + OZ_EVENT_SLACK, qfalse );
+		if ( p ) {
+			p->confirmed = qtrue;
+			return qtrue;
+		}
+		return qfalse;
+	}
+
+	// the prediction's
+	time = cg.ozEventTime[seq & ( OZ_EVENT_TIMES - 1 )];
+	if ( !play ) {
+		return qfalse;
+	}
+	if ( CG_OzFindPlayed( event, parm, time - OZ_EVENT_SLACK, time + OZ_EVENT_SLACK, qtrue ) ) {
+		return qtrue;
+	}
+	p = &cg.ozPlayed[cg.ozPlayedNext++ & ( OZ_PLAYED_EVENTS - 1 )];
+	p->event = event;
+	p->parm = parm;
+	p->time = time;
+	p->confirmed = qfalse;
+	return qfalse;
+}
