+// the ping the scoreboard shows: the true ping (g_truePing 1), else the engine's
+int G_RealPing( gentity_t *ent ) {
+	const int n = ent - g_entities;
+	if ( !ent->client || n < 0 || n >= MAX_CLIENTS ) {
+		return 0;
+	}
+	if ( !g_truePing.integer || !ul[n].pingSampleCount || ( ent->r.svFlags & SVF_BOT ) ) {
+		return ent->client->ps.ping;
+	}
+	return ul[n].realPing;
 }
 
 
