+/*
+==============================================================================
+
+Oz: Ratmod's predicted missiles (ratmod.github.io, rdntcntrl/ratoa_gamecode cg_unlagged.c, GPL-2.0)
+
+On a server that delags projectiles (g_delagMissiles, g_predictMissiles: game patch 0031's g_missile.c), the
+player's own plasma, grenades, rockets and BFG shots are drawn from the moment he fires, where the server will
+have them (they start at his command's time there too), until the server's own missile comes in a snapshot and
+takes over (CG_RemovePredictedMissile, matched by weapon and launch time). Explosions are predicted too
+(cg_predictExplosions): the player's own missile hitting a wall shows its explosion at once, and the server's
+event for it is then dropped (CG_ExplosionPredicted); one predicted wrongly (the missile still flies a frame
+after the explosion was due) is taken back and the missile drawn again (CG_RecoverMissile). Hits on players
+are predicted with cg_predictPlayerExplosions 1 (himself) or 2 (others too), off by default as they're less
+sure. The others' missiles are drawn ahead by cg_projectileNudge ms, or by the ping each came at
+(cg_projectileNudgeAuto 1, or half of it with 2), so a rocket on the screen is where it is on the server.
+
+An exploded missile stays a missile on the server for its event (s.time2: when, s.origin2: where,
+s.otherEntityNum2: whose), so its predicted status lives on until the explosion is confirmed.
+
+==============================================================================
+*/
+
+static predictedMissile_t	cg_predictedMissiles[MAX_PREDICTED_MISSILES];
+static predictedMissile_t	cg_activePMissiles;		// double linked list
+static predictedMissile_t	*cg_freePMissiles;		// single linked list
+
+// how far apart a predicted missile's launch and the server's may be to match: a frame and a half (Ratmod's; at
+// Oz's sv_fps 125 that's 12 ms, the commands' own spacing at 1000 fps and more)
+#define PMISSILE_WINDOWTIME		( 1500 / cgs.sv_fps )
+// how much longer than the player's round trip a predicted missile waits for the server's: Ratmod's frame and a
+// half (75 ms at its sv_fps 20), at least 100 ms here, as Oz's server frames are much shorter than the snapshot
+// interpolation and jitter a missile also waits through
+#define PMISSILE_WAITTIME		( PMISSILE_WINDOWTIME > 100 ? PMISSILE_WINDOWTIME : 100 )
+
+#define PMISSILE_DOUBLE_EXPLOSION_DISTANCE	128
+
+
+/*
+===================
+CG_ParseRatServerinfo
+
+The serverinfo's lag compensation settings (CG_ParseServerinfo)
+===================
+*/
+void CG_ParseRatServerinfo( const char *info ) {
+	const char	*allow;
+	char		nudge[16];
+
+	cgs.sv_fps = atoi( Info_ValueForKey( info, "g_svFps" ) );
+	if ( cgs.sv_fps <= 0 ) {
+		cgs.sv_fps = 20;
+	}
+	cgs.predictMissiles = atoi( Info_ValueForKey( info, "g_delagMissiles" ) ) && atoi( Info_ValueForKey( info, "g_predictMissiles" ) );
+	cgs.delagMissileMaxLatency = atoi( Info_ValueForKey( info, "g_delagMissileMaxLatency" ) );
+	if ( cgs.delagMissileMaxLatency <= 0 ) {
+		cgs.delagMissileMaxLatency = 500;
+	}
+	cgs.predictedMissileNudge = atoi( Info_ValueForKey( info, "g_delagMissileBaseNudge" ) );
+	allow = Info_ValueForKey( info, "g_allowTimenudge" );
+	cgs.allowTimenudge = !*allow || atoi( allow );
+	// Ratmod's g_allowTimenudge 0. Oz: the player's own cl_timeNudge is kept (cg_ozSavedTimeNudge, archived
+	// in case the game doesn't get to put it back) and comes back as the cgame shuts down or a server allows
+	// it again: it used to stay 0 for good after one such server
+	trap_Cvar_Register( NULL, "cg_ozSavedTimeNudge", "", CVAR_ARCHIVE );
+	trap_Cvar_VariableStringBuffer( "cl_timeNudge", nudge, sizeof( nudge ) );
+	if ( !cgs.allowTimenudge ) {
+		if ( atoi( nudge ) != 0 ) {
+			trap_Cvar_Set( "cg_ozSavedTimeNudge", nudge );
+			trap_Cvar_Set( "cl_timeNudge", "0" );
+		}
+	} else {
+		CG_OzRestoreTimeNudge();
+	}
+}
+
+
+/*
+===================
+CG_OzRestoreTimeNudge
+
+The cl_timeNudge a g_allowTimenudge 0 server took away, back (CG_Shutdown, CG_ParseRatServerinfo)
+===================
+*/
+void CG_OzRestoreTimeNudge( void ) {
+	char	nudge[16], saved[16];
+
+	trap_Cvar_VariableStringBuffer( "cg_ozSavedTimeNudge", saved, sizeof( saved ) );
+	if ( !saved[0] ) {
+		return;
+	}
+	trap_Cvar_VariableStringBuffer( "cl_timeNudge", nudge, sizeof( nudge ) );
+	if ( atoi( nudge ) == 0 ) {		// else the player has set another since
+		trap_Cvar_Set( "cl_timeNudge", saved );
+	}
+	trap_Cvar_Set( "cg_ozSavedTimeNudge", "" );
+}
+
+
+/*
+===================
+CG_MissileSpeed
+
+The speed the server gives this weapon's missiles (its g_ozMissileSpeeds: plasma, grenade, rocket, BFG)
+===================
+*/
+static float CG_MissileSpeed( int weapon ) {
+	int		pg = 2000, gl = 700, rl = 900, bfg = 2000;
+	const char *s = Info_ValueForKey( CG_ConfigString( CS_SERVERINFO ), "g_ozMissileSpeeds" );
+
+	if ( *s ) {
+		sscanf( s, "%i %i %i %i", &pg, &gl, &rl, &bfg );
+	}
+	switch ( weapon ) {
+	case WP_PLASMAGUN:			return pg;
+	case WP_GRENADE_LAUNCHER:	return gl;
+	case WP_ROCKET_LAUNCHER:	return rl;
+	case WP_BFG:				return bfg;
+	default:					return 0;
+	}
+}
+
+
+/*
+===================
+CG_InitPMissiles
+
+At startup and each restart (CG_InitLocalEntities)
+===================
+*/
+void CG_InitPMissiles( void ) {
+	int		i;
+
+	memset( cg_predictedMissiles, 0, sizeof( cg_predictedMissiles ) );
+	cg_activePMissiles.next = &cg_activePMissiles;
+	cg_activePMissiles.prev = &cg_activePMissiles;
+	cg_freePMissiles = cg_predictedMissiles;
+	for ( i = 0 ; i < MAX_PREDICTED_MISSILES - 1 ; i++ ) {
+		cg_predictedMissiles[i].next = &cg_predictedMissiles[i+1];
+	}
+}
+
+
+static void CG_FreePMissile( predictedMissile_t *pm ) {
+	if ( !pm->prev ) {
+		CG_Error( "CG_FreePMissile: not active" );
+	}
+	CG_RemoveOldMissileExplosion( &pm->status );
+
+	// remove from the doubly linked active list
+	pm->prev->next = pm->next;
+	pm->next->prev = pm->prev;
+
+	// the free list is only singly linked
+	pm->next = cg_freePMissiles;
+	cg_freePMissiles = pm;
+}
+
+
+static predictedMissile_t *CG_AllocPMissile( void ) {
+	predictedMissile_t	*pm;
+
+	if ( !cg_freePMissiles ) {
+		CG_FreePMissile( cg_activePMissiles.prev );		// none free: the oldest goes
+	}
+	pm = cg_freePMissiles;
+	cg_freePMissiles = cg_freePMissiles->next;
+	memset( pm, 0, sizeof( *pm ) );
+
+	pm->next = cg_activePMissiles.next;
+	pm->prev = &cg_activePMissiles;
+	cg_activePMissiles.next->prev = pm;
+	cg_activePMissiles.next = pm;
+	return pm;
+}
+
+
+/*
+===================
+CG_ReliablePing
+
+The player's ping, from the snapshot (it caps around 250 there: then from the commands the snapshots answer)
+===================
+*/
+int CG_ReliablePing( void ) {
+	int		ping = 999;
+
+	if ( cg.snap ) {
+		ping = cg.snap->ping;
+		if ( ping >= 999 && cg.nextSnap && cg.nextSnap != cg.snap ) {
+			ping = cg.snap->serverTime - cg.nextSnap->ps.commandTime;
+		}
+	}
+	if ( ping > 999 ) {
+		ping = 999;
+	} else if ( ping < 0 ) {
+		ping = 0;
+	}
+	return ping;
+}
