+
+/*
+===================
+CG_ProjectileNudgeTimeshift
+
+How far ahead a missile is drawn on a server that delags them: the player's own a server frame (as his predicted
+missiles are), so are grenades (their bounces aren't predicted) and everything while following someone; the
+others' by the ping they came at (cg_projectileNudgeAuto 1, half with 2) or cg_projectileNudge, plus the frame
+===================
+*/
+int CG_ProjectileNudgeTimeshift( centity_t *cent ) {
+	const int	frame = 1000 / cgs.sv_fps;
+
+	if ( CG_IsOwnMissile( cent ) || ( cg.snap && ( cg.snap->ps.pm_flags & PMF_FOLLOW ) ) || cg.demoPlayback
+			|| cent->currentState.weapon == WP_GRENADE_LAUNCHER ) {
+		return frame;
+	}
+	switch ( cg_projectileNudgeAuto.integer ) {
+	case 1:
+		return cent->projectileNudge + frame;
+	case 2:
+		return cent->projectileNudge / 2 + frame;
+	default:
+		return cg_projectileNudge.integer + frame;
+	}
+}
+
+
+/*
+===================
+CG_MissileTrailTime
+
+Where a missile's trail ends this frame: at its explosion, or as far ahead as the missile is drawn
+(cg_delagProjectileTrail)
+===================
+*/
+int CG_MissileTrailTime( centity_t *cent ) {
+	if ( CG_MissileExploded( &cent->currentState ) ) {
+		if ( cent->currentState.time2 < cg.time ) {
+			return cent->currentState.time2;
+		}
+		return cg.time;
+	}
+	if ( cgs.predictMissiles && cg_delagProjectileTrail.integer && cent->currentState.eType == ET_MISSILE ) {
+		int shift = CG_ProjectileNudgeTimeshift( cent ) - 10;
+		if ( shift < 0 ) {
+			shift = 0;
+		}
+		return cg.time + shift;
+	}
+	return cg.time;
+}
+
+
+/*
+===================
+CG_RemoveOldMissileExplosion
+
+Takes back an explosion drawn for a missile (a wrong prediction, or one the server's replaces)
+===================
+*/
+void CG_RemoveOldMissileExplosion( predictedMissileStatus_t *pms ) {
+	if ( pms->expLEntityID ) {
+		CG_FreeLocalEntityById( pms->expLEntityID );
+	}
+	pms->expLEntityID = 0;
+}
+
+
+/*
+===================
+CG_RecoverMissile
+
+A missile whose explosion was predicted, still flying a frame after the server would have said so: the
+prediction was wrong, so it's drawn again (CG_Missile)
+===================
+*/
+void CG_RecoverMissile( centity_t *missile ) {
+	predictedMissileStatus_t *pms = &missile->missileStatus;
+
+	if ( !( pms->missileFlags & ( MF_EXPLODED | MF_DISAPPEARED ) ) || ( pms->missileFlags & MF_EXPLOSIONCONFIRMED ) ) {
+		return;
+	}
+	if ( pms->explosionTime && pms->explosionTime + 1000 / cgs.sv_fps + CG_ProjectileNudgeTimeshift( missile ) < cg.time
+			&& !CG_MissileExploded( &missile->currentState ) ) {
+		pms->missileFlags &= ~( MF_EXPLODED | MF_DISAPPEARED | MF_HITPLAYER | MF_HITWALLMETAL | MF_HITWALL | MF_TRAILFINISHED );
+		CG_RemoveOldMissileExplosion( pms );
+	}
+}
+
+
+/*
+===================
+CG_RemovePredictedMissile
+
+The server's missile came: the predicted one it matches (the player's own, the same weapon, launched within a
+frame and a half) goes, its explosion carried over so it isn't drawn twice
+===================
+*/
+void CG_RemovePredictedMissile( centity_t *missile ) {
+	predictedMissile_t	*pm, *next;
+
+	if ( missile->missileStatus.missileFlags & MF_REMOVEDPMISSILE ) {
+		return;
+	}
+	missile->missileStatus.missileFlags |= MF_REMOVEDPMISSILE;
+
+	if ( !cg_ratPredictMissiles.integer || !CG_IsOwnMissile( missile ) ) {
+		return;
+	}
+	if ( cg_debugDelag.integer ) {
+		CG_Printf( "delag: own missile %d (weapon %d, launch %d) came; window %d\n", missile->currentState.number,
+			missile->currentState.weapon, missile->currentState.pos.trTime, PMISSILE_WINDOWTIME );
+	}
+	for ( pm = cg_activePMissiles.next; pm != &cg_activePMissiles; pm = next ) {
+		next = pm->next;
+		if ( pm->weapon != missile->currentState.weapon ) {
+			continue;
+		}
+		if ( missile->currentState.pos.trTime - PMISSILE_WINDOWTIME > pm->pos.trTime
+				|| missile->currentState.pos.trTime + PMISSILE_WINDOWTIME < pm->pos.trTime ) {
+			continue;
+		}
+		if ( pm->status.missileFlags & MF_EXPLODED ) {
+			// its explosion was drawn already: the server's missile takes that over
+			missile->missileStatus = pm->status;
+			missile->missileStatus.missileFlags |= MF_REMOVEDPMISSILE;
+			pm->status.expLEntityID = 0;
+		}
+		if ( cg_debugDelag.integer ) {
+			CG_Printf( "delag: server missile %d took over the predicted one (launch %d vs %d)\n", missile->currentState.number,
+				missile->currentState.pos.trTime, pm->pos.trTime );
+		}
+		CG_FreePMissile( pm );
+		return;
+	}
+}
