+/*
+============
+G_UnlaggedClientClear
+
+Oz: a client slot's state starts empty (ClientConnect, ClientDisconnect): the next player in it began with the
+last one's ping samples and equalizer hold, and after a map change the engine still held packets by a list
+this game, starting from zero, saw nothing to change in
+============
+*/
+void G_UnlaggedClientClear( int clientNum ) {
+	if ( clientNum < 0 || clientNum >= MAX_CLIENTS ) {
+		return;
+	}
+	memset( &ul[clientNum], 0, sizeof( ul[clientNum] ) );
+	ul[clientNum].delag = 1;
+	eqWritten = qfalse;
