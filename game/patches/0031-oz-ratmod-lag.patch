+/*
+==============
+G_SetTeleporterDestinations
+
+Oz: Ratmod's teleporter prediction: a teleporter with one destination tells the clients where it goes (origin2,
+angles2, generic1 1), so the player's own cgame moves him through it as he touches it instead of a round trip
+later (cg_predictTeleport). g_teleporterPrediction 0 leaves them unknown.
+==============
+*/
+void G_SetTeleporterDestinations( void ) {
+	gentity_t	*ent, *target, *unique;
+	int			i;
+
+	for ( i = 0, ent = g_entities; i < level.num_entities; i++, ent++ ) {
+		if ( !ent->inuse || ent->s.eType != ET_TELEPORT_TRIGGER ) {
+			continue;
+		}
+		ent->s.generic1 = 0;
+		if ( ( ent->spawnflags & 1 ) || !ent->target || !g_teleporterPrediction.integer ) {
+			continue;		// spectators only, or off
+		}
+		unique = NULL;
+		target = NULL;
+		while ( ( target = G_Find( target, FOFS( targetname ), ent->target ) ) != NULL ) {
+			if ( unique ) {
+				unique = NULL;		// a random one of several: the server picks
+				break;
+			}
+			unique = target;
+		}
+		if ( unique ) {
+			VectorCopy( unique->s.origin, ent->s.origin2 );
+			VectorCopy( unique->s.angles, ent->s.angles2 );
+			ent->s.generic1 = 1;
+		}
+	}
+}
