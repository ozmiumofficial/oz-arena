+/*
+=====================
+G_PingEqualizer
+
+Oz: Ratmod's ping equalizer (g_pingEqualizer 1, off by default): every player's packets are held so they all play
+at the highest ping among them, as Ratmod's server engine does (its sv_eqping; here the engine's sv_ozEqDelays,
+the ms to hold each client's snapshots). A peer-to-peer match's host has no ping of his own, so this takes away
+his edge too. Once a second, in 5 ms steps, changed only by 20 ms or more (pings wander that much) so the
+snapshots don't jitter; at most g_pingEqualizerMax ms
+=====================
+*/
+void G_PingEqualizer( void ) {
+	static int	nextTime;
+	char		list[MAX_CLIENTS * 4 + 1];
+	int			i, base[MAX_CLIENTS], highest = 0, changed = 0;
+
+	if ( level.time < nextTime ) {
+		return;
+	}
+	nextTime = level.time + 1000;
+
+	for ( i = 0; i < level.maxclients; i++ ) {
+		gclient_t	*cl = &level.clients[i];
+		base[i] = -1;
+		if ( cl->pers.connected != CON_CONNECTED || ( g_entities[i].r.svFlags & SVF_BOT )
+				|| cl->sess.sessionTeam == TEAM_SPECTATOR || !ul[i].pingSampleCount ) {
+			continue;
+		}
+		// his own connection's ping: what he has now, less what the equalizer adds
+		base[i] = ul[i].realPing - ul[i].eqDelay;
+		if ( base[i] < 0 ) {
+			base[i] = 0;
+		}
+		if ( base[i] > highest ) {
+			highest = base[i];
+		}
+	}
+
+	list[0] = '\0';
+	for ( i = 0; i < level.maxclients; i++ ) {
+		int	want = 0;
+		if ( g_pingEqualizer.integer && base[i] >= 0 ) {
+			want = ( ( highest - base[i] ) / 5 ) * 5;
+			if ( want > g_pingEqualizerMax.integer ) {
+				want = g_pingEqualizerMax.integer;
+			}
+			if ( want < 0 ) {
+				want = 0;
+			}
+			if ( abs( want - ul[i].eqDelay ) < 20 && want ) {
+				want = ul[i].eqDelay;		// close enough: no jitter
+			}
+		}
+		if ( want != ul[i].eqDelay ) {
+			changed = 1;
+			if ( g_delagMissileDebug.integer ) {
+				Com_Printf( "eqping: client %i (ping %i) held %i ms (was %i)\n", i, base[i], want, ul[i].eqDelay );
+			}
+		}
+		ul[i].eqDelay = want;
+		Q_strcat( list, sizeof( list ), va( "%i ", want ) );
+	}
+	// also the first time after the game starts and after a client came or went: the engine may still hold
+	// packets by the list of the map before, or for the player who had the slot
+	if ( changed || !eqWritten ) {
+		trap_Cvar_Set( "sv_ozEqDelays", list );
+		eqWritten = qtrue;
+	}
+}
