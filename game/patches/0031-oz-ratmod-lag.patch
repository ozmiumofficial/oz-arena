+/*
+============
+G_UnlaggedTeleported
+
+Oz: he went through a teleporter and his history is kept (g_delagAllowHitsAfterTele 1): his next record is
+marked, so a shot from between the two finds him where its shooter still saw him, at the teleporter, and not
+somewhere on the line through the map between the two places
+============
+*/
+void G_UnlaggedTeleported( gentity_t *ent ) {
+	const int	n = ent - g_entities;
+
+	if ( n >= 0 && n < MAX_CLIENTS ) {
+		ul[n].teleported = qtrue;
+	}
+}
