--- a/code/game/g_missile.c
+++ b/code/game/g_missile.c
@@ -24,6 +24,161 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 
 #define	MISSILE_PRESTEP_TIME	50
 
+
+/*
+==============================================================================
+
+Oz: Ratmod's delagged projectiles (ratmod.github.io, rdntcntrl/ratoa_gamecode g_missile.c, GPL-2.0)
+
+A projectile starts at the shooter's command time (when he saw what he fired at, less g_delagMissileBaseNudge
+ms), no further back than g_delagMissileMaxLatency ms, instead of id's 50 ms ahead of the server's frame. The
+flight from then to the last frame (G_MissileRunDelag) is run a server frame at a time with the other players
+moved to where they were at each step (Unlagged's history, g_unlagged.c), so a rocket hits where the shooter's
+screen said it would. g_delagMissileImmediateRun 2 runs it at the shooter's next command, so it's in the next
+snapshot already where it is; 1 runs it as it's fired; 0 at the server's next frame. g_delagMissiles 0 is id's
+game; g_delagMissileNudgeOnly 1 keeps the earlier start without the time shifted flight.
+
+==============================================================================
+*/
+
+// The delag run below turns level.time back while a missile flies its first frames. What it does on the way
+// still happens now: an event stamped with the turned back time was cleared as too old before any snapshot
+// carried it (no explosion, no obituary for a shooter 300 ms behind), a kill's reward, the victim's respawn
+// delay and the time shift's "saved this frame" mark went by it too. Those read the time here.
+static int	delagRealTime;
+static int	delagRunning;
+
+int G_RealTime( void ) {
+	return delagRunning ? delagRealTime : level.time;
+}
+
+void G_SetMissileLaunchTime( gentity_t *self, gentity_t *bolt ) {
+	bolt->needsDelag = qfalse;
+	bolt->missileRan = 0;
+	if ( !self || !self->client || !g_delagMissiles.integer ) {
+		// id's 50 ms ahead, for a map's shooter (shooter_rocket...) too; its nails start at the frame's time
+		bolt->s.pos.trTime = level.time - MISSILE_PRESTEP_TIME;
+#ifdef MISSIONPACK
+		if ( bolt->s.weapon == WP_NAILGUN ) {
+			bolt->s.pos.trTime = level.time;
+		}
+#endif
+		bolt->launchTime = bolt->s.pos.trTime;
+		return;
+	}
+
+	bolt->s.pos.trTime = G_UnlaggedAttackTime( self ) - g_delagMissileBaseNudge.integer;
+
+	if ( bolt->s.pos.trTime < level.time - g_delagMissileMaxLatency.integer ) {
+		if ( g_delagMissileDebug.integer ) {
+			Com_Printf( "delag: client %i's projectile from %i ms back limited to %i (true ping %i)\n", self->s.number,
+				level.time - bolt->s.pos.trTime, g_delagMissileMaxLatency.integer, G_RealPing( self ) );
+		}
+		bolt->s.pos.trTime = level.time - g_delagMissileMaxLatency.integer;
+	} else if ( bolt->s.pos.trTime > level.time ) {
+		// no projectiles from the future: evaluated at level.time it would move backwards from its launch
+		bolt->s.pos.trTime = level.time;
+	}
+
+	// Oz: nor from further back than his measured ping allows (g_unlagged.c)
+	bolt->s.pos.trTime = G_UnlaggedFloor( self, bolt->s.pos.trTime );
+	if ( bolt->s.pos.trTime > level.time ) {
+		bolt->s.pos.trTime = level.time;
+	}
+
+	// the true launch time, for the delag if it bounces or teleports before it runs
+	bolt->launchTime = bolt->s.pos.trTime;
+	bolt->needsDelag = qtrue;
+}
+
+
+void G_MissileRunDelag( gentity_t *ent, int stepmsec ) {
+	int		prevTimeSaved, levelTimeSaved, t;
+
+	if ( !ent->inuse || ent->freeAfterEvent || ent->s.eType != ET_MISSILE || !ent->needsDelag ) {
+		return;
+	}
+	ent->needsDelag = qfalse;
+	if ( g_delagMissileNudgeOnly.integer || level.previousTime <= DELAG_MAX_BACKTRACK || stepmsec <= 0 ) {
+		return;
+	}
+
+	// the flight since it was launched, a frame at a time, with the others where the shooter saw them
+	prevTimeSaved = level.previousTime;
+	levelTimeSaved = level.time;
+	for ( t = level.previousTime - ( DELAG_MAX_BACKTRACK / stepmsec ) * stepmsec; t < prevTimeSaved; t += stepmsec ) {
+		if ( !ent->inuse || ent->freeAfterEvent || ent->s.eType != ET_MISSILE ) {
+			break;		// it went off
+		}
+		if ( t < ent->launchTime ) {
+			continue;
+		}
+		G_TimeShiftAllClients( t, ent->parent );
+		if ( !delagRunning ) {
+			delagRealTime = levelTimeSaved;
+		}
+		delagRunning++;
+		level.time = t + stepmsec;
+		level.previousTime = t;
+		G_RunMissile( ent );
+		level.time = levelTimeSaved;
+		level.previousTime = prevTimeSaved;
+		delagRunning--;
+		G_UnTimeShiftAllClients( ent->parent );
+	}
+	if ( g_delagMissileDebug.integer ) {
+		Com_Printf( "delag: projectile %i ran from %i ms back\n", ent->s.number, levelTimeSaved - ent->launchTime );
+	}
+}
+
+
+static void G_ImmediateRunMissile( gentity_t *ent ) {
+	if ( ent->missileRan == 1 ) {
+		return;		// ran already
+	}
+	G_MissileRunDelag( ent, level.time - level.previousTime );
+	if ( !ent->inuse || ent->freeAfterEvent ) {
+		return;
+	}
+	if ( ent->s.eType == ET_MISSILE ) {
+		G_RunMissile( ent );
+	}
+}
+
+
+// a projectile just fired (the weapon's fire function)
+void G_ImmediateLaunchMissile( gentity_t *ent ) {
+	if ( !ent || !g_delagMissiles.integer ) {
+		return;
+	}
+	if ( g_delagMissileImmediateRun.integer == 1 ) {
+		G_ImmediateRunMissile( ent );
+	} else if ( g_delagMissileImmediateRun.integer >= 2 ) {
+		ent->missileRan = -g_delagMissileImmediateRun.integer + 1;
+	}
+}
+
+
+// after each command of a player (ClientThink_real): runs his projectiles waiting for it
+void G_ImmediateRunClientMissiles( gentity_t *client ) {
+	gentity_t	*ent;
+	int			i;
+
+	if ( g_delagMissileImmediateRun.integer <= 1 ) {
+		return;
+	}
+	for ( i = MAX_CLIENTS, ent = &g_entities[MAX_CLIENTS]; i < level.num_entities; i++, ent++ ) {
+		if ( !ent->inuse || ent->freeAfterEvent || ent->s.eType != ET_MISSILE || ent->parent != client ) {
+			continue;
+		}
+		if ( ent->missileRan < 0 ) {
+			ent->missileRan++;		// run at a later command
+			continue;
+		}
+		G_ImmediateRunMissile( ent );
+	}
+}
