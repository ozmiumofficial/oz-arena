+// an explosion event's missile status: the missile's own, if it's still one (Ratmod's exploded missiles)
+predictedMissileStatus_t *CG_EventMissileStatus( centity_t *cent ) {
+	if ( cent->currentState.eType == ET_MISSILE ) {
+		return &cent->missileStatus;
+	}
+	return NULL;
+}
