+
+static qboolean CG_ShouldPredictExplosion( void ) {
+	// near the server's delag limit the prediction may be off
+	return CG_ReliablePing() + 20 <= cgs.delagMissileMaxLatency;
+}
+
+
+/*
+===================
+CG_ExplosionPredicted
+
+The server's explosion event for a missile whose explosion was drawn already, about there: it's dropped
+(CG_EntityEvent)
+===================
+*/
+qboolean CG_ExplosionPredicted( centity_t *cent, int checkFlags, vec3_t realExpOrigin, int realHitEnt ) {
+	int		flags = checkFlags;
+
+	if ( cent->currentState.eType != ET_MISSILE || cg_ratPredictMissiles.integer <= 0 || !cgs.predictMissiles
+			|| !cg_predictExplosions.integer ) {
+		return qfalse;
+	}
+	CG_RemovePredictedMissile( cent );
+
+	// what it hit isn't compared: a missile that kills its target makes a miss event, not a hit
+	flags &= ~( MF_HITPLAYER | MF_HITWALL | MF_HITWALLMETAL );
+	flags |= MF_EXPLODED;
+	if ( ( cent->missileStatus.missileFlags & flags ) != flags ) {
+		return qfalse;
+	}
+	if ( Distance( realExpOrigin, cent->missileStatus.explosionPos ) > PMISSILE_DOUBLE_EXPLOSION_DISTANCE ) {
+		return qfalse;
+	}
+	if ( ( checkFlags & MF_HITPLAYER ) && ( cent->missileStatus.missileFlags & MF_HITPLAYER )
+			&& realHitEnt != cent->missileStatus.hitEntity ) {
+		return qfalse;
+	}
+	if ( cg_debugDelag.integer ) {
+		CG_Printf( "delag: server explosion %d matched the predicted one (%.0f units off)\n", cent->currentState.number,
+			Distance( realExpOrigin, cent->missileStatus.explosionPos ) );
+	}
+	return qtrue;
+}
+
+
+void CG_UpdateMissileStatus( predictedMissileStatus_t *pms, int addedFlags, vec3_t explosionOrigin, int hitEntity ) {
+	pms->missileFlags |= addedFlags;
+	VectorCopy( explosionOrigin, pms->explosionPos );
+	pms->explosionTime = cg.time + 1000 / cgs.sv_fps;
+	pms->hitEntity = hitEntity;
+}
+
+
+/*
+===================
+CG_PredictedExplosion
+
+A missile drawn into something (a predicted one, or the server's drawn ahead): its explosion drawn now
+===================
+*/
+void CG_PredictedExplosion( trace_t *tr, int weapon, predictedMissile_t *predMissile, centity_t *missileEnt ) {
+	predictedMissileStatus_t	*pms;
+	centity_t					*hitEnt;
+
+	if ( missileEnt ) {
+		CG_RemovePredictedMissile( missileEnt );
+	}
+	if ( !cg_predictExplosions.integer || cg_ratPredictMissiles.integer <= 0 || !cgs.predictMissiles
+			|| ( tr->surfaceFlags & SURF_NOIMPACT ) || !( predMissile || missileEnt ) ) {
+		return;
+	}
+	if ( weapon == WP_GRENADE_LAUNCHER || weapon == WP_GRAPPLING_HOOK ) {
+		return;		// grenades bounce, which isn't predicted
+	}
+#ifdef MISSIONPACK
+	if ( weapon == WP_PROX_LAUNCHER || weapon == WP_NAILGUN ) {
+		return;
+	}
+#endif
+
+	if ( predMissile ) {
+		if ( !CG_ShouldPredictExplosion() ) {
+			return;
+		}
+		pms = &predMissile->status;
+	} else {
+		if ( cg_projectileNudgeAuto.integer != 1 && !CG_IsOwnMissile( missileEnt ) ) {
+			return;		// the others' aren't where the server has them without the automatic nudge
+		}
+		pms = &missileEnt->missileStatus;
+	}
+	if ( pms->missileFlags & ( MF_EXPLODED | MF_DISAPPEARED ) ) {
+		return;		// predicted already: the server says the rest
+	}
+
+	if ( cg_debugDelag.integer ) {
+		if ( predMissile ) {
+			CG_Printf( "delag: predicted explosion of own predicted missile at %.0f %.0f %.0f\n", tr->endpos[0], tr->endpos[1], tr->endpos[2] );
+		} else {
+			CG_Printf( "delag: predicted explosion of missile %d at %.0f %.0f %.0f\n", missileEnt->currentState.number, tr->endpos[0], tr->endpos[1], tr->endpos[2] );
+		}
+	}
+	hitEnt = &cg_entities[tr->entityNum];
+	if ( tr->entityNum < MAX_CLIENTS && hitEnt->currentState.eType == ET_PLAYER ) {
+		if ( !cg_predictPlayerExplosions.integer ) {
+			return;
+		}
+		if ( missileEnt && CG_MissileOwner( missileEnt ) == tr->entityNum ) {
+			return;		// never its owner
+		}
+		if ( tr->entityNum != cg.clientNum && cg_predictPlayerExplosions.integer <= 1 ) {
+			return;		// someone else: only with 2, it's less sure
+		}
+		CG_MissileHitPlayerEx( weapon, tr->endpos, tr->plane.normal, tr->entityNum, pms );
+		CG_UpdateMissileStatus( pms, MF_EXPLODED | MF_HITPLAYER, tr->endpos, tr->entityNum );
+	} else if ( tr->surfaceFlags & SURF_METALSTEPS ) {
+		CG_MissileHitWallEx( weapon, 0, tr->endpos, tr->plane.normal, IMPACTSOUND_METAL, pms );
+		CG_UpdateMissileStatus( pms, MF_EXPLODED | MF_HITWALLMETAL, tr->endpos, tr->entityNum );
+	} else {
+		CG_MissileHitWallEx( weapon, 0, tr->endpos, tr->plane.normal, IMPACTSOUND_DEFAULT, pms );
+		CG_UpdateMissileStatus( pms, MF_EXPLODED | MF_HITWALL, tr->endpos, tr->entityNum );
+	}
+}
+
+
+/*
+===================
+CG_RunPredictedMissile
+
+A frame of a predicted missile: moved a server frame ahead, as the server's own is drawn, and its explosion
+predicted when it reaches something
+===================
+*/
+static void CG_RunPredictedMissile( predictedMissile_t *pm ) {
+	const weaponInfo_t	*weapon = &cg_weapons[pm->weapon];
+	vec3_t				newOrigin;
+	trace_t				trace;
+
+	if ( pm->removeTime < cg.time ) {
+		CG_FreePMissile( pm );
+		return;
+	}
+	if ( pm->status.missileFlags & ( MF_EXPLODED | MF_DISAPPEARED ) ) {
+		return;
+	}
+
+	BG_EvaluateTrajectory( &pm->pos, cg.time + 1000 / cgs.sv_fps, newOrigin );
+	CG_Trace( &trace, pm->refEntity.origin, NULL, NULL, newOrigin, cg.predictedPlayerState.clientNum, MASK_SHOT );
+	if ( trace.fraction < 1.0f ) {
+		CG_PredictedExplosion( &trace, pm->weapon, pm, NULL );
+		pm->status.missileFlags |= MF_DISAPPEARED;
+		return;
+	}
+
+	VectorCopy( newOrigin, pm->refEntity.origin );
+	VectorCopy( newOrigin, pm->refEntity.oldorigin );
+	if ( weapon->missileDlight ) {
+		trap_R_AddLightToScene( newOrigin, weapon->missileDlight,
+			weapon->missileDlightColor[0], weapon->missileDlightColor[1], weapon->missileDlightColor[2] );
+	}
+	if ( pm->weapon == WP_PLASMAGUN ) {
+		refEntity_t	ball = pm->refEntity;
+		CG_OzPlasmaBall( &ball );	// Oz: in Plasma color, as CG_Missile draws it
+		trap_R_AddRefEntityToScene( &ball );
+		return;
+	}
+	if ( VectorNormalize2( pm->pos.trDelta, pm->refEntity.axis[0] ) == 0 ) {
+		pm->refEntity.axis[0][2] = 1;
+	}
+	if ( pm->pos.trType != TR_STATIONARY ) {
+		RotateAroundDirection( pm->refEntity.axis, cg.time / 4 );
+	}
+	pm->refEntity.skinNum = cg.clientFrame & 1;
+	trap_R_AddRefEntityToScene( &pm->refEntity );
+}
+
+
+// each frame (CG_DrawActiveFrame), newest last so a missile fired this frame is drawn this frame
+void CG_AddPredictedMissiles( void ) {
+	predictedMissile_t	*pm, *next;
+
+	for ( pm = cg_activePMissiles.prev; pm != &cg_activePMissiles; pm = next ) {
+		next = pm->prev;
+		CG_RunPredictedMissile( pm );
+	}
+}
+
+
+/*
+===================
+CG_PredictMissileWeapon
+
+The player fired a projectile weapon (CG_PredictWeaponEffects): its missile, as fire_plasma, fire_grenade,
+fire_rocket and fire_bfg make it from the server's muzzle point, starting at this command's time less the
+server's base nudge
+===================
+*/
+static void CG_PredictMissileWeapon( centity_t *cent, const vec3_t muzzle, vec3_t forward ) {
+	predictedMissile_t	*pm;
+	refEntity_t			*bolt;
+	usercmd_t			cmd;
+	const int			weapon = cent->currentState.weapon;
+
+	if ( cg_ratPredictMissiles.integer <= 0 || !cgs.predictMissiles ) {
+		return;
+	}
+	if ( cg.demoPlayback || cg_nopredict.integer || cg_synchronousClients.integer || !cg.snap
+			|| ( cg.snap->ps.pm_flags & PMF_FOLLOW ) ) {
+		return;
+	}
+	if ( CG_ReliablePing() > cgs.delagMissileMaxLatency ) {
+		return;		// the server won't take it back that far
+	}
+
+	trap_GetUserCmd( trap_GetCurrentCmdNumber(), &cmd );
+	pm = CG_AllocPMissile();
+	pm->removeTime = cg.time + CG_ReliablePing() + PMISSILE_WAITTIME;
+	pm->weapon = weapon;
+	VectorCopy( muzzle, pm->pos.trBase );
+	pm->pos.trTime = cmd.serverTime - cgs.predictedMissileNudge;
+	if ( weapon == WP_GRENADE_LAUNCHER ) {
+		forward[2] += 0.2f;		// weapon_grenadelauncher_fire's extra vertical velocity
+		VectorNormalize( forward );
+		pm->pos.trType = TR_GRAVITY;
+	} else {
+		pm->pos.trType = TR_LINEAR;
+	}
+	VectorScale( forward, CG_MissileSpeed( weapon ), pm->pos.trDelta );
+	SnapVector( pm->pos.trDelta );
+
+	if ( cg_debugDelag.integer ) {
+		CG_Printf( "delag: predicted missile weapon %d launched %d (cg.time %d, ping %d)\n", weapon, pm->pos.trTime, cg.time, CG_ReliablePing() );
+	}
+	bolt = &pm->refEntity;
+	VectorCopy( muzzle, bolt->origin );
+	VectorCopy( muzzle, bolt->oldorigin );
+	if ( weapon == WP_PLASMAGUN ) {
+		bolt->reType = RT_SPRITE;
+		bolt->radius = 16;
+		bolt->rotation = 0;
+		bolt->customShader = cgs.media.plasmaBallShader;
+		return;
+	}
+	bolt->reType = RT_MODEL;
+	bolt->hModel = cg_weapons[weapon].missileModel;
+	bolt->renderfx = cg_weapons[weapon].missileRenderfx | RF_NOSHADOW;
+}
