+
+// whether the server says this missile already exploded (it stays a missile for its event)
+qboolean CG_MissileExploded( const entityState_t *es ) {
+	return es->eType == ET_MISSILE && es->time2 > 0 && cgs.predictMissiles;
+}
+
+
+int CG_MissileOwner( centity_t *missile ) {
+	if ( CG_MissileExploded( &missile->currentState ) ) {
+		return missile->currentState.otherEntityNum2;	// otherEntityNum is who it hit then
+	}
+	return missile->currentState.otherEntityNum;
+}
+
+
+static qboolean CG_IsOwnMissile( centity_t *missile ) {
+	return CG_MissileOwner( missile ) == cg.clientNum;
+}
