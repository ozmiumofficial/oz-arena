+/*
+============
+G_UnlaggedFloor
+
+Oz: the earliest time a shot of his may be taken back to. A command's time is the client's own word: a
+changed client could claim g_delagMax of lag with a ping of 20. What the engine measured bounds it: his ping,
+the equalizer's hold, a server frame and 100 ms for the snapshots he draws between and a late packet. Not
+while the engine has no ping for him yet (999), nor for the server's own player
+============
+*/
+int G_UnlaggedFloor( gentity_t *ent, int time ) {
+	const int	n = ent - g_entities;
+	int			frame, earliest;
+
+	if ( n < 0 || n >= MAX_CLIENTS || !ent->client || ent->client->pers.localClient || ( ent->r.svFlags & SVF_BOT )
+			|| ent->client->ps.ping < 0 || ent->client->ps.ping >= 999 ) {
+		return time;
+	}
+	frame = level.time - level.previousTime;
+	if ( frame <= 0 || frame > 200 ) {
+		frame = 50;
+	}
+	earliest = G_RealTime() - ( ent->client->ps.ping + ul[n].eqDelay + frame + 100 );
+	return time < earliest ? earliest : time;
+}
 
 
