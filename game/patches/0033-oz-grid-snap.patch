+/*
+================
+PM_OzGridMove
+
+Oz: Pmove for a server that rounds the velocity at the 8 ms marks of its clock (bg_gridSnap): the move runs in
+pieces that end at each mark, where the velocity is rounded as one 125 fps frame's would be, and what is left
+past the last mark runs unrounded, as such a server's snapshots show it
+================
+*/
+static void PM_OzGridMove( pmove_t *pmove, int finalTime ) {
+	pmove->ps->pmove_framecount = (pmove->ps->pmove_framecount+1) & ((1<<PS_PMOVEFRAMECOUNTBITS)-1);
+	while ( pmove->ps->commandTime != finalTime ) {
+		int		msec = finalTime - pmove->ps->commandTime;
+
+		if ( msec > 8 - pmove->ps->commandTime % 8 ) {
+			msec = 8 - pmove->ps->commandTime % 8;
+		}
+		pmove->cmd.serverTime = pmove->ps->commandTime + msec;
+		if ( pmove->stepFrom ) {
+			*pmove->stepFrom = *pmove->ps;
+		}
+		PmoveSingle( pmove );
+		if ( pmove->ps->pm_flags & PMF_JUMP_HELD ) {
+			pmove->cmd.upmove = 20;
+		}
+	}
+}
