+/*
+=================
+CG_OzGridSnap
+
+Oz: how the server's game rounds a player's velocity, worked out from what its snapshots show. id's game
+rounds it to whole units after every command, so the snapshot's is always whole in the air (but for the
+moment of a push). Some community servers' games (Area 51's, 2026-11-10) round it only as a move crosses an
+8 ms mark of the server's clock, so every frame rate falls and jumps as 125 fps does: above 125 fps most
+commands cross none, and the snapshot shows the fall's speed whole at the last mark less the gravity of the
+milliseconds since. Predicting such a server id's way missed at most snapshots in the air above 125 fps
+(1,000 fps falls with a gravity of 1000 id's way, 750 there).
+
+So each new snapshot of the player in the air, at a command time past a mark, is looked at: a falling speed
+that is whole only once those milliseconds' gravity is put back says the server rounds at the marks; one
+that is whole as it is, after a command of the player's own that crossed no mark, says it rounds every
+command. Running says it sooner: id's way the speed across the floor is whole in every snapshot, this way only
+at a mark. Two more of the first than of the second turn bg_gridSnap on, and as many back turn it off; a speed
+that isn't whole at a mark turns it off at once (a game that never rounds).
+cg_ozGridSnap -1 is this, 0 never (id's), 1 always; cg_showmiss prints the change.
+=================
+*/
+static void CG_OzGridSnap( void ) {
+	static vmCvar_t	mode;
+	static qboolean	registered;
+	static int		looked, score;
+	const playerState_t *ps;
+	usercmd_t		cmd;
+	float			back, whole, put, side;
+	int				ms, n, current, on;
+
+	if ( !registered ) {
+		trap_Cvar_Register( &mode, "cg_ozGridSnap", "-1", 0 );
+		registered = qtrue;
+	}
+	trap_Cvar_Update( &mode );
+	if ( mode.integer >= 0 ) {
+		bg_gridSnap = mode.integer != 0;
+		return;
+	}
+	ps = &cg.snap->ps;
+	if ( cg.snap->serverTime == looked ) {
+		return;
+	}
+	looked = cg.snap->serverTime;
+	ms = ps->commandTime & 7;
+	if ( ps->pm_type != PM_NORMAL || ( ps->pm_flags & PMF_ALL_TIMES ) ) {
+		return;		// a push's speed is unrounded on any server
+	}
+	on = bg_gridSnap;
+	// running: id's way the speed across the floor is whole in every snapshot; this way only at a mark. And a
+	// speed that isn't whole at a mark is neither way (a game that never rounds)
+	side = fabs( ps->velocity[0] - floor( ps->velocity[0] + 0.5 ) ) + fabs( ps->velocity[1] - floor( ps->velocity[1] + 0.5 ) );
+	if ( ms == 0 ) {
+		if ( side > 0.02 || fabs( ps->velocity[2] - floor( ps->velocity[2] + 0.5 ) ) > 0.02 ) {
+			score = 0;
+			bg_gridSnap = 0;
+		}
+	} else if ( ps->groundEntityNum != ENTITYNUM_NONE ) {
+		if ( side > 0.02 && score < 4 ) {
+			score++;
+		}
+	}
+	back = ms * ps->gravity * 0.001f;
+	if ( ps->groundEntityNum != ENTITYNUM_NONE || fabs( back - floor( back + 0.5 ) ) < 0.05 || fabs( ps->velocity[2] ) < 2 ) {
+		back = -1;	// nothing in the fall to tell them apart by
+	}
+	whole = fabs( ps->velocity[2] - floor( ps->velocity[2] + 0.5 ) );
+	put = ps->velocity[2] + back;
+	put = fabs( put - floor( put + 0.5 ) );
+	if ( back < 0 ) {
+		// the floor's evidence only
+	} else if ( whole > 0.02 && put < 0.01 ) {
+		if ( score < 4 ) {
+			score++;
+		}
+	} else if ( whole < 0.01 && score > 0 ) {
+		// whole as it is: id's way if the command it ended with crossed no mark
+		current = trap_GetCurrentCmdNumber();
+		for ( n = current; n > current - CMD_BACKUP + 1 && n > 1; n-- ) {
+			if ( !trap_GetUserCmd( n, &cmd ) || cmd.serverTime < ps->commandTime ) {
+				break;
+			}
+			if ( cmd.serverTime == ps->commandTime ) {
+				if ( trap_GetUserCmd( n - 1, &cmd ) && cmd.serverTime / 8 == ps->commandTime / 8
+						&& cmd.serverTime < ps->commandTime ) {
+					score--;
+				}
+				break;
+			}
+		}
+	}
+	if ( score >= 2 ) {
+		bg_gridSnap = 1;
+	} else if ( score == 0 ) {
+		bg_gridSnap = 0;
+	}
+	if ( bg_gridSnap != on && cg_showmiss.integer ) {
+		CG_Printf( "grid snap %s: the server rounds the velocity %s\n", bg_gridSnap ? "on" : "off",
+			bg_gridSnap ? "at 8 ms marks" : "after every command" );
+	}
+}
