; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Q3Remaster"
config/description="Remastered Quake III Arena: main menu, asset library, Gameplay and Map editor scenes."
config/version="0.1.0-dev"
run/main_scene="res://scenes/splash/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Q3="*res://scripts/q3.gd"
Settings="*res://scripts/settings/settings.gd"
UiSound="*res://scripts/ui/ui_sound.gd"
Session="*res://scripts/session.gd"
Online="*res://scripts/online/online.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_bridge/plugin.cfg")

[importer_defaults]

scene={
"import_script/path": "res://scripts/import/q3_post_import.gd"
}

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
3d/default_gravity=25.0

[rendering]

anti_aliasing/quality/msaa_3d=2

[editor]

export/convert_text_resources_to_binary=false
