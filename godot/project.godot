; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Q3Remaster"
config/description="Remastered Quake III Arena: main menu, asset library, Gameplay and Map editor scenes."
config/version="0.4.0-beta"
run/main_scene="res://scenes/splash/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Diagnostics="*uid://cu0aae7rbsfb1"
Q3="*res://scripts/q3.gd"
Settings="*res://scripts/settings/settings.gd"
UiSound="*res://scripts/ui/ui_sound.gd"
Session="*uid://6k8xg1ava63c"
Online="*res://scripts/online/online.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

file_logging/max_log_files=20
settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_bridge/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[importer_defaults]

scene={
"import_script/path": "res://scripts/import/q3_post_import.gd"
}
wav={
"edit/loop_mode": 1
}

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
3d/default_gravity=25.0

[rendering]

reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_count=80
anti_aliasing/quality/msaa_3d=2
