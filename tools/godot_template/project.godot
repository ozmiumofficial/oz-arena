; Q3Remaster (Godot 4.7). Generated by tools/make_godot_project.py from tools/godot_template;
; library/ is filled from the work folder.
; Launch: splash (disclaimer) -> main menu -> Gameplay or Map editor (scripts/session.gd).

config_version=5

[application]

config/name="Q3Remaster"
config/description="Remastered Quake III Arena: main menu, asset library, Gameplay and Map editor scenes."
config/version="0.3.0-beta"
run/main_scene="res://scenes/splash/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Diagnostics="*res://scripts/diagnostics/diagnostics.gd"
Q3="*res://scripts/q3.gd"
Settings="*res://scripts/settings/settings.gd"
UiSound="*res://scripts/ui/ui_sound.gd"
Session="*res://scripts/session.gd"
Online="*res://scripts/online/online.gd"

[debug]

file_logging/max_log_files=20
settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_bridge/plugin.cfg")

[importer_defaults]

scene={
"import_script/path": "res://scripts/import/q3_post_import.gd"
}

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
3d/default_gravity=25.0

[rendering]

anti_aliasing/quality/msaa_3d=2
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_count=80

[editor]

export/convert_text_resources_to_binary=false
