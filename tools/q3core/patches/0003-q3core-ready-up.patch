 /*
 =============
+G_EveryoneReady
+
+q3core: true when every human player (not spectators, not bots) has typed "ready".
+=============
+*/
+qboolean G_EveryoneReady( void ) {
+	int i, humans = 0;
+	gclient_t *cl;
+	for ( i = 0; i < level.maxclients; i++ ) {
+		cl = &level.clients[i];
+		if ( cl->pers.connected != CON_CONNECTED || cl->sess.sessionTeam == TEAM_SPECTATOR
+			|| ( g_entities[i].r.svFlags & SVF_BOT ) ) {
+			continue;
+		}
+		humans++;
+		if ( !cl->pers.ready ) {
+			return qfalse;
+		}
+	}
+	return humans > 0;
+}
