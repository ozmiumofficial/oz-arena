+/*
+================
+G_QLKnockback
+
+Quake Live's knockback: the damage times the weapon's scale (rockets and plasma have their own for
+self hits), capped at g_max_knockback (1.32: the damage itself, capped at 200).
+================
+*/
+float G_QLKnockback( int damage, int mod, qboolean self ) {
+	float	scale, k;
+
+	switch ( mod ) {
+	case MOD_GAUNTLET:			scale = g_knockback_g.value; break;
+	case MOD_MACHINEGUN:		scale = g_knockback_mg.value; break;
+	case MOD_SHOTGUN:			scale = g_knockback_sg.value; break;
+	case MOD_GRENADE:
+	case MOD_GRENADE_SPLASH:	scale = g_knockback_gl.value; break;
+	case MOD_ROCKET:
+	case MOD_ROCKET_SPLASH:		scale = self ? g_knockback_rl_self.value : g_knockback_rl.value; break;
+	case MOD_PLASMA:
+	case MOD_PLASMA_SPLASH:		scale = self ? g_knockback_pg_self.value : g_knockback_pg.value; break;
+	case MOD_LIGHTNING:			scale = g_knockback_lg.value; break;
+	case MOD_RAILGUN:			scale = g_knockback_rg.value; break;
+	case MOD_BFG:
+	case MOD_BFG_SPLASH:		scale = g_knockback_bfg.value; break;
+	default:					scale = 1.0f; break;
+	}
+	k = damage * scale;
+	if ( g_max_knockback.value > 0 && k > g_max_knockback.value ) {
+		k = g_max_knockback.value;
+	}
+	return k;
+}
+
+/*
+================
+G_QLItemQuantity
+
+What an item gives: Quake Live's amounts where they differ from 1.32's (its bg_itemlist).
+================
+*/
+int G_QLItemQuantity( const gitem_t *item ) {
+	static const struct { const char *classname; int quantity; } amounts[] = {
+		{ "weapon_machinegun", 100 },
+		{ "weapon_bfg", 10 },
+		{ "ammo_shells", 5 },
+		{ "ammo_cells", 50 },
+		{ "ammo_lightning", 50 },
+		{ "ammo_slugs", 5 },
+		{ "ammo_bfg", 5 },
+	};
+	int		i;
+
+	if ( G_QL() ) {
+		for ( i = 0 ; i < ARRAY_LEN( amounts ) ; i++ ) {
+			if ( !strcmp( item->classname, amounts[i].classname ) ) {
+				return amounts[i].quantity;
+			}
+		}
+	}
+	return item->quantity;
+}
+
+/*
+================
+G_QLMissile
+
+A missile's damage, splash and speed. Quake Live's for the weapons it changed through cvars; the
+1.32 numbers the caller passes otherwise.
+================
+*/
+void G_QLMissile( gentity_t *bolt, int weapon, vec3_t dir, float speed ) {
+	if ( G_QL() ) {
+		switch ( weapon ) {
+		case WP_GRENADE_LAUNCHER:
+			bolt->damage = g_damage_gl.integer;
+			bolt->splashDamage = g_splashdamage_gl.integer;
+			bolt->splashRadius = g_splashradius_gl.integer;
+			speed = g_velocity_gl.value;
+			break;
+		case WP_ROCKET_LAUNCHER:
+			bolt->damage = g_damage_rl.integer;
+			bolt->splashDamage = g_splashdamage_rl.integer;
+			bolt->splashRadius = g_splashradius_rl.integer;
+			speed = g_velocity_rl.value;
+			break;
+		case WP_PLASMAGUN:
+			bolt->damage = g_damage_pg.integer;
+			bolt->splashDamage = g_splashdamage_pg.integer;
+			bolt->splashRadius = g_splashradius_pg.integer;
+			speed = g_velocity_pg.value;
+			break;
+		case WP_BFG:
+			bolt->damage = g_damage_bfg.integer;
+			bolt->splashDamage = g_splashdamage_bfg.integer;
+			bolt->splashRadius = g_splashradius_bfg.integer;
+			speed = g_velocity_bfg.value;
+			break;
+		}
+	}
+	VectorScale( dir, speed, bolt->s.pos.trDelta );
+}
+
+/*
+================
+G_QLSpawnLoadout
+
+Quake Live's spawn: g_startingWeapons (bit n is weapon n + 1) with g_startingAmmo_*, health
+g_startingHealth (as a share of the handicap's max) plus g_startingHealthBonus, and g_startingArmor.
+================
+*/
+void G_QLSpawnLoadout( gentity_t *ent ) {
+	gclient_t	*client = ent->client;
+	int			mask = g_startingWeapons.integer;
+	int			w;
+
+	client->ps.stats[STAT_WEAPONS] = 0;
+	memset( client->ps.ammo, 0, sizeof( client->ps.ammo ) );	// ClientSpawn's 1.32 machinegun ammo
+	for ( w = WP_GAUNTLET ; w < WP_NUM_WEAPONS ; w++ ) {
+		if ( !( mask & ( 1 << ( w - 1 ) ) ) ) {
+			continue;
+		}
+		client->ps.stats[STAT_WEAPONS] |= 1 << w;
+		switch ( w ) {
+		case WP_MACHINEGUN:			client->ps.ammo[w] = g_startingAmmo_mg.integer; break;
+		case WP_SHOTGUN:			client->ps.ammo[w] = g_startingAmmo_sg.integer; break;
+		case WP_GRENADE_LAUNCHER:	client->ps.ammo[w] = g_startingAmmo_gl.integer; break;
+		case WP_ROCKET_LAUNCHER:	client->ps.ammo[w] = g_startingAmmo_rl.integer; break;
+		case WP_LIGHTNING:			client->ps.ammo[w] = g_startingAmmo_lg.integer; break;
+		case WP_RAILGUN:			client->ps.ammo[w] = g_startingAmmo_rg.integer; break;
+		case WP_PLASMAGUN:			client->ps.ammo[w] = g_startingAmmo_pg.integer; break;
+		case WP_BFG:				client->ps.ammo[w] = g_startingAmmo_bfg.integer; break;
+		default:					client->ps.ammo[w] = -1; break;		// gauntlet, hook
+		}
+	}
+	client->ps.ammo[WP_GAUNTLET] = -1;
+	client->ps.ammo[WP_GRAPPLING_HOOK] = -1;
+
+	// health will count down towards max_health
+	ent->health = client->ps.stats[STAT_HEALTH] =
+		client->ps.stats[STAT_MAX_HEALTH] * g_startingHealth.integer / 100 + g_startingHealthBonus.integer;
+	client->ps.stats[STAT_ARMOR] = g_startingArmor.integer;
+}
