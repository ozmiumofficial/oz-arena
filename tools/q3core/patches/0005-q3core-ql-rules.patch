+vmCvar_t	g_startingAmmo_rg;
+vmCvar_t	g_startingAmmo_pg;
+vmCvar_t	g_startingAmmo_bfg;
+
+typedef struct {
+	vmCvar_t	*vmCvar;
+	char		*name;
+	char		*ql;		// Quake Live's default
+	int			flags;
+} qlCvar_t;
+
+static qlCvar_t qlCvars[] = {
+	// clients read it too (prediction, the shotgun pattern), so it travels in the systeminfo; latched,
+	// so a change waits for the next map instead of switching rules mid-match
+	{ &g_ruleset, "g_ruleset", "ql", CVAR_SERVERINFO | CVAR_SYSTEMINFO | CVAR_LATCH },
+
+	{ &g_damage_g, "g_damage_g", "50", 0 },
+	{ &g_damage_mg, "g_damage_mg", "5", 0 },
+	{ &g_damage_sg, "g_damage_sg", "5", 0 },
+	{ &g_damage_sg_outer, "g_damage_sg_outer", "5", 0 },
+	{ &g_damage_gl, "g_damage_gl", "100", 0 },
+	{ &g_damage_rl, "g_damage_rl", "100", 0 },
+	{ &g_damage_lg, "g_damage_lg", "6", 0 },
+	{ &g_damage_rg, "g_damage_rg", "80", 0 },
+	{ &g_damage_pg, "g_damage_pg", "20", 0 },
