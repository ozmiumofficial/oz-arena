 	s->loopSound = ps->loopSound;
 	s->generic1 = ps->generic1;
 }
+
+/*
+========================
+BG_QLRules
+
+q3core: the Quake Live rules Pmove runs (QUAKE_LIVE_PLAN.md), read through `cvar` (the game's or
+the engine's lookup). The game registers these cvars from this table, so the names and defaults
+live here once. A cvar that isn't registered yet reads as its Quake Live default.
+========================
+*/
+const bgQLCvar_t bg_qlPmoveCvars[] = {
+	{ "weapon_reload_gauntlet",	"400",	WP_GAUNTLET },
+	{ "weapon_reload_mg",		"100",	WP_MACHINEGUN },
+	{ "weapon_reload_sg",		"1000",	WP_SHOTGUN },
+	{ "weapon_reload_gl",		"800",	WP_GRENADE_LAUNCHER },
+	{ "weapon_reload_rl",		"800",	WP_ROCKET_LAUNCHER },
+	{ "weapon_reload_lg",		"50",	WP_LIGHTNING },
+	{ "weapon_reload_rg",		"1500",	WP_RAILGUN },
+	{ "weapon_reload_pg",		"100",	WP_PLASMAGUN },
+	{ "weapon_reload_bfg",		"300",	WP_BFG },
+};
+const int bg_numQLPmoveCvars = ARRAY_LEN( bg_qlPmoveCvars );
+
+void BG_QLRules( pmoveRules_t *rules, const char *(*cvar)( const char *name ) ) {
+	int			i;
+	const char	*s;
+
+	memset( rules, 0, sizeof( *rules ) );
+	rules->ql = Q_stricmp( cvar( "g_ruleset" ), "classic" ) != 0;
+	for ( i = 0 ; i < bg_numQLPmoveCvars ; i++ ) {
+		s = cvar( bg_qlPmoveCvars[i].name );
+		rules->weaponReload[bg_qlPmoveCvars[i].weapon] = atoi( s[0] ? s : bg_qlPmoveCvars[i].ql );
+	}
+}
+
+/*
+========================
+BG_QLShotgunPellet
+
+q3core: where Quake Live's fixed shotgun pattern puts pellet `pellet`, as offsets along right and up
+at 8192 * 16 units out (the 1.32 pattern's frame): 6 pellets every 60 degrees at 4000, 6 more
+between them at 8000, and 8 every 45 degrees at 12000. The pattern is from a reconstruction of
+Quake Live's binaries and unverified (tools/ql/QL_CATALOG.md 2.3).
+========================
+*/
+void BG_QLShotgunPellet( int pellet, float *right, float *up ) {
+	float	angle, radius;
+
+	if ( pellet < 6 ) {
+		angle = pellet * 60.0f;
+		radius = 4000.0f;
+	} else if ( pellet < QL_SHOTGUN_INNER ) {
+		angle = ( pellet - 6 ) * 60.0f + 30.0f;
+		radius = 8000.0f;
+	} else {
+		angle = ( pellet - QL_SHOTGUN_INNER ) * 45.0f;
+		radius = 12000.0f;
+	}
+	*right = radius * cos( DEG2RAD( angle ) );
+	*up = radius * sin( DEG2RAD( angle ) );
+}
