+// the cvars Pmove reads (bg_qlPmoveCvars); clients predict with them, so they're in the systeminfo
+static vmCvar_t		qlPmoveCvars[MAX_WEAPONS];
+static pmoveRules_t	qlRules;
+
+static const char *G_QLCvarString( const char *name ) {
+	static char	buf[MAX_CVAR_VALUE_STRING];
+
+	trap_Cvar_VariableStringBuffer( name, buf, sizeof( buf ) );
+	return buf;
+}
+
+void G_QLRegisterCvars( void ) {
+	int		i;
+
+	for ( i = 0 ; i < ARRAY_LEN( qlCvars ) ; i++ ) {
+		trap_Cvar_Register( qlCvars[i].vmCvar, qlCvars[i].name, qlCvars[i].ql, qlCvars[i].flags );
+	}
+	for ( i = 0 ; i < bg_numQLPmoveCvars && i < ARRAY_LEN( qlPmoveCvars ) ; i++ ) {
+		trap_Cvar_Register( &qlPmoveCvars[i], bg_qlPmoveCvars[i].name, bg_qlPmoveCvars[i].ql, CVAR_SYSTEMINFO );
+	}
+	BG_QLRules( &qlRules, G_QLCvarString );
+}
+
+void G_QLUpdateCvars( void ) {
+	int		i;
+
+	for ( i = 0 ; i < ARRAY_LEN( qlCvars ) ; i++ ) {
+		trap_Cvar_Update( qlCvars[i].vmCvar );
+	}
+	for ( i = 0 ; i < bg_numQLPmoveCvars && i < ARRAY_LEN( qlPmoveCvars ) ; i++ ) {
+		trap_Cvar_Update( &qlPmoveCvars[i] );
+	}
+	BG_QLRules( &qlRules, G_QLCvarString );
+}
+
+qboolean G_QL( void ) {
+	return qlRules.ql;
+}
+
+const pmoveRules_t *G_QLPmoveRules( void ) {
+	return &qlRules;
+}
