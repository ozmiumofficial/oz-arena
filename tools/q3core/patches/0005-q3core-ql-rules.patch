+/*
+q3core: Quake Live's rules (QUAKE_LIVE_PLAN.md). Quake Live's game code is closed: these numbers were
+read from its own cvar and item tables (tools/ql/ql_rules.json), under Quake Live's cvar names.
+
+g_ruleset "ql" (the default) plays them. "classic" plays id 1.32: every change is behind G_QL(), so
+the 1.32 code paths run as they were.
+*/
+
+#include "g_local.h"
+
+vmCvar_t	g_ruleset;
+
+vmCvar_t	g_damage_g;
+vmCvar_t	g_damage_mg;
