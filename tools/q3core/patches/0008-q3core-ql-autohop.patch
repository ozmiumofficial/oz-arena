+/*
+==============
+G_AutoHop
+
+q3core: Quake Live's pmove_AutoHop (on by default; off under Classic rules). In systeminfo, so clients
+predict it as the server runs it.
+==============
+*/
+static int G_AutoHop( void ) {
+	static vmCvar_t	autoHop;
+	static int		registered;
+
+	if ( !registered ) {
+		trap_Cvar_Register( &autoHop, "pmove_AutoHop", "1", CVAR_SYSTEMINFO );
+		registered = 1;
+	}
+	trap_Cvar_Update( &autoHop );
+	return G_QL() && autoHop.integer;
+}
