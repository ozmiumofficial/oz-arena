+/*
+=================
+Cmd_PodiumTaunt_f
+
+q3core: "ptaunt <taunt id>": the results screen's podium taunt, sent to every client as "ptaunt <client> <id>"
+for its podium to play (the gesture and that taunt's sound). One every 1.5 s a player; ids are the card
+catalog's (taunt_sarge), so only lowercase letters, digits and underscores pass.
+=================
+*/
+static void Cmd_PodiumTaunt_f( gentity_t *ent ) {
+	static int	last[MAX_CLIENTS];
+	char		id[32];
+	int			i, num;
+
+	num = ent - g_entities;
+	if ( num < 0 || num >= MAX_CLIENTS || trap_Argc() != 2 ) {
+		return;
+	}
+	trap_Argv( 1, id, sizeof( id ) );
+	if ( !id[0] ) {
+		return;
+	}
+	for ( i = 0 ; id[i] ; i++ ) {
+		if ( !( ( id[i] >= 'a' && id[i] <= 'z' ) || ( id[i] >= '0' && id[i] <= '9' ) || id[i] == '_' ) ) {
+			return;
+		}
+	}
+	if ( last[num] && level.time - last[num] < 1500 && level.time >= last[num] ) {
+		return;
+	}
+	last[num] = level.time;
+	trap_SendServerCommand( -1, va( "ptaunt %d %s", num, id ) );
+}
+
 void ClientCommand( int clientNum ) {
 	gentity_t *ent;
 	char	cmd[MAX_TOKEN_CHARS];
