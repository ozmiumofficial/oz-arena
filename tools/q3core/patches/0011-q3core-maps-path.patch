+/*
+================
+FS_AddMapsDirectory
+
+q3core: every .pk3 straight in fs_mapspath (the game's Maps folder, no baseq3 under it), loaded
+like a base game pak and after them, so a map pack wins over the retail paks as it would in baseq3.
+================
+*/
+static void FS_AddMapsDirectory( const char *path ) {
+	searchpath_t	*search;
+	pack_t			*pak;
+	char			**pakfiles;
+	int				numfiles, i;
+
+	pakfiles = Sys_ListFiles( path, ".pk3", NULL, &numfiles, qfalse );
+	if ( !pakfiles ) {
+		return;
+	}
+	qsort( pakfiles, numfiles, sizeof(char *), paksort );
+	for ( i = 0; i < numfiles; i++ ) {
+		if ( ( pak = FS_LoadZipFile( va( "%s%c%s", path, PATH_SEP, pakfiles[i] ), pakfiles[i] ) ) == 0 ) {
+			continue;
+		}
+		Q_strncpyz( pak->pakPathname, path, sizeof(pak->pakPathname) );
+		Q_strncpyz( pak->pakGamename, BASEGAME, sizeof(pak->pakGamename) );
+		fs_packFiles += pak->numfiles;
+		search = Z_Malloc( sizeof(searchpath_t) );
+		search->pack = pak;
+		search->next = fs_searchpaths;
+		fs_searchpaths = search;
+	}
+	Sys_FreeFileList( pakfiles );
+}
