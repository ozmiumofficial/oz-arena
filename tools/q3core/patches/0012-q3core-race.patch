+/*
+========================
+BG_TouchVelocityPad
+
+flags (generic1): 1 PLAYERDIR_XY, 2 ADD_XY, 4 PLAYERDIR_Z, 8 ADD_Z, 16 BIDIRECTIONAL_XY,
+32 BIDIRECTIONAL_Z, 64 CLAMP_NEGATIVE_ADDS. origin2 is the target's direction, time the horizontal
+speed, time2 the vertical one.
+========================
+*/
+static void BG_TouchVelocityPad( playerState_t *ps, entityState_t *pad ) {
+	int		flags = pad->generic1 & 0x7f;
+	qboolean entering = ps->jumppad_ent != pad->number;
+	float	dx, dy, dz, len, speed = pad->time, count = pad->time2;
+	float	vx = ps->velocity[0], vy = ps->velocity[1], vz = ps->velocity[2];
+	float	nx, ny, nz;
+
+	if ( entering ) {
+		BG_AddPredictableEventToPlayerstate( EV_JUMP_PAD, fabs( count ) > fabs( speed ) ? 1 : 0, ps );
+	}
+	ps->jumppad_ent = pad->number;
+	ps->jumppad_frame = ps->pmove_framecount;
+
+	// horizontal
+	if ( flags & 1 ) {
+		len = sqrt( vx * vx + vy * vy );
+		dx = len > 0 ? vx / len : 0;
+		dy = len > 0 ? vy / len : 0;
+	} else {
+		dx = pad->origin2[0];
+		dy = pad->origin2[1];
+		if ( ( flags & 16 ) && dx * vx + dy * vy < 0 ) {
+			dx = -dx;
+			dy = -dy;
+		}
+	}
+	if ( dx != 0 || dy != 0 ) {
+		if ( flags & 2 ) {
+			if ( entering ) {
+				nx = vx + dx * speed;
+				ny = vy + dy * speed;
+				if ( ( flags & 64 ) && nx * vx + ny * vy <= 0 ) {
+					nx = ny = 0;
+				}
+				ps->velocity[0] = nx;
+				ps->velocity[1] = ny;
+			}
+		} else {
+			ps->velocity[0] = dx * speed;
+			ps->velocity[1] = dy * speed;
+		}
+	}
+
+	// vertical
+	if ( flags & 4 ) {
+		dz = vz >= 0 ? 1 : -1;
+	} else {
+		dz = pad->origin2[2] >= 0 ? 1 : -1;
+		if ( ( flags & 32 ) && dz * vz < 0 ) {
+			dz = -dz;
+		}
+	}
+	if ( flags & 8 ) {
+		if ( entering ) {
+			nz = vz + dz * count;
+			if ( ( flags & 64 ) && nz * vz < 0 ) {
+				nz = 0;
+			}
+			ps->velocity[2] = nz;
+		}
+	} else if ( count != 0 ) {
+		ps->velocity[2] = dz * count;
+	}
+}
