+/*
+==============================================================================
+
+trigger_push_velocity
+
+BG_TouchVelocityPad (bg_misc.c) reads the pad from its entity state so the client predicts it:
+origin2 = the target's direction (xy unit vector, z = sign), time = speed, time2 = count,
+generic1 = 0x80 | spawnflags.
+
+==============================================================================
+*/
+
+static void Race_AimVelocityPad( gentity_t *self ) {
+	gentity_t	*target;
+	vec3_t		center, d;
+	float		len;
+
+	VectorAdd( self->r.absmin, self->r.absmax, center );
+	VectorScale( center, 0.5f, center );
+	VectorClear( self->s.origin2 );
+	target = self->target ? G_PickTarget( self->target ) : NULL;
+	if ( target ) {
+		VectorSubtract( target->s.origin, center, d );
+		len = sqrt( d[0] * d[0] + d[1] * d[1] );
+		if ( len > 0 ) {
+			self->s.origin2[0] = d[0] / len;
+			self->s.origin2[1] = d[1] / len;
+		}
+		self->s.origin2[2] = d[2] >= 0 ? 1 : -1;
+	} else {
+		self->s.origin2[2] = 1;
+	}
+	self->s.time = (int)self->speed;
+	self->s.time2 = self->count;
+	self->s.generic1 = 0x80 | ( self->spawnflags & 0x7f );
+	self->think = 0;
+	self->nextthink = 0;
+}
+
+/*QUAKED trigger_push_velocity (.5 .5 .5) ? PLAYERDIR_XY ADD_XY PLAYERDIR_Z ADD_Z BIDIRECTIONAL_XY BIDIRECTIONAL_Z CLAMP_NEGATIVE_ADDS
+A launch ramp that can add to the player's speed. "speed" is horizontal, "count" vertical.
+Points at a target_position that gives the direction.
+*/
+void SP_trigger_push_velocity( gentity_t *self ) {
+	InitTrigger( self );
+	self->r.svFlags &= ~SVF_NOCLIENT;
+	G_SoundIndex( "sound/world/jumppad.wav" );
+	self->s.eType = ET_PUSH_TRIGGER;
+	self->touch = trigger_push_touch;
+	self->think = Race_AimVelocityPad;
+	self->nextthink = level.time + FRAMETIME;
+	trap_LinkEntity( self );
+}
+
+/*
+================
+G_RaceKeepSpeed
+
+trigger_teleport KEEP_SPEED: the speed the player came in with, turned with the view.
+================
+*/
+void G_RaceKeepSpeed( gentity_t *player, const vec3_t oldVel, float oldYaw, const vec3_t destAngles ) {
+	float	delta = destAngles[0] > 999999.0f ? 0 : AngleNormalize180( destAngles[YAW] - oldYaw );
+	float	c = cos( DEG2RAD( delta ) ), s = sin( DEG2RAD( delta ) );
+
+	player->client->ps.velocity[0] = oldVel[0] * c - oldVel[1] * s;
+	player->client->ps.velocity[1] = oldVel[0] * s + oldVel[1] * c;
+	player->client->ps.velocity[2] = oldVel[2];
+	player->client->ps.pm_time = 0;
+	player->client->ps.pm_flags &= ~PMF_TIME_KNOCKBACK;
+}
+
+/*
+================
+G_RaceCommand
+
+Race's client commands (Defrag's respawn and savepos / loadpos): "racerestart" spawns again, with a
+running timer thrown away; "racesave" keeps the position and view; "raceload" goes back there,
+standing still, with the timer stopped (practice).
+================
+*/
+qboolean G_RaceCommand( gentity_t *ent, const char *cmd ) {
+	gclient_t *cl = ent->client;
+
+	if ( !G_Race() ) {
+		return qfalse;
+	}
+	if ( !Q_stricmp( cmd, "racerestart" ) ) {
+		if ( cl->sess.sessionTeam == TEAM_SPECTATOR || level.intermissiontime ) {
+			return qtrue;
+		}
+		if ( ent->health <= 0 ) {
+			ClientRespawn( ent );
+		} else {
+			ClientSpawn( ent );
+		}
+		return qtrue;
+	}
+	if ( !Q_stricmp( cmd, "raceinfo" ) ) {	// the HUD asks for the checkpoint count and best time (the first spawn's answer comes too early)
+		G_RaceSpawn( ent );
+		return qtrue;
+	}
+	if ( !Q_stricmp( cmd, "racesave" ) ) {
+		if ( !Race_Eligible( ent ) ) {
+			return qtrue;
+		}
+		VectorCopy( cl->ps.origin, cl->sess.raceSaveOrigin );
+		VectorCopy( cl->ps.viewangles, cl->sess.raceSaveAngles );
+		cl->sess.raceSaved = qtrue;
+		Race_Send( ent, "cp \"Position saved\"" );
+		return qtrue;
+	}
+	if ( !Q_stricmp( cmd, "raceload" ) ) {
+		if ( !Race_Eligible( ent ) ) {
+			return qtrue;
+		}
+		if ( !cl->sess.raceSaved ) {
+			Race_Send( ent, "cp \"No saved position\"" );
+			return qtrue;
+		}
+		trap_UnlinkEntity( ent );
+		VectorCopy( cl->sess.raceSaveOrigin, cl->ps.origin );
+		VectorClear( cl->ps.velocity );
+		cl->ps.eFlags ^= EF_TELEPORT_BIT;	// no lerp from where it was
+		SetClientViewAngle( ent, cl->sess.raceSaveAngles );
+		BG_PlayerStateToEntityState( &cl->ps, &ent->s, qtrue );
+		VectorCopy( cl->ps.origin, ent->r.currentOrigin );
+		trap_LinkEntity( ent );
+		cl->race.running = qfalse;
+		G_RaceSpawn( ent );	// the HUD goes idle
+		return qtrue;
+	}
+	return qfalse;
+}
